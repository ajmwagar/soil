; SPDX-License-Identifier: MIT OR Apache-2.0
; WIT JSON -> Soil bindings.
;
; Input is `wasm-tools component wit -j`. Output is checked in under
; std/bindings/ with the generated marker. This tool has no host dependency:
; it only reads the JSON argument and prints Soil.
;
;   wasm-tools component wit wit/ -j > /tmp/wit.json
;   soil-run --prelude core/prelude.soil --call main tools/witgen/main.soil \
;     --arg "$(cat /tmp/wit.json)" > std/bindings/wasi-io.soil
;
; The generated interface key keeps the interface name when it differs from the
; package name, so `wasi:io/streams` and `wasi:io/poll` do not collide.

(defun wit/generated-marker ()
  (str "; @generated by tools/witgen/main.soil from "
       "wasm-tools component wit -j.\n"
       "; DO NOT EDIT. Regenerate with `tend witgen`.\n"))

(defun wit/split-once (text separator)
  (wit/split-once-chars (string-chars text) (string-chars separator) nil))

(defun wit/split-once-chars (chars separator acc)
  (cond
    ((nil? chars)
      (list (string-join (reverse acc) "") nil))
    ((wit/prefix-chars? chars separator)
      (list (string-join (reverse acc) "")
            (string-join (drop (length separator) chars) "")))
    (else
      (wit/split-once-chars (rest chars) separator (cons (first chars) acc)))))

(defun wit/prefix-chars? (chars prefix)
  (cond
    ((nil? prefix) #t)
    ((nil? chars) #f)
    ((= (first chars) (first prefix))
      (wit/prefix-chars? (rest chars) (rest prefix)))
    (else #f)))

(defun wit/package-base (package)
  (first (wit/split-once package "@")))

(defun wit/package-version (package)
  (let ((parts (wit/split-once package "@")))
    (if (nil? (nth 1 parts)) "" (nth 1 parts))))

(defun wit/package-interface (base)
  (nth 1 (wit/split-once base ":")))

(defun wit/quote (value)
  (json-encode value))

(defun wit/name-text (value)
  (let ((text (str value)))
    (if (= (first (string-chars text)) ":")
        (string-join (drop 1 (string-chars text)) "")
        text)))

(defun wit/empty-object? (value)
  (and (not (nil? value)) (= (first value) '__json_object__)))

(defun wit/empty? (value)
  (or (nil? value) (wit/empty-object? value)))

(defun wit/type-at (doc id)
  (nth id (field doc :types)))

(defun wit/interface-at (doc id)
  (nth id (field doc :interfaces)))

(defun wit/interface-name (doc id)
  (field (wit/interface-at doc id) :name))

(defun wit/package-of (doc id)
  (field (nth id (field doc :packages)) :name))

(defun wit/interface-base (doc id)
  (wit/package-base
    (wit/package-of doc (field (wit/interface-at doc id) :package))))

(defun wit/version-for-base (doc base)
  (wit/version-for-packages (field doc :packages) base))

(defun wit/version-for-packages (packages base)
  (if (nil? packages)
      ""
      (let ((name (field (first packages) :name)))
        (if (= (wit/package-base name) base)
            (wit/package-version name)
            (wit/version-for-packages (rest packages) base)))))

(defun wit/scoped (base interface name)
  (let ((package-name (wit/package-interface base)))
    (if (= interface package-name)
        (str base "/" name)
        (str base "/" interface "." name))))

(defun wit/interface-key (base interface)
  (if (= interface (wit/package-interface base))
      base
      (str base "/" interface)))

(defun wit/type-name (doc base id)
  (let ((ty (wit/type-at doc id)))
    (let ((name (field ty :name)))
      (if (nil? name)
          nil
          (let ((owner (field ty :owner)))
            (if (nil? owner)
                (str base "/" name)
                (let ((interface-id (field owner :interface)))
                  (wit/scoped
                    (wit/interface-base doc interface-id)
                    (wit/interface-name doc interface-id)
                    name))))))))

(defun wit/json-string? (value)
  (= (first (string-chars (json-encode value))) "\""))

(defun wit/json-number? (value)
  (let ((byte (first (string->bytes (json-encode value)))))
    (or (= byte 45)
        (and (>= byte 48) (<= byte 57)))))

(defun wit/type-ref (doc base ty)
  (cond
    ((nil? ty) "unit")
    ((wit/json-string? ty) ty)
    ((wit/json-number? ty) (wit/type-ref-id doc base ty))
    (else (wit/kind-ref doc base ty))))

(defun wit/type-ref-id (doc base id)
  (let ((name (wit/type-name doc base id)))
    (if (nil? name)
        (wit/kind-ref doc base (field (wit/type-at doc id) :kind))
        name)))

(defun wit/kind-pair (kind)
  (first kind))

(defun wit/kind-name (kind)
  (str (first (wit/kind-pair kind))))

(defun wit/kind-value (kind)
  (nth 1 (wit/kind-pair kind)))

(defun wit/kind-ref (doc base kind)
  (let ((name (wit/kind-name kind))
        (value (wit/kind-value kind)))
    (cond
      ((= name ":list") (str "(list " (wit/type-ref doc base value) ")"))
      ((= name ":option") (str "(option " (wit/type-ref doc base value) ")"))
      ((= name ":result")
        (str "(result "
             (wit/type-ref doc base (field value :ok)) " "
             (wit/type-ref doc base (field value :err)) ")"))
      ((= name ":tuple")
        (str "(tuple " (wit/types doc base (field value :types)) ")"))
      ((= name ":type") (wit/type-ref doc base value))
      ((= name ":handle")
        (let ((pair (first value)))
          (str "(handle " (wit/name-text (first pair)) " "
               (wit/type-ref doc base (nth 1 pair)) ")")))
      ((= name ":record")
        (str "(record " (wit/fields doc base (field value :fields)) ")"))
      ((= name ":variant")
        (str "(variant " (wit/cases doc base (field value :cases)) ")"))
      ((= name ":enum")
        (str "(enum " (wit/names (field value :cases)) ")"))
      ((= name ":flags")
        (str "(flags " (wit/names (field value :flags)) ")"))
      ((= name ":resource") "(resource)")
      (else (str "(unsupported " (wit/quote name) ")")))))

(defun wit/types (doc base types)
  (if (nil? types)
      ""
      (str (wit/type-ref doc base (first types))
           (if (nil? (rest types)) "" (str " " (wit/types doc base (rest types)))))))

(defun wit/names (items)
  (if (nil? items)
      ""
      (str (field (first items) :name)
           (if (nil? (rest items)) "" (str " " (wit/names (rest items)))))))

(defun wit/fields (doc base fields)
  (if (nil? fields)
      ""
      (let ((field (first fields)))
        (str "(" (field field :name) " "
             (wit/type-ref doc base (field field :type)) ")"
             (if (nil? (rest fields)) "" (str " " (wit/fields doc base (rest fields))))))))

(defun wit/cases (doc base cases)
  (if (nil? cases)
      ""
      (let ((case (first cases)))
        (str "(" (field case :name)
             (let ((ty (field case :type)))
               (if (nil? ty) "" (str " " (wit/type-ref doc base ty))))
             ")"
             (if (nil? (rest cases)) "" (str " " (wit/cases doc base (rest cases))))))))

(defun wit/function-name (name)
  (let ((method (wit/split-once name "]")))
    (if (nil? (nth 1 method))
        (let ((tag (wit/split-once name "[")))
          (if (nil? (nth 1 tag))
              name
              (str (nth 1 tag))))
        (nth 1 method))))

(defun wit/params (doc base params)
  (if (nil? params)
      ""
      (let ((param (first params)))
        (str "(" (field param :name) " "
             (wit/type-ref doc base (field param :type)) ")"
             (if (nil? (rest params)) "" (str " " (wit/params doc base (rest params))))))))

(defun wit/param-names (params)
  (if (nil? params)
      ""
      (str (field (first params) :name)
           (if (nil? (rest params)) "" (str " " (wit/param-names (rest params)))))))

(defun wit/type-def (doc base name ty)
  (let ((kind (field ty :kind)))
    (cond
      ((= kind "resource")
        (str "(define-resource " name ")\n\n"))
      ((= (wit/kind-name kind) ":record")
        (str "(define-record " name "\n"
             (wit/fields-lines doc base (field (wit/kind-value kind) :fields))
             ")\n\n"))
      ((= (wit/kind-name kind) ":variant")
        (str "(define-variant " name "\n"
             (wit/cases-lines doc base (field (wit/kind-value kind) :cases))
             ")\n\n"))
      ((= (wit/kind-name kind) ":enum")
        (str "(define-enum " name " "
             (wit/names (field (wit/kind-value kind) :cases)) ")\n\n"))
      ((= (wit/kind-name kind) ":flags")
        (str "(define-flags " name " "
             (wit/names (field (wit/kind-value kind) :flags)) ")\n\n"))
      ((= (wit/kind-name kind) ":resource")
        (str "(define-resource " name ")\n\n"))
      (else
        (str "(define-alias " name " "
             (wit/kind-ref doc base kind) ")\n\n")))))

(defun wit/fields-lines (doc base fields)
  (if (nil? fields)
      ""
      (let ((field (first fields)))
        (str "  (" (field field :name) " "
             (wit/type-ref doc base (field field :type)) ")\n"
             (wit/fields-lines doc base (rest fields))))))

(defun wit/cases-lines (doc base cases)
  (if (nil? cases)
      ""
      (let ((case (first cases)))
        (str "  (" (field case :name)
             (let ((ty (field case :type)))
               (if (nil? ty) "" (str " " (wit/type-ref doc base ty))))
             ")\n"
             (wit/cases-lines doc base (rest cases))))))

(defun wit/interface-types (doc base interface-name interface)
  (let ((types (field interface :types)))
    (if (wit/empty? types)
        ""
        (wit/interface-type-entries doc base interface-name types))))

(defun wit/interface-type-entries (doc base interface-name entries)
  (if (nil? entries)
      ""
      (let ((entry (first entries)))
        (let ((name (wit/name-text (first entry)))
              (id (nth 1 entry)))
          (str (wit/type-def doc base
                 (wit/scoped base interface-name name)
                 (wit/type-at doc id))
               (wit/interface-type-entries doc base interface-name (rest entries)))))))

(defun wit/capability (doc base interface-name function)
  (let ((name (wit/function-name (field function :name)))
        (key (wit/interface-key base interface-name))
        (cap (wit/scoped base interface-name (wit/function-name (field function :name))))
        (params (field function :params))
        (result (field function :result)))
    (str
      "(define-capability " cap "\n"
      "  :interface " (wit/quote key) "\n"
      "  :function " (wit/quote name) "\n"
      "  :grant " (wit/quote base) "\n"
      "  :version " (wit/quote (wit/version-for-base doc base)) "\n"
      "  :params (" (wit/params doc base params) ")\n"
      "  :result " (if (nil? result) "unit" (wit/type-ref doc base result)) ")\n\n"
      "(defun " cap " (" (wit/param-names params) ")\n"
      "  (host-call " (wit/quote key) " " (wit/quote name) " "
      (if (nil? params) "nil" (str "(list " (wit/param-names params) ")")) "))\n\n")))

(defun wit/interface-functions (doc base interface-name interface)
  (let ((functions (field interface :functions)))
    (if (wit/empty? functions)
        ""
        (wit/function-entries doc base interface-name functions))))

(defun wit/function-entries (doc base interface-name entries)
  (if (nil? entries)
      ""
      (let ((entry (first entries)))
        (str (wit/capability doc base interface-name (nth 1 entry))
             (wit/function-entries doc base interface-name (rest entries))))))

(defun wit/interfaces (doc base interfaces package-id index)
  (if (nil? interfaces)
      ""
      (let ((interface (first interfaces)))
        (str (if (= (field interface :package) package-id)
                 (str (wit/interface-types doc base (field interface :name) interface)
                      (wit/interface-functions doc base (field interface :name) interface))
                 "")
             (wit/interfaces doc base (rest interfaces) package-id (+ index 1))))))

(defun wit/find-package (packages wanted index)
  (cond
    ((nil? packages) 0)
    ((= (field (first packages) :name) wanted) index)
    (else (wit/find-package (rest packages) wanted (+ index 1)))))

(defun wit/package-id (doc wanted)
  (if (nil? wanted)
      0
      (wit/find-package (field doc :packages) wanted 0)))

(defun wit/generate (doc wanted)
  (let ((package-id (wit/package-id doc wanted)))
    (let ((package (field (nth package-id (field doc :packages)) :name)))
      (let ((base (wit/package-base package)))
        (str (wit/generated-marker)
             "(define-package " (wit/quote package)
             " :base " (wit/quote base)
             " :version " (wit/quote (wit/package-version package))
             " :generated #t)\n\n"
             (wit/interfaces doc base (field doc :interfaces) package-id 0))))))

(defun main ()
  (let ((doc (json-decode (first (argv)))))
    (println (wit/generate doc (nth 1 (argv))))))

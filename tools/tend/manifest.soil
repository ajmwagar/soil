; tend.soil manifest reader and canonical writer.
;
; This is a schema reader, not an evaluator. It recognizes one data shape and
; refuses unknown forms; reading a manifest never runs code or touches a host.

(defun tend/ok (value) (list 'ok value))
(defun tend/err (message) (list 'err message))

(defun tend/quote (value)
  (json-encode value))

(defun tend/string-list (values)
  (if (nil? values)
      ""
      (str " " (tend/quote (first values))
           (tend/string-list (rest values)))))

(defun tend/set (manifest key value)
  (assoc key value manifest))

(defun tend/parse-version (item manifest)
  (let ((value (nth 1 item)))
    (if (nil? value)
        (tend/err "version needs a number")
        (tend/ok (tend/set manifest :version value)))))

(defun tend/parse-members (item manifest)
  (let ((values (drop 1 item)))
    (if (nil? values)
        (tend/err "members needs at least one path")
        (tend/ok (tend/set manifest :members values)))))

(defun tend/test-with (name include prelude bindings)
  (list
    (list :name name)
    (list :include include)
    (list :prelude prelude)
    (list :bindings bindings)))

(defun tend/parse-test-opts (opts include prelude bindings)
  (if (nil? opts)
      (if (nil? include)
          (tend/err "test needs an include")
          (tend/ok (tend/test-with nil include prelude bindings)))
      (let ((opt (first opts)))
        (let ((key (first opt)))
          (cond
            ((= key 'include)
              (tend/parse-test-opts (rest opts) (drop 1 opt) prelude bindings))
            ((= key 'prelude)
              (tend/parse-test-opts (rest opts) include (drop 1 opt) bindings))
            ((= key 'bindings)
              (tend/parse-test-opts (rest opts) include prelude (drop 1 opt)))
            (else
              (tend/err (str "unknown test option " key))))))))

(defun tend/parse-test (item manifest)
  (let ((name (nth 1 item))
        (opts (drop 2 item)))
    (let ((result (tend/parse-test-opts opts nil nil nil)))
      (if (ok? result)
          (let ((test (tend/test-with name
                         (field (value result) :include)
                         (field (value result) :prelude)
                         (field (value result) :bindings)))
                (tests (or-empty (field manifest :tests))))
            (tend/ok (tend/set manifest :tests (append tests (list test)))))
          result))))

(defun tend/bench-with (name include runs)
  (list
    (list :name name)
    (list :include include)
    (list :runs runs)))

(defun tend/parse-bench-opts (opts include runs)
  (if (nil? opts)
      (if (nil? include)
          (tend/err "bench needs an include")
          (tend/ok (tend/bench-with nil include runs)))
      (let ((opt (first opts)))
        (let ((key (first opt)))
          (cond
            ((= key 'include)
              (tend/parse-bench-opts (rest opts) (drop 1 opt) runs))
            ((= key 'runs)
              (let ((value (nth 1 opt)))
                (if (or (nil? value) (<= value 0))
                    (tend/err "bench runs must be positive")
                    (tend/parse-bench-opts (rest opts) include value))))
            (else
              (tend/err (str "unknown bench option " key))))))))

(defun tend/parse-bench (item manifest)
  (let ((name (nth 1 item))
        (opts (drop 2 item)))
    (let ((result (tend/parse-bench-opts opts nil 1)))
      (if (ok? result)
          (let ((bench (tend/bench-with name
                          (field (value result) :include)
                          (field (value result) :runs)))
                (benches (or-empty (field manifest :benches))))
            (tend/ok (tend/set manifest :benches (append benches (list bench)))))
          result))))

(defun tend/dependency-with (name kind path url rev)
  (list
    (list :name name)
    (list :kind kind)
    (list :path path)
    (list :url url)
    (list :rev rev)))

(defun tend/parse-dependency (item manifest)
  (let ((name (nth 1 item))
        (source (nth 2 item)))
    (let ((kind (first source)))
      (cond
        ((= kind 'path)
          (let ((dependency (tend/dependency-with name "path" (nth 1 source) nil nil))
                (dependencies (or-empty (field manifest :dependencies))))
            (tend/ok (tend/set manifest :dependencies
              (append dependencies (list dependency))))))
        ((= kind 'git)
          (let ((dependency (tend/dependency-with name "git" nil (nth 1 source) (nth 2 source)))
                (dependencies (or-empty (field manifest :dependencies))))
            (tend/ok (tend/set manifest :dependencies
              (append dependencies (list dependency))))))
        (else
          (tend/err (str "unknown dependency source " kind)))))))

(defun tend/mapping-package (name source exports)
  (list
    (list :name name)
    (list :source source)
    (list :exports exports)))

(defun tend/mapping-package-names (values)
  (if (nil? values)
      nil
      (cons (str (first values)) (tend/mapping-package-names (rest values)))))

(defun tend/parse-mapping-package-opt (opt opts name source exports)
  (let ((key (first opt)))
    (cond
      ((= key 'source)
        (tend/parse-mapping-package-opts opts name (nth 1 opt) exports))
      ((= key 'export)
        (tend/parse-mapping-package-opts opts name source
          (tend/mapping-package-names (rest opt))))
      (else (tend/err (str "unknown package mapping option " key))))))

(defun tend/parse-mapping-package-opts (opts name source exports)
  (if (nil? opts)
      (let ((result (tend/mapping-package name source exports)))
        (tend/ok result))
      (let ((opt (first opts)))
        (tend/parse-mapping-package-opt opt (rest opts) name source exports))))

(defun tend/parse-mapping-package (item)
  (let ((result (tend/parse-mapping-package-opts (drop 2 item) (nth 1 item) nil nil)))
    result))

(defun tend/mapping-interface (name packages)
  (list (list :name name) (list :packages packages)))

(defun tend/parse-mapping-interface-opts (opts packages)
  (if (nil? opts)
      (tend/ok (tend/mapping-interface nil packages))
      (let ((item (first opts)))
        (if (= (first item) 'package)
            (let ((result (tend/parse-mapping-package item)))
              (if (ok? result)
                  (tend/parse-mapping-interface-opts
                    (rest opts)
                    (append packages (list (value result))))
                  result))
            (tend/err (str "unknown interface mapping option " (first item)))))))

(defun tend/parse-mapping-interface (item)
  (if (nil? (nth 1 item))
      (tend/err "interface mapping needs a name")
      (let ((result (tend/parse-mapping-interface-opts (drop 2 item) nil)))
        (if (ok? result)
            (tend/ok (assoc :name (nth 1 item) (value result)))
            result))))

(defun tend/component-with (name world wit interfaces)
  (list
    (list :name name)
    (list :world world)
    (list :wit wit)
    (list :interfaces interfaces)))

(defun tend/parse-component-opts (opts world wit interfaces)
  (if (nil? opts)
      (if (or (nil? world) (nil? wit))
          (tend/err "component needs world and wit")
          (tend/ok (tend/component-with nil world wit interfaces)))
      (let ((item (first opts)))
        (let ((key (first item)))
          (cond
            ((= key 'world)
              (tend/parse-component-opts (rest opts) (nth 1 item) wit interfaces))
            ((= key 'wit)
              (tend/parse-component-opts (rest opts) world (nth 1 item) interfaces))
            ((= key 'interface)
              (let ((result (tend/parse-mapping-interface item)))
                (if (ok? result)
                    (tend/parse-component-opts (rest opts) world wit
                      (append interfaces (list (value result))))
                    result)))
            (else
              (tend/err (str "unknown component option " key))))))))

(defun tend/parse-component (item manifest)
  (if (nil? (nth 1 item))
      (tend/err "component needs a name")
      (let ((result (tend/parse-component-opts (drop 2 item) nil nil nil)))
        (if (ok? result)
            (let ((component (assoc :name (nth 1 item) (value result)))
                  (components (or-empty (field manifest :components))))
              (tend/ok (tend/set manifest :components
                (append components (list component)))))
            result))))

(defun tend/command-with (name summary run usage)
  (list
    (list :name name)
    (list :summary summary)
    (list :run run)
    (list :usage usage)))

(defun tend/parse-command-opts (opts summary run usage)
  (if (nil? opts)
      (if (or (nil? summary) (nil? run))
          (tend/err "command needs summary and run")
          (tend/ok (tend/command-with nil summary run usage)))
      (let ((opt (first opts)))
        (let ((key (first opt)))
          (cond
            ((= key 'summary)
              (tend/parse-command-opts (rest opts) (nth 1 opt) run usage))
            ((= key 'run)
              (tend/parse-command-opts (rest opts) summary (drop 1 opt) usage))
            ((= key 'usage)
              (tend/parse-command-opts (rest opts) summary run (nth 1 opt)))
            (else
              (tend/err (str "unknown command option " key))))))))

(defun tend/parse-command (item manifest)
  (let ((name (nth 1 item))
        (opts (drop 2 item)))
    (let ((result (tend/parse-command-opts opts nil nil nil)))
      (if (ok? result)
          (let ((command (tend/command-with name
                           (field (value result) :summary)
                           (field (value result) :run)
                           (field (value result) :usage)))
                (commands (or-empty (field manifest :commands))))
            (tend/ok (tend/set manifest :commands
              (append commands (list command)))))
          result))))


(defun tend/image-with (entry prelude compiler loads)
  (list
    (list :entry entry)
    (list :prelude prelude)
    (list :compiler compiler)
    (list :loads loads)))

(defun tend/parse-image-opts (opts entry prelude compiler loads)
  (if (nil? opts)
      (if (nil? entry)
          (tend/err "image needs an entry")
          (tend/ok (tend/image-with entry prelude compiler loads)))
      (let ((opt (first opts)))
        (let ((key (first opt)))
          (cond
            ((= key 'entry)
              (tend/parse-image-opts (rest opts) (nth 1 opt) prelude compiler loads))
            ((= key 'prelude)
              (tend/parse-image-opts (rest opts) entry (nth 1 opt) compiler loads))
            ((= key 'compiler)
              (tend/parse-image-opts (rest opts) entry prelude (nth 1 opt) loads))
            ((= key 'load)
              (tend/parse-image-opts (rest opts) entry prelude compiler (drop 1 opt)))
            (else
              (tend/err (str "unknown image option " key))))))))

(defun tend/parse-image (item manifest)
  (let ((result (tend/parse-image-opts (drop 1 item) nil nil nil nil)))
    (if (ok? result)
        (tend/ok (tend/set manifest :image (value result)))
        result)))

(defun tend/spore-with (id name version exports grants)
  (list
    (list :id id)
    (list :name name)
    (list :version version)
    (list :exports exports)
    (list :grants grants)))

(defun tend/parse-spore-opts (opts id name version exports grants)
  (if (nil? opts)
      (if (or (nil? id) (nil? version))
          (tend/err "spore needs id and version")
          (tend/ok (tend/spore-with id name version exports grants)))
      (let ((opt (first opts)))
        (let ((key (first opt)))
          (cond
            ((= key 'id)
              (tend/parse-spore-opts (rest opts) (nth 1 opt) name version exports grants))
            ((= key 'name)
              (tend/parse-spore-opts (rest opts) id (nth 1 opt) version exports grants))
            ((= key 'version)
              (tend/parse-spore-opts (rest opts) id name (nth 1 opt) exports grants))
            ((= key 'exports)
              (tend/parse-spore-opts (rest opts) id name version (drop 1 opt) grants))
            ((= key 'grants)
              (tend/parse-spore-opts (rest opts) id name version exports (drop 1 opt)))
            (else
              (tend/err (str "unknown spore option " key))))))))

(defun tend/parse-spore (item manifest)
  (let ((result (tend/parse-spore-opts (drop 1 item) nil nil nil nil nil)))
    (if (ok? result)
        (tend/ok (tend/set manifest :spore (value result)))
        result)))

(defun tend/parse-entry (item manifest)
  (let ((key (first item)))
    (cond
      ((= key 'version) (tend/parse-version item manifest))
      ((= key 'members) (tend/parse-members item manifest))
      ((= key 'test) (tend/parse-test item manifest))
      ((= key 'bench) (tend/parse-bench item manifest))
      ((= key 'dependency) (tend/parse-dependency item manifest))
      ((= key 'command) (tend/parse-command item manifest))
      ((= key 'component) (tend/parse-component item manifest))
      ((= key 'image) (tend/parse-image item manifest))
      ((= key 'spore) (tend/parse-spore item manifest))
      (else (tend/err (str "unknown tend key " key))))))

(defun tend/parse-entries (entries manifest)
  (if (nil? entries)
      (tend/finish manifest)
      (let ((result (tend/parse-entry (first entries) manifest)))
        (if (ok? result)
            (tend/parse-entries (rest entries) (value result))
            result))))

(defun tend/finish (manifest)
  (cond
    ((nil? (field manifest :version)) (tend/err "version is required"))
    ((nil? (field manifest :members)) (tend/err "members is required"))
    (else (tend/ok manifest))))

(defun tend/parse (source)
  (let ((forms (read source)))
    (if (nil? forms)
        (tend/err "empty tend.soil")
        (if (not (nil? (rest forms)))
            (tend/err "expected exactly one form")
            (let ((form (first forms)))
              (if (not (= (first form) 'tend))
                  (tend/err "expected a (tend ...) form")
                  (tend/parse-entries (rest form)
                    (list
                      (list :version nil)
                      (list :members nil)
                      (list :tests nil)
                      (list :benches nil)
                      (list :dependencies nil)
                      (list :commands nil)
                      (list :components nil)
                      (list :image nil)
                      (list :spore nil)))))))))

(defun tend/emit-option (key values)
  (if (nil? values)
      ""
      (str "    (" key (tend/string-list values) ")\n")))

(defun tend/emit-test (test)
  (str "  (test " (tend/quote (field test :name)) "\n"
       (tend/emit-option "include" (field test :include))
       (tend/emit-option "prelude" (field test :prelude))
       (tend/emit-option "bindings" (field test :bindings))
       "  )\n"))

(defun tend/emit-tests (tests)
  (if (nil? tests)
      ""
      (str (tend/emit-test (first tests)) (tend/emit-tests (rest tests)))))

(defun tend/emit-bench (bench)
  (str "  (bench " (tend/quote (field bench :name)) "\n"
       (tend/emit-option "include" (field bench :include))
       "    (runs " (field bench :runs) ")\n"
       "  )\n"))

(defun tend/emit-benches (benches)
  (if (nil? benches)
      ""
      (str (tend/emit-bench (first benches)) (tend/emit-benches (rest benches)))))

(defun tend/emit-dependency (dependency)
  (let ((name (tend/quote (field dependency :name)))
        (kind (field dependency :kind)))
    (if (= kind "path")
        (str "  (dependency " name
             " (path " (tend/quote (field dependency :path)) "))\n")
        (str "  (dependency " name
             " (git " (tend/quote (field dependency :url))
             " " (tend/quote (field dependency :rev)) "))\n"))))

(defun tend/emit-dependencies (dependencies)
  (if (nil? dependencies)
      ""
      (str (tend/emit-dependency (first dependencies))
           (tend/emit-dependencies (rest dependencies)))))

(defun tend/emit-command (command)
  (str "  (command " (tend/quote (field command :name)) "\n"
       "    (summary " (tend/quote (field command :summary)) ")\n"
       "    (run" (tend/string-list (field command :run)) ")\n"
       (if (nil? (field command :usage))
           ""
           (str "    (usage " (tend/quote (field command :usage)) ")\n"))
       "  )\n"))

(defun tend/emit-commands (commands)
  (if (nil? commands)
      ""
      (str (tend/emit-command (first commands))
           (tend/emit-commands (rest commands)))))

(defun tend/emit-mapping-package (package)
  (str "      (package " (tend/quote (field package :name)) "\n"
       (if (nil? (field package :source)) ""
           (str "        (source " (tend/quote (field package :source)) ")\n"))
       (if (nil? (field package :exports)) ""
           (str "        (export" (tend/string-list (field package :exports)) ")\n"))
       "      )\n"))

(defun tend/emit-mapping-packages (packages)
  (if (nil? packages)
      ""
      (str (tend/emit-mapping-package (first packages))
           (tend/emit-mapping-packages (rest packages)))))

(defun tend/emit-mapping-interface (interface)
  (str "    (interface " (tend/quote (field interface :name)) "\n"
       (tend/emit-mapping-packages (field interface :packages))
       "    )\n"))

(defun tend/emit-mapping-interfaces (interfaces)
  (if (nil? interfaces)
      ""
      (str (tend/emit-mapping-interface (first interfaces))
           (tend/emit-mapping-interfaces (rest interfaces)))))

(defun tend/emit-component (component)
  (str "  (component " (tend/quote (field component :name)) "\n"
       "    (world " (tend/quote (field component :world)) ")\n"
       "    (wit " (tend/quote (field component :wit)) ")\n"
       (tend/emit-mapping-interfaces (field component :interfaces))
       "  )\n"))

(defun tend/emit-components (components)
  (if (nil? components)
      ""
      (str (tend/emit-component (first components))
           (tend/emit-components (rest components)))))


(defun tend/emit-image (image)
  (if (nil? image)
      ""
      (str "  (image\n"
           "    (entry " (tend/quote (field image :entry)) ")\n"
           (if (nil? (field image :prelude))
               ""
               (str "    (prelude " (tend/quote (field image :prelude)) ")\n"))
           (if (nil? (field image :compiler))
               ""
               (str "    (compiler " (tend/quote (field image :compiler)) ")\n"))
           (if (nil? (field image :loads))
               ""
               (str "    (load" (tend/string-list (field image :loads)) ")\n"))
           "  )\n")))

(defun tend/emit-spore (spore)
  (if (nil? spore)
      ""
      (str "  (spore\n"
           "    (id " (tend/quote (field spore :id)) ")\n"
           (if (nil? (field spore :name))
               ""
               (str "    (name " (tend/quote (field spore :name)) ")\n"))
           "    (version " (tend/quote (field spore :version)) ")\n"
           (if (nil? (field spore :exports))
               ""
               (str "    (exports" (tend/string-list (field spore :exports)) ")\n"))
           "  )\n")))

(defun tend/emit (manifest)
  (str "(tend\n"
       "  (version " (field manifest :version) ")\n"
       "  (members" (tend/string-list (field manifest :members)) ")\n"
       (tend/emit-image (field manifest :image))
       (tend/emit-spore (field manifest :spore))
       (tend/emit-tests (field manifest :tests))
       (tend/emit-benches (field manifest :benches))
       (tend/emit-dependencies (field manifest :dependencies))
       (tend/emit-commands (field manifest :commands))
       (tend/emit-components (field manifest :components))
       ")\n"))

;;; Find one component declaration by package name.
(defun tend/find-component (manifest name)
  (find (lambda (component) (= (field component :name) name))
    (or-empty (field manifest :components))))

;;; Return the source-package -> WIT interface mapping for one component.
;;; The mapping is data; the compiler consumes it, tend does not invent types.
(defun tend/wit-plan (manifest name)
  (let ((component (tend/find-component manifest name)))
    (if (nil? component)
        (tend/err (str "unknown component " name))
        (tend/ok
          (list
            (list :component name)
            (list :world (field component :world))
            (list :wit (field component :wit))
            (list :interfaces (field component :interfaces)))))))

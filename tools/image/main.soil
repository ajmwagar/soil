; SPDX-License-Identifier: MIT OR Apache-2.0
; In-memory image server over JSON lines.
;
; One process is one live Runtime. Loaded sources are tracked so flush can
; write the live image back through the WASI filesystem. This is still an
; interpreter image: flush writes tracked sources, not reconstructed bytecode.
;
; Request:  {"op":"ping"}
;           {"op":"attach","session":"s1"}
;           {"op":"load","session":"s1","path":"lib.soil"}
;           {"op":"eval","session":"s1","path":"lib.soil","source":"..."}
;           {"op":"eval","session":"s1","source":"(+ 1 2)"}
;           {"op":"status","session":"s1"}
;           {"op":"flush","session":"s1"}
;           {"op":"save","session":"s1","path":"x.soil","source":"..."}
;           {"op":"list"}
;           {"op":"detach","session":"s1"}


(defun image/snapshot-text (loaded)
  (let ((entries
          (if (nil? loaded)
              ""
              (reduce
                (lambda (out entry)
                  (str out "  (source "
                       (json-encode (first entry)) " "
                       (json-encode (nth 1 entry)) ")\n"))
                "" loaded))))
    (str "(image\n"
         "  (format 1)\n"
         entries
         ")\n")))

(defun image/snapshot-loaded (forms)
  (cond
    ((nil? forms) nil)
    ((= (first (first forms)) 'source)
      (cons (list (nth 1 (first forms)) (nth 2 (first forms)))
            (image/snapshot-loaded (rest forms))))
    (else (image/snapshot-loaded (rest forms)))))

(defun image/restore-entries (entries)
  (if (nil? entries)
      (list 'ok nil)
      (let ((entry (first entries)))
        (load (nth 1 entry))
        (image/restore-entries (rest entries)))))

(defun image/write (value)
  (stdout-write (str (image/encode value) "\n")))

(defun image/session-of (request fallback)
  (let ((session (image/request-or request :session nil)))
    (cond
      ((not (nil? session)) session)
      ((not (nil? (image/request-or request :name nil)))
        (image/request-or request :name fallback))
      (else fallback))))

(defun image/eval-response (request session)
  (let ((source (image/request-or request :source "")))
    (image/response-ok
      (list
        (list :session session)
        (list :result (image/result-text (load source)))))))

(defun image/loaded-paths (loaded)
  (if (nil? loaded) nil (map (lambda (entry) (first entry)) loaded)))

(defun image/flush-loaded (loaded)
  (if (nil? loaded)
      (list 'ok #t)
      (let ((entry (first loaded)))
        (let ((result (fs/write (first entry) (nth 1 entry))))
          (if (ok? result)
              (image/flush-loaded (rest loaded))
              result)))))

(defun image/handle (request session attached loaded)
  (let ((op (image/request-or request :op "")))
    (cond
      ((= op "ping")
        (image/response-ok (list (list :pong #t))))
      ((= op "list")
        (image/response-ok
          (list (list :sessions (if attached (list session) nil))
                (list :images (if attached (list session) nil)))))
      ((= op "attach")
        (image/response-ok
          (list (list :session session)
                (list :image session)
                (list :existing attached))))
      ((= op "detach")
        (image/response-ok
          (list (list :session session) (list :detached session))))
      ((= op "eval")
        (if attached
            (image/eval-response request session)
            (image/response-err "no attached image")))
      ((= op "status")
        (image/response-ok
          (list
            (list :session session)
            (list :attached attached)
            (list :dirty nil)
            (list :unattached nil)
            (list :loaded (image/loaded-paths loaded)))))
      ((= op "load")
        (let ((path (image/request-or request :path "")))
          (let ((result (fs/read path)))
            (if (ok? result)
                (let ((value (load (value result))))
                  (image/response-ok
                    (list
                      (list :session session)
                      (list :loaded path)
                      (list :result (image/result-text value)))))
                (image/response-err (str result))))))
      ((= op "flush")
        (let ((path (image/request-or request :path nil))
              (source (image/request-or request :source nil)))
          (if (and (not (nil? path)) (not (nil? source)))
              (let ((result (fs/write path source)))
                (if (ok? result)
                    (image/response-ok
                      (list (list :session session) (list :path path) (list :flushed #t)))
                    (image/response-err (str result))))
              (let ((result (image/flush-loaded loaded)))
                (if (ok? result)
                    (image/response-ok
                      (list (list :session session)
                            (list :files (image/loaded-paths loaded))
                            (list :flushed #t)))
                    (image/response-err (str result)))))))
      ((= op "save")
        (let ((path (image/request-or request :path "")))
          (let ((source (image/request-or request :source nil)))
            (if (nil? source)
                (image/response-err "save needs source")
                (let ((result (fs/write path source)))
                  (if (ok? result)
                      (image/response-ok
                        (list (list :session session) (list :path path) (list :saved #t)))
                      (image/response-err (str result))))))))
      ((= op "snapshot")
        (let ((path (image/request-or request :path "")))
          (if (= path "")
              (image/response-err "snapshot needs path")
              (let ((result (fs/write path (image/snapshot-text loaded))))
                (if (ok? result)
                    (image/response-ok
                      (list (list :session session) (list :path path) (list :snapshot #t)))
                    (image/response-err (str result)))))))
      ((= op "restore")
        (let ((path (image/request-or request :path "")))
          (if (= path "")
              (image/response-err "restore needs path")
              (let ((read (fs/read path)))
                (if (not (ok? read))
                    (image/response-err (str read))
                    (let ((snapshot (first (read (value read)))))
                      (let ((entries (image/snapshot-loaded (rest snapshot))))
                        (let ((result (image/restore-entries entries)))
                          (if (ok? result)
                              (image/response-ok
                                (list (list :session session)
                                      (list :path path)
                                      (list :restored (length entries))
                                      (list :loaded (image/loaded-paths entries))))
                              (image/response-err (str result)))))))))))
      ((= op "reload")
        (image/response-err "reload is not implemented in the in-memory image"))
      ((= op "compile")
        (image/response-err "compile is not in the in-memory image"))
      ((= op "call-compiled")
        (image/response-err "call-compiled is not in the in-memory image"))
      (else
        (image/response-err (str "unknown op " op))))))

(defun image/next-loaded (request op loaded)
  (let ((path (image/request-or request :path nil)))
    (cond
      ((nil? path) loaded)
      ((= op "load")
        (let ((source (fs/read path)))
          (if (ok? source)
              (assoc path (value source) loaded)
              loaded)))
      ((= op "eval")
        (assoc path (image/request-or request :source "") loaded))
      ((= op "save")
        (assoc path (image/request-or request :source "") loaded))
      ((= op "flush")
        (assoc path (image/request-or request :source "") loaded))
      ((= op "restore")
        (let ((snapshot (fs/read path)))
          (if (ok? snapshot)
              (image/snapshot-loaded (rest (first (read (value snapshot)))))
              loaded)))
      (else loaded))))

(defun image/run (session attached loaded)
  (let ((line (stdin-read-line)))
    (if (nil? line)
        nil
        (if (= line "")
            (image/run session attached loaded)
            (let ((request (json-decode line)))
              (let ((request-session (image/session-of request session)))
                (let ((op (image/request-or request :op "")))
                  (let ((response (image/handle request request-session attached loaded)))
                    (image/write response)
                    (image/run request-session
                      (cond
                        ((= op "attach") #t)
                        ((= op "detach") #f)
                        (else attached))
                      (image/next-loaded request op loaded))))))))))

(defun main ()
  (image/run "default" #f nil))

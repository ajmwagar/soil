; SPDX-License-Identifier: MIT OR Apache-2.0
; In-memory image server over JSON lines.
;
; One process is one live Runtime. This is the interpreter-backed image: no
; VFS flush yet, but definitions, eval, attach, and status are live in Wasm.
;
; Request:  {"op":"ping"}
;           {"op":"attach","session":"s1"}
;           {"op":"eval","session":"s1","source":"(+ 1 2)"}
;           {"op":"status","session":"s1"}
;           {"op":"list"}
;           {"op":"detach","session":"s1"}
; Response: {"ok":true,"result":...} or {"ok":false,"error":"..."}

(defun image/read (fallback)
  (let ((line (stdin-read-line)))
    (if (nil? line) nil line)))

(defun image/write (value)
  (stdout-write (str (image/encode value) "\n")))

(defun image/session-of (request fallback)
  (let ((session (image/request-or request :session nil)))
    (cond
      ((not (nil? session)) session)
      ((not (nil? (image/request-or request :name nil)))
        (image/request-or request :name fallback))
      (else fallback))))

(defun image/eval-response (request session)
  (let ((source (image/request-or request :source "")))
    (image/response-ok
      (list
        (list :session session)
        (list :result (image/result-text (load source)))))))

(defun image/handle (request session attached)
  (let ((op (image/request-or request :op "")))
    (cond
      ((= op "ping")
        (image/response-ok (list (list :pong #t))))
      ((= op "list")
        (image/response-ok
          (list (list :sessions (if attached (list session) nil))
                (list :images (if attached (list session) nil)))))
      ((= op "attach")
        (image/response-ok
          (list (list :session session)
                (list :image session)
                (list :existing attached))))
      ((= op "detach")
        (image/response-ok
          (list (list :session session) (list :detached session))))
      ((= op "eval")
        (if attached
            (image/eval-response request session)
            (image/response-err "no attached image")))
      ((= op "status")
        (image/response-ok
          (list
            (list :session session)
            (list :attached attached)
            (list :dirty nil)
            (list :unattached nil)
            (list :loaded nil))))
      ((= op "load")
        (let ((path (image/request-or request :path "")))
          (let ((result (fs/read path)))
            (if (ok? result)
                (let ((value (load (value result))))
                  (image/response-ok
                    (list
                      (list :session session)
                      (list :loaded path)
                      (list :result (image/result-text value)))))
                (image/response-err (str result))))))
      ((= op "flush")
        (let ((path (image/request-or request :path "")))
          (let ((source (image/request-or request :source nil)))
            (if (nil? source)
                (image/response-err "flush needs explicit source in the in-memory image")
                (let ((result (fs/write path source)))
                  (if (ok? result)
                      (image/response-ok
                        (list (list :session session) (list :path path) (list :flushed #t)))
                      (image/response-err (str result))))))))
      ((= op "save")
        (let ((path (image/request-or request :path "")))
          (let ((source (image/request-or request :source nil)))
            (if (nil? source)
                (image/response-err "save needs source")
                (let ((result (fs/write path source)))
                  (if (ok? result)
                      (image/response-ok
                        (list (list :session session) (list :path path) (list :saved #t)))
                      (image/response-err (str result))))))))
      ((= op "reload")
        (image/response-err "reload needs a VFS host"))
      ((= op "compile")
        (image/response-err "compile is not in the in-memory image"))
      ((= op "call-compiled")
        (image/response-err "call-compiled is not in the in-memory image"))
      (else
        (image/response-err (str "unknown op " op))))))

(defun image/run (session attached)
  (let ((line (image/read nil)))
    (if (nil? line)
        nil
        (if (= line "")
            (image/run session attached)
            (let ((request (json-decode line)))
              (let ((request-session (image/session-of request session)))
                (let ((op (image/request-or request :op "")))
                  (let ((response (image/handle request request-session attached)))
                    (image/write response)
                    (image/run request-session
                      (cond
                        ((= op "attach") #t)
                        ((= op "detach") #f)
                        (else attached)))))))))))

(defun main ()
  (image/run "default" #f))

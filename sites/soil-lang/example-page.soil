; SPDX-License-Identifier: MIT OR Apache-2.0
; Shared shell for static example pages.

(defun example-link (href label)
  (el "a" (list (attr :href href)) (list (txt label))))

(defun example-page (title description body)
  (el "div" (list (attr :class "example-shell"))
    (list
      (el "header" (list (attr :class "example-bar"))
        (list
          (example-link "/" "← Soil")
          (el "span" (list (attr :class "example-title")) (list (txt title)))
          (example-link "https://github.com/mycelium-linux/soil" "GitHub")))
      (el "div" (list (attr :class "example-note"))
        (list (txt description)))
      (el "main" (list (attr :class "example-body"))
        (list body)))))

(defun example-styles ()
  (str
    ".example-shell { min-height: 100vh; background: #090b10; color: #eef1f7; font: 15px/1.55 ui-sans-serif, system-ui, sans-serif; }\n"
    ".example-bar { position: sticky; top: 0; z-index: 50; display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 12px clamp(18px, 4vw, 40px); border-bottom: 1px solid rgba(255,255,255,.09); background: rgba(9,11,16,.82); backdrop-filter: blur(14px); }\n"
    ".example-bar a { color: #c8f169; text-decoration: none; font-size: 12px; font-weight: 700; }\n"
    ".example-bar a:hover { color: #eef1f7; }\n"
    ".example-title { color: #9aa2b5; font: 11px/1 ui-monospace, SFMono-Regular, Menlo, monospace; letter-spacing: .12em; text-transform: uppercase; }\n"
    ".example-note { padding: 10px clamp(18px, 4vw, 40px); border-bottom: 1px solid rgba(255,255,255,.06); color: #6c7488; font-size: 12.5px; }\n"
    ".example-body .app { min-height: calc(100vh - 92px); }\n"))

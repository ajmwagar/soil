; SPDX-License-Identifier: MIT OR Apache-2.0
; Project doc comments into Markdown, llms.txt, and human-readable HTML.
;
; The host wrapper extracts entries in stack-sized chunks (the evaluator is
; recursive) and supplies `soil-doc-pages`, a JSON array of
; `{slug,title,summary,entries}` objects. This file owns projection: the same
; entries become agent Markdown, the llms index, and the HTML docs pages.

(defun docs-page-file (page)
  (list
    (list :path (str "docs/" (field page :slug) ".md"))
    (list :text
      (doc-page-markdown
        (field page :title)
        (field page :summary)
        (field page :entries)))))

(defun docs-page-html-file (page pages)
  (list
    (list :path (str "docs/" (field page :slug) ".html"))
    (list :text (doc-page-html "Soil" page pages))))

(defun docs-index-file (pages)
  (list
    (list :path "docs/index.md")
    (list :text (doc-docs-index-markdown "Soil" pages))))

(defun docs-index-html-file (pages)
  (list
    (list :path "docs/index.html")
    (list :text (doc-index-html "Soil" pages))))

(defun docs-llms-file (pages)
  (list
    (list :path "llms.txt")
    (list :text (doc-index-markdown "Soil" pages))))

(defun docs-full-file (pages)
  (list
    (list :path "llms-full.txt")
    (list :text
      (doc-full-markdown
        (doc-index-markdown "Soil" pages)
        pages))))

(defun docs-page-files (pages)
  (map 'docs-page-file pages))

(defun docs-page-html-files (pages)
  (map-with 'docs-page-html-file pages pages))

(defun main ()
  (let ((pages (soil-doc-pages)))
    (json-encode
      (append
        (list
          (docs-index-file pages)
          (docs-index-html-file pages)
          (docs-llms-file pages)
          (docs-full-file pages))
        (append
          (docs-page-files pages)
          (docs-page-html-files pages))))))

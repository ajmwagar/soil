; Seed the identity collections from the checked-in fixtures.
;
;   phonebook seed
;
; Idempotent: an upsert replaces the record and lets the host assign a new
; revision. Badge definitions are written once, grants stay on the profile.

(defun phonebook/seed-profile (profile)
  (upsert-record
    (phonebook/profiles-collection)
    (field profile :handle)
    (phonebook/schema-profile)
    profile
    0))

(defun phonebook/seed-badge (badge)
  (upsert-record
    (phonebook/badges-collection)
    (field badge :id)
    (phonebook/schema-badge)
    badge
    0))

(defun phonebook/seed-all ()
  (map 'phonebook/seed-profile (phonebook/fixture-profiles))
  (map 'phonebook/seed-badge (phonebook/fixture-badges))
  (println
    (str "seeded "
         (length (phonebook/fixture-profiles)) " profiles and "
         (length (phonebook/fixture-badges)) " badge definitions into soil:records")))

(defun main ()
  (phonebook/seed-all))

; Date, URL, and JSON helpers without a host.

(defun main ()
  (println (str "date:      " (date/format 1700000000000)))
  (println (str "iso:       " (date/iso 1700000000000)))
  (println (str "relative:  " (date/relative 1700000000000 1699999940000)))
  (println (str "weekday:   " (date/weekday-name 1700000000000)))
  (println (str "query:     " (url/query (list (list "q" "living room")
                                                (list "limit" "5")))))
  (println (str "decoded:   " (url/decode-query "q=living+room&limit=5")))
  (println (str "joined:    " (url/join "https://example.com/" "/api/rooms")))
  (println (json/pretty
             (json/deep-merge
               (json-decode "{\"room\":{\"name\":\"Living room\",\"lights\":4}}")
               (json-decode "{\"room\":{\"lights\":3},\"ok\":true}")))))

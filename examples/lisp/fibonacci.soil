; Fibonacci: the smallest useful recursive shape.

(defun fib (n)
  (if (> n 25)
      "capped at 25"
      (if (< n 2)
          n
          (+ (fib (- n 1)) (fib (- n 2))))))

; Try changing 12 to 20. The naive version grows quickly.
(map 'fib (range 0 12))

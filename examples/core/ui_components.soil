; SPDX-License-Identifier: MIT OR Apache-2.0
; A one-page tour of the Soil UI component library.

(defun balance-card ()
  (ui/card "House" "A small overview"
    (list
      (ui/kicker "TONIGHT")
      (ui/heading 3 "Living room")
      (ui/row
        (list
          (ui/badge "4 lights" "good")
          (ui/badge "sunset" "warn")
          (ui/badge "playing" nil)))
      (ui/progress 3 4)
      (ui/text "Three of four lights are on." #t))))

(defun media-card ()
  (ui/card "Now playing" "deadwax · home-pi"
    (list
      (ui/row
        (list
          (ui/cover nil "Album cover" "PB")
          (ui/stack
            (list
              (ui/heading 3 "Porro Bonito")
              (ui/text "Orquesta Ritmo De Sabanas" #t)
              (ui/badge "playing" "good")))))
      (ui/kv
        (list
          (list "Queue" "8 tracks")
          (list "Source" "owned library"))))))

(defun table-card ()
  (ui/card "Rooms" "Per-room state"
    (list
      (ui/table
        (list "Room" "Lights" "State")
        (list
          (list "Living room" "4" (ui/badge "on" "good"))
          (list "Kitchen" "1" (ui/badge "off" nil))
          (list "Bedroom" "2" (ui/badge "dim" "warn")))))))

(defun form-card ()
  (ui/card "Set a scene" "A form the host can route"
    (list
      (ui/form "/scene" "post"
        (list
          (ui/field "Room"
            (ui/select "room"
              (list (list "living" "Living room")
                    (list "kitchen" "Kitchen"))
              "living")
            nil)
          (ui/field "Mood"
            (ui/input "mood" "sunset" "e.g. sunset" nil)
            "The bridge resolves the palette.")
          (ui/button "Apply" "scene.apply" "primary"))))))

(defun spark-card ()
  (ui/card "This week" "A sparkline is enough"
    (list
      (ui/stat "Sessions" "14" "up 3 from last week")
      (ui/sparkline (list 2 4 3 7 5 9 8) 100 34))))

(defun state-cards ()
  (ui/grid
    (list
      (ui/empty "No captures" "Scribe has nothing for today.")
      (ui/error-state "Bridge offline" "The last snapshot is still on screen.")
      (ui/card "Loading" nil (list (ui/skeleton 4))))))

(defun main ()
  (println
    (render-page "Soil components" (ui/base-css)
      (ui/stack
        (list
          (ui/row
            (list
              (ui/kicker "SOIL UI")
              (ui/badge "components" "good")))
          (ui/heading 1 "The house, on one wall.")
          (ui/text "Cards, tables, forms, covers, sparklines, and honest empty states." #t)
          (ui/grid
            (list (balance-card) (media-card) (table-card) (form-card) (spark-card)))
          (ui/heading 2 "States")
          (state-cards))))))

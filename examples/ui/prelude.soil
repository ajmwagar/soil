; Shared UI prelude for the examples: action decoding and the base theme.
;
; The host loads this after core/prelude.soil. Examples only define their
; own state, update, view, and any additional CSS.

(defun action-decode (action)
  (if (string-contains? action "{")
      (json-decode action)
      (list (list :op action))))

(defun action-op (action)
  (field (action-decode action) :op))

(defun action-field (action key fallback)
  (let ((value (field (action-decode action) key)))
    (if (nil? value) fallback value)))

(defun example-page (name state view)
  (list
    (el "div"
      (list
        (attr :id "root")
        (attr :data-example name)
        (attr :data-state (json-encode state)))
      (list view))
    (el "script" (list (attr :src "example.js") (attr :defer "")) nil)))

(defun base-styles ()
  (str
    "/* Hallmark · macrostructure: example surface · theme: warm charcoal · genre: editorial\n"
    " * pre-emit critique: P4 H4 E4 S3 R4 V3\n"
    " * slop test: pass\n"
    " */\n"
    ":root {\n"
    "  color-scheme: dark;\n"
    "  --bg: #14120f;\n"
    "  --panel: #1b1814;\n"
    "  --panel-2: #211d18;\n"
    "  --ink: #f1ece3;\n"
    "  --muted: #b8afa1;\n"
    "  --dim: #8b8173;\n"
    "  --line: #3a342d;\n"
    "  --accent: #d77b52;\n"
    "  --accent-ink: #1d120d;\n"
    "  --danger: #d79b8f;\n"
    "  --danger-soft: #2a1b17;\n"
    "  --danger-line: #6b3a30;\n"
    "  --tok-string: #b7c99a;\n"
    "  --tok-keyword: #d9a06b;\n"
    "  --tok-literal: #e6c07b;\n"
    "  --tok-number: #d79b8f;\n"
    "  --font-display: ui-serif, Georgia, \"Times New Roman\", serif;\n"
    "  --font-body: ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", sans-serif;\n"
    "  --font-mono: ui-monospace, SFMono-Regular, Menlo, monospace;\n"
    "}\n"
    "html, body { overflow-x: clip; }\n"
    "* { box-sizing: border-box; }\n"
    ".app {\n"
    "  min-height: 100vh;\n"
    "  padding: 28px clamp(20px, 5vw, 64px) 64px;\n"
    "  color: var(--ink);\n"
    "  background: var(--bg);\n"
    "  font-family: var(--font-body);\n"
    "  font-size: 15px;\n"
    "  line-height: 1.55;\n"
    "}\n"
    "h1, h2, h3 { overflow-wrap: anywhere; min-width: 0; }\n"
    ".topbar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px; }\n"
    ".brand { font-family: var(--font-mono); font-weight: 700; letter-spacing: .12em; font-size: 12px; }\n"
    ".brand-sub { margin-left: 10px; color: var(--muted); font-weight: 500; letter-spacing: .04em; text-transform: lowercase; }\n"
    ".pill { border: 1px solid var(--line); border-radius: 999px; padding: 6px 12px; color: var(--muted); font-size: 12px; background: var(--panel); }\n"
    ".stage { margin-top: 0; max-width: 1080px; }\n"
    ".card { border: 1px solid var(--line); border-radius: 16px; padding: clamp(18px, 3vw, 28px); background: var(--panel); }\n"
    ".card.soft { background: var(--panel-2); }\n"
    ".eyebrow { margin: 0 0 8px; color: var(--dim); font-family: var(--font-mono); font-size: 11px; letter-spacing: .12em; }\n"
    ".hint { margin: 14px 0 22px; color: var(--muted); max-width: 52ch; }\n"
    ".row { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; }\n"
    ".spread { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; justify-content: space-between; }\n"
    ".btn { appearance: none; border: 1px solid var(--line); border-radius: 999px; padding: 10px 16px; min-width: 44px; cursor: pointer; color: var(--ink); background: var(--panel-2); font-family: var(--font-body); font-size: 14px; font-weight: 600; line-height: 1.2; white-space: nowrap; transition: transform .08s ease, border-color .15s ease; }\n"
    ".btn:hover { border-color: var(--accent); color: var(--accent); }\n"
    ".btn:active { transform: translateY(1px); }\n"
    ".btn:focus-visible, .input:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }\n"
    ".btn.primary { background: var(--accent); border-color: var(--accent); color: var(--accent-ink); }\n"
    ".btn.primary:hover { background: var(--accent); color: var(--accent-ink); }\n"
    ".btn.ghost { color: var(--muted); }\n"
    ".btn.danger { color: var(--danger); }\n"
    ".btn:disabled { opacity: .45; cursor: not-allowed; transform: none; }\n"
    ".input { flex: 1; min-width: 0; padding: 11px 14px; border: 1px solid var(--line); border-radius: 10px; background: var(--bg); color: var(--ink); font-family: var(--font-body); font-size: 15px; line-height: 1.3; }\n"
    ".input::placeholder { color: var(--dim); }\n"
    ".stack { display: grid; gap: 12px; }\n"
    ".muted { color: var(--muted); }\n"
    ".mono { font-family: var(--font-mono); }\n"
    ".code { margin: 0 0 16px; padding: 14px 16px; overflow-x: auto; border: 1px solid var(--line); border-radius: 10px; background: var(--bg); color: var(--ink); font-family: var(--font-mono); font-size: 12.5px; line-height: 1.6; white-space: pre-wrap; }\n"
    ".tok-comment { color: var(--dim); font-style: italic; }\n"
    ".tok-string { color: var(--tok-string); }\n"
    ".tok-keyword { color: var(--tok-keyword); }\n"
    ".tok-literal { color: var(--tok-literal); }\n"
    ".tok-number { color: var(--tok-number); }\n"
    ".tok-special { color: var(--accent); font-weight: 700; }\n"
    ".tok-paren { color: var(--dim); }\n"
    ".tok-fn { color: var(--ink); }\n"
    ".tok-symbol { color: var(--ink); }\n"
    "@media (prefers-reduced-motion: reduce) { .btn { transition: none; } }\n"))

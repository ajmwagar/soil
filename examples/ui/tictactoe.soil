; SPDX-License-Identifier: MIT OR Apache-2.0
; Tic-tac-toe: lists, indexing, immutable updates, win detection, and a
; one-player opponent. Mode is part of the state.

(defun empty-board ()
  (list nil nil nil nil nil nil nil nil nil))

(defun board-state (board turn winner mode)
  (list
    (list :board board)
    (list :turn turn)
    (list :winner winner)
    (list :mode mode)))

(defun initial-state ()
  (board-state (empty-board) "X" nil "1p"))

(defun reset-state (mode)
  (board-state (empty-board) "X" nil mode))

(defun line-win (board a b c player)
  (and
    (= (nth a board) player)
    (= (nth b board) player)
    (= (nth c board) player)))

(defun winner (board)
  (cond
    ((line-win board 0 1 2 "X") "X")
    ((line-win board 3 4 5 "X") "X")
    ((line-win board 6 7 8 "X") "X")
    ((line-win board 0 3 6 "X") "X")
    ((line-win board 1 4 7 "X") "X")
    ((line-win board 2 5 8 "X") "X")
    ((line-win board 0 4 8 "X") "X")
    ((line-win board 2 4 6 "X") "X")
    ((line-win board 0 1 2 "O") "O")
    ((line-win board 3 4 5 "O") "O")
    ((line-win board 6 7 8 "O") "O")
    ((line-win board 0 3 6 "O") "O")
    ((line-win board 1 4 7 "O") "O")
    ((line-win board 2 5 8 "O") "O")
    ((line-win board 0 4 8 "O") "O")
    ((line-win board 2 4 6 "O") "O")
    (else nil)))

(defun full? (board)
  (all? 'filled? board))

(defun filled? (value)
  (not (nil? value)))

(defun winning-move-for (board player index)
  (cond
    ((>= index 9) nil)
    ((not (nil? (nth index board)))
      (winning-move-for board player (+ index 1)))
    ((= (winner (list-set index player board)) player)
      index)
    (else
      (winning-move-for board player (+ index 1)))))

(defun first-empty-of (board indices)
  (cond
    ((nil? indices) nil)
    ((nil? (nth (first indices) board)) (first indices))
    (else (first-empty-of board (rest indices)))))

(defun first-empty (board index)
  (cond
    ((>= index 9) nil)
    ((nil? (nth index board)) index)
    (else (first-empty board (+ index 1)))))

(defun computer-move (board)
  (let ((win (winning-move-for board "O" 0)))
    (if (not (nil? win))
        win
        (let ((block (winning-move-for board "X" 0)))
          (if (not (nil? block))
              block
              (if (nil? (nth 4 board))
                  4
                  (let ((corner (first-empty-of board (list 0 2 6 8))))
                    (if (not (nil? corner))
                        corner
                        (first-empty board 0)))))))))

(defun computer-reply (state)
  (if (and
        (= (field state :mode) "1p")
        (= (field state :turn) "O")
        (nil? (field state :winner)))
      (let ((move (computer-move (field state :board))))
        (if (nil? move)
            state
            (let ((next (list-set move "O" (field state :board)))
                  (win (winner next)))
              (board-state next "X" win (field state :mode)))))
      state))

(defun play (state index)
  (let ((board (field state :board))
        (turn (field state :turn))
        (won (field state :winner))
        (mode (field state :mode)))
    (if (or
          (not (nil? won))
          (not (nil? (nth index board)))
          (and (= mode "1p") (= turn "O")))
        state
        (let ((next (list-set index turn board))
              (win (winner next)))
          (computer-reply
            (board-state next (if (= turn "X") "O" "X") win mode))))))

(defun update (state action)
  (let ((op (action-op action)))
    (cond
      ((= op "play")
        (play state (json-decode (action-field action :index "0"))))
      ((= op "mode")
        (reset-state (action-field action :mode "1p")))
      ((= op "reset")
        (reset-state (field state :mode)))
      (else state))))

(defun mode-button (mode current label)
  (el "button"
    (list
      (attr :class (if (= mode current) "btn primary" "btn ghost"))
      (attr :data-op "mode")
      (attr :data-mode mode))
    (list (txt label))))

(defun cell (board won index)
  (let ((mark (nth index board)))
    (el "button"
      (list
        (attr :class (if (nil? mark) "cell" (str "cell " mark)))
        (attr :data-key (str index))
        (attr :data-op "play")
        (attr :data-index (str index))
        (attr :disabled (or (not (nil? mark)) (not (nil? won)))))
      (list (txt (if (nil? mark) "" mark))))))

(defun cells (board won index)
  (if (>= index 9)
      nil
      (cons (cell board won index) (cells board won (+ index 1)))))

(defun view (state)
  (let ((board (field state :board))
        (turn (field state :turn))
        (won (field state :winner))
        (mode (field state :mode)))
    (el "div" (list (attr :class "app"))
      (list
        (el "header" (list (attr :class "topbar"))
          (list
            (el "div" (list (attr :class "brand"))
              (list
                (txt "SOIL")
                (el "span" (list (attr :class "brand-sub"))
                  (list (txt "tic-tac-toe")))))
            (el "div" (list (attr :class "pill"))
              (list (txt (if (= mode "1p") "1 player" "2 players"))))))
        (el "main" (list (attr :class "stage"))
          (list
            (el "section" (list (attr :class "card ttt-card"))
              (list
                (el "p" (list (attr :class "eyebrow"))
                  (list (txt "TIC-TAC-TOE")))
                (el "div" (list (attr :class "row mode-row"))
                  (list
                    (mode-button "1p" mode "1 player")
                    (mode-button "2p" mode "2 players")))
                (el "p" (list (attr :class "status"))
                  (list (txt
                    (cond
                      ((not (nil? won)) (str won " wins"))
                      ((full? board) "Draw")
                      ((and (= mode "1p") (= turn "O")) "Computer to move")
                      ((= mode "1p") "Your move")
                      (else (str turn " to move"))))))
                (el "div" (list (attr :class "board"))
                  (cells board won 0))
                (el "div" (list (attr :class "row"))
                  (list
                    (el "button" (list (attr :class "btn ghost") (attr :data-op "reset"))
                      (list (txt "New game")))))))))))))

(defun styles ()
  (str
    (base-styles)
    ".ttt-card { max-width: 460px; }\n"
    ".mode-row { margin-bottom: 14px; }\n"
    ".mode-row .btn { padding: 7px 12px; font-size: 12px; }\n"
    ".status { margin: 14px 0 18px; font-size: 18px; font-weight: 600; }\n"
    ".board { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; margin-bottom: 18px; }\n"
    ".cell {\n"
    "  aspect-ratio: 1; border: 1px solid var(--line); border-radius: 14px;\n"
    "  background: var(--panel-2); color: var(--ink); cursor: pointer;\n"
    "  font-family: var(--font-body); font-size: clamp(28px, 8vw, 48px); font-weight: 700; line-height: 1;\n"
    "  transition: background .15s ease, border-color .15s ease;\n"
    "}\n"
    ".cell:hover:not(:disabled) { background: var(--panel-2); border-color: var(--line); }\n"
    ".cell:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }\n"
    ".cell:disabled { cursor: default; }\n"
    ".cell.X { color: var(--accent); }\n"
    ".cell.O { color: var(--accent); }\n"))

; SPDX-License-Identifier: MIT OR Apache-2.0
; Counter: the smallest complete UI.
;
; Exercises state, actions, and CSS. No list, no form, no payload.

(defun initial-state ()
  0)

(defun update (state action)
  (let ((op (action-op action)))
    (cond
      ((= op "inc") (+ state 1))
      ((= op "dec") (- state 1))
      ((= op "reset") 0)
      (else state))))

(defun view (state)
  (el "div" (list (attr :class "app"))
    (list
      (el "main" (list (attr :class "stage"))
        (list
          (el "section" (list (attr :class "card"))
            (list
              (el "output" (list (attr :class "value"))
                (list (txt state)))
              (el "div" (list (attr :class "row"))
                (list
                  (el "button" (list (attr :class "btn") (attr :data-op "dec"))
                    (list (txt "−")))
                  (el "button" (list (attr :class "btn ghost") (attr :data-op "reset"))
                    (list (txt "Reset")))
                  (el "button" (list (attr :class "btn primary") (attr :data-op "inc"))
                    (list (txt "+"))))))))))))

(defun styles ()
  (str
    (base-styles)
    ".value { display: block; font-family: var(--font-body); font-size: clamp(64px, 12vw, 128px); font-weight: 700; line-height: .9; letter-spacing: -.05em; font-variant-numeric: tabular-nums; }\n"))

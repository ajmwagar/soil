; SPDX-License-Identifier: MIT OR Apache-2.0
; A Soil port of the records-backed `mb` command.
;
; `soil:records` owns the book. Entity ids are `<type>/<json-key>` and bodies
; are the Marbles JSON state. Reads use the host's field query so a project
; answer does not copy every issue body into the interpreter.

(defun mb-spec ()
  (list
    (list :name "mb")
    (list :about "a small issue tracker for fleets of coding agents")
    (list :version "0.1.0")
    (list :options
      (list
        (list (list :long "json") (list :help "Machine-readable output."))
        (list (list :long "project") (list :value "slug")
              (list :help "Scope a query to one project."))))
    (list :args nil)
    (list :commands
      (list
        (list
          (list :name "list")
          (list :about "List issues, excluding closed work by default.")
          (list :options
            (list
              (list (list :long "all") (list :help "Include closed issues."))
              (list (list :long "id") (list :value "id") (list :help "Only this issue."))
              (list (list :long "limit") (list :value "n") (list :help "Truncate the answer."))))
          (list :args nil)
          (list :commands nil))
        (list
          (list :name "ready")
          (list :about "Open, unblocked, unclaimed, past grace.")
          (list :options nil)
          (list :args nil)
          (list :commands nil))
        (list
          (list :name "show")
          (list :about "Show one issue as a one-element array.")
          (list :options nil)
          (list :args
            (list
              (list (list :name "id") (list :required #t) (list :help "Issue id."))))
          (list :commands nil))))))

(defun mb-fail (message)
  (eprintln (str "mb: " message))
  (exit 1))

(defun entry-body (entry)
  (json-decode (bytes->string (field entry :body))))

(defun entry-id (entry)
  (field (field entry :key) :id))

(defun entry-type? (entry prefix)
  (string-contains? (entry-id entry) prefix))

(defun query-entries (field value)
  (let ((result (soil:records/scan-query "" field value nil 4096)))
    (if (ok? result)
        (let ((entries (field (value result) :entries)))
          (if (or (nil? entries) (= 0 (length entries))) nil entries))
        (mb-fail (str "records query failed: " (field result :err))))))

(defun issue-entries (field value)
  (filter-with 'entry-type? "issue/" (query-entries field value)))

(defun issue-bodies (field value)
  (map 'entry-body (issue-entries field value)))

(defun dependency-bodies (field value)
  (map 'entry-body (filter-with 'entry-type? "dependency/" (query-entries field value))))

(defun find-body (id issues)
  (cond
    ((nil? issues) nil)
    ((= (field (first issues) :id) id) (first issues))
    (else (find-body id (rest issues)))))

(defun issue-closed? (issue)
  (= (field issue :status) "closed"))

(defun parent-open? (parent)
  (let ((issue (find-body parent (issue-bodies "id" parent))))
    (and (not (nil? issue)) (not (issue-closed? issue)))))

(defun child-open? (child)
  (parent-open? child))

(defun dependency-count (id)
  (let ((edges (dependency-bodies "child" id)))
    (if (nil? edges)
        0
        (let ((open (filter 'parent-open-edge? edges)))
          (if (nil? open) 0 (length open))))))

(defun parent-open-edge? (edge)
  (parent-open? (field edge :parent)))

(defun dependent-count (id)
  (let ((edges (dependency-bodies "parent" id)))
    (if (nil? edges)
        0
        (let ((open (filter 'child-open-edge? edges)))
          (if (nil? open) 0 (length open))))))

(defun child-open-edge? (edge)
  (child-open? (field edge :child)))

(defun record-set (record key value)
  (cond
    ((nil? record) (list (list key value)))
    ((= (first (first record)) key)
      (cons (list key value) (rest record)))
    (else
      (cons (first record) (record-set (rest record) key value)))))

(defun issue-with-counts (issue)
  (let ((id (field issue :id)))
    (record-set
      (record-set issue :dependency_count (dependency-count id))
      :dependent_count (dependent-count id))))

(defun issues-with-counts (issues)
  (map 'issue-with-counts issues))

(defun project-filter (result)
  (let ((project (cli-result-option result "project")))
    (if (nil? project) (getenv "MARBLES_PROJECT") project)))

(defun require-project (result)
  (let ((project (project-filter result)))
    (if (nil? project)
        (mb-fail "a project is required (use --project or MARBLES_PROJECT)")
        project)))

(defun limit-option (result)
  (let ((limit (cli-result-option result "limit")))
    (if (nil? limit) 0 (json-decode limit))))

(defun truncate (limit issues)
  (if (or (<= limit 0) (nil? issues))
      issues
      (take limit issues)))

(defun issue-in-project? (issue project)
  (= (field issue :project) project))

(defun open-issue? (issue)
  (not (issue-closed? issue)))

(defun issue-id-option? (issue id)
  (or (nil? id) (= (field issue :id) id)))

(defun mb-list (result)
  (let ((project (require-project result)))
    (let ((id (cli-result-option result "id"))
          (all (cli-result-option result "all")))
      (let ((issues (filter-with 'issue-in-project? project (issue-bodies "project" project))))
        (let ((visible (filter-with 'issue-id-option? id issues)))
          (let ((visible (if all visible (filter 'open-issue? visible))))
            (truncate (limit-option result) (issues-with-counts visible))))))))

(defun issue-available? (issue now)
  (let ((available (field issue :available_at)))
    (or (nil? available) (<= available now))))

(defun issue-claimed? (issue now)
  (let ((assignee (field issue :assignee))
        (expires (field issue :expires_at)))
    (and (not (nil? assignee))
         (or (nil? expires) (> expires now)))))

(defun ready-issue? (issue context)
  (let ((now (first context)))
    (and
      (= (field issue :status) "open")
      (= (dependency-count (field issue :id)) 0)
      (issue-available? issue now)
      (not (issue-claimed? issue now)))))

(defun mb-ready (result)
  (let ((project (require-project result)))
    (let ((issues (filter-with 'issue-in-project? project (issue-bodies "project" project))))
      (let ((now (/ (now-ms) 1000)))
        (issues-with-counts
          (filter-with 'ready-issue? (list now) issues))))))

(defun mb-show (result)
  (let ((id (first (cli-result-args result))))
    (let ((issues (issue-bodies "id" id)))
      (let ((issue (find-body id issues)))
        (if (nil? issue)
            (mb-fail (str "issue not found: " id))
            (list (issue-with-counts issue)))))))

(defun mb-dispatch (result)
  (let ((name (field result :name)))
    (cond
      ((= name "list") (println (json-encode (mb-list result))))
      ((= name "ready") (println (json-encode (mb-ready result))))
      ((= name "show") (println (json-encode (mb-show result))))
      (else (mb-fail (str "unsupported command: " name))))))

(defun main ()
  (let ((parsed (cli-parse-argv (mb-spec) (cli-args))))
    (if (cli-ok? parsed)
        (mb-dispatch (field parsed :ok))
        (mb-fail (field parsed :error)))))

; SPDX-License-Identifier: MIT OR Apache-2.0
; Live example: publish one event, then read the page the bus returns.
;
; Run it with --unibus-config and a live hub. A one-shot poll sees only frames
; available now; a worker uses --repeat 0 --interval-ms N and a stored cursor.

(defun main ()
  (let ((subscription (events/subscribe (list "demo.event.v1") 8)))
    (if (ok? subscription)
        (begin
          (println
            (str "publish: "
                 (events/publish "demo.event.v1"
                   (list (list :id "demo-1")
                         (list :message "hello from Soil"))
                   nil 0)))
          (println
            (str "next: "
                 (events/next (value subscription)))))
        (println (value subscription)))))

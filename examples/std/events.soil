; A host-free tour of the Unibus event vocabulary.

(defun main ()
  (let ((subscription (events/subscribe (list "demo.event.v1") 8)))
    (println (str "subscription: " (json-encode (value subscription))))
    (println (str "body: "
                  (value (events/encode-body
                           (list (list :id "demo-1")
                                 (list :message "hello from Soil"))))))))

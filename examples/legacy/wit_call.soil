; SPDX-License-Identifier: MIT OR Apache-2.0
; Call a WASI clock and soil:records from Soil.
; Run with:
;   soil-lang --prelude core/prelude.soil \
;     --records-root /tmp/r --book soil \
;     std/wasi/time.soil std/bindings/wasi-clocks.generated.soil std/bindings/soil-records.soil \
;     examples/legacy/wit_call.soil

(defun main ()
  (let ((now (now-ms)))
      (let ((entry (make-entry
                     "demo:wit"
                     "hello"
                     "demo.wit.v1"
                     (list (list :message "called from Soil")
                           (list :unix_ms now))
                     now)))
        (let ((write (soil:records/upsert entry)))
          (let ((read (soil:records/get (record-key "demo:wit" "hello"))))
            (list (list :time now)
                  (list :write-ok (ok? write))
                  (list :read (entry-body (value read)))))))))

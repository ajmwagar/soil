; SPDX-License-Identifier: MIT OR Apache-2.0
; Canonical ABI import: soil:records/query with a typed query-spec.
;
; query-spec flattens to 12 core values, in declaration order:
;
;   collection  (ptr, len)
;   prefix      (ptr, len)
;   filters     (ptr, count)
;   fields      (ptr, count)
;   cursor      (disc, ptr, len)      -> none = (0, 0, 0)
;   limit       (u32)
;
; filter = { field, op, value } = three strings = 6 i32, 4-byte aligned.
;
; Memory map (all offsets absolute, 4-byte aligned):
;
;   1024  "issue/"                      collection
;   1040  ""                            prefix (len 0)
;   1056  "project"                     filter.field
;   1072  "eq"                          filter.op
;   1088  "mycelium"                    filter.value
;   1280  filter element (6 x i32)      -> 1056/7, 1072/2, 1088/8
;   1536  fields element (2 x i32)      -> 1792/5
;   1792  "title"

(import "cm32p2|test:records-query/records@0.1" "query" records-query
  (i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32) i32)

(defun-i32 run ()
  (begin
    ; collection: "issue/"
    (i32.store8 (i32.const 1024) (i32.const 105))
    (i32.store8 (i32.const 1025) (i32.const 115))
    (i32.store8 (i32.const 1026) (i32.const 115))
    (i32.store8 (i32.const 1027) (i32.const 117))
    (i32.store8 (i32.const 1028) (i32.const 101))
    (i32.store8 (i32.const 1029) (i32.const 47))

    ; filter.field: "project"
    (i32.store8 (i32.const 1056) (i32.const 112))
    (i32.store8 (i32.const 1057) (i32.const 114))
    (i32.store8 (i32.const 1058) (i32.const 111))
    (i32.store8 (i32.const 1059) (i32.const 106))
    (i32.store8 (i32.const 1060) (i32.const 101))
    (i32.store8 (i32.const 1061) (i32.const 99))
    (i32.store8 (i32.const 1062) (i32.const 116))

    ; filter.op: "eq"
    (i32.store8 (i32.const 1072) (i32.const 101))
    (i32.store8 (i32.const 1073) (i32.const 113))

    ; filter.value: "mycelium"
    (i32.store8 (i32.const 1088) (i32.const 109))
    (i32.store8 (i32.const 1089) (i32.const 121))
    (i32.store8 (i32.const 1090) (i32.const 99))
    (i32.store8 (i32.const 1091) (i32.const 101))
    (i32.store8 (i32.const 1092) (i32.const 108))
    (i32.store8 (i32.const 1093) (i32.const 105))
    (i32.store8 (i32.const 1094) (i32.const 117))
    (i32.store8 (i32.const 1095) (i32.const 109))

    ; fields[0]: "title"
    (i32.store8 (i32.const 1792) (i32.const 116))
    (i32.store8 (i32.const 1793) (i32.const 105))
    (i32.store8 (i32.const 1794) (i32.const 116))
    (i32.store8 (i32.const 1795) (i32.const 108))
    (i32.store8 (i32.const 1796) (i32.const 101))

    ; filter element: field ptr/len, op ptr/len, value ptr/len
    (i32.store (i32.const 1280) (i32.const 1056))
    (i32.store (i32.const 1284) (i32.const 7))
    (i32.store (i32.const 1288) (i32.const 1072))
    (i32.store (i32.const 1292) (i32.const 2))
    (i32.store (i32.const 1296) (i32.const 1088))
    (i32.store (i32.const 1300) (i32.const 8))

    ; fields element: title ptr/len
    (i32.store (i32.const 1536) (i32.const 1792))
    (i32.store (i32.const 1540) (i32.const 5))

    ; the call
    (records-query
      (i32.const 1024) (i32.const 6)   ; collection "issue/"
      (i32.const 1040) (i32.const 0)   ; prefix ""
      (i32.const 1280) (i32.const 1)   ; filters: 1 element
      (i32.const 1536) (i32.const 1)   ; fields: "title"
      (i32.const 0) (i32.const 0) (i32.const 0)  ; cursor: none
      (i32.const 32))))                ; limit

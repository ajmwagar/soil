; UTC date, time, parsing, and relative labels.

(defun test/date-epoch ()
  (and
    (= (date/date 0) "1970-01-01")
    (= (date/time 0) "00:00:00")
    (= (date/format 0) "1970-01-01 00:00:00 UTC")
    (= (date/iso 0) "1970-01-01T00:00:00Z")))

(defun test/date-known-instant ()
  (and
    (= (date/date 1700000000000) "2023-11-14")
    (= (date/time 1700000000000) "22:13:20")
    (= (date/start-of-day 1700000000000) 1699920000000)
    (= (date/add-days 0 1) 86400000)))

(defun test/date-parse ()
  (and
    (= (value (date/parse-date "1970-01-01")) 0)
    (= (value (date/parse-date "2023-11-14")) 1699920000000)
    (not (ok? (date/parse-date "2023-02-30")))
    (not (ok? (date/parse-date "2023-1-1")))
    (not (ok? (date/parse-date "2023-13-01")))))

(defun test/date-leap-year ()
  (and
    (date/leap? 2024)
    (not (date/leap? 2023))
    (date/leap? 2000)
    (not (date/leap? 1900))
    (= (date/days-in-month 2024 2) 29)
    (= (date/days-in-month 2023 2) 28)))

(defun test/date-weekday ()
  (and
    (= (date/weekday 0) 4)
    (= (date/weekday-name 0) "Thursday")
    (= (date/weekday 86400000) 5)))

(defun test/date-relative ()
  (and
    (= (date/relative 1700000000000 1699999999000) "just now")
    (= (date/relative 1700000000000 1699999940000) "1m ago")
    (= (date/relative 1700000000000 1700000060000) "in 1m")
    (= (date/relative 1700000000000 1699990000000) "2h ago")
    (= (date/relative 1700000000000 1699900000000) "1d ago")
    (= (date/relative 1700000000000 1690000000000) "2023-07-22")))

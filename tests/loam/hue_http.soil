; Hue requests, asserted against the harness' deterministic HTTP echo.

(defun test/hue-lights-request ()
  (let ((result (hue/lights (hue/bridge "http://bridge.local/" "default"))))
    (and
      (ok? result)
      (= (field (value result) :url)
         "http://bridge.local/api/__CREDENTIAL__/lights")
      (= (field (value result) :method) "get"))))

(defun test/hue-light-put-request ()
  (let ((result (hue/on (hue/bridge "http://bridge.local" "default") (hue/light "3"))))
    (and
      (ok? result)
      (= (field (value result) :url)
         "http://bridge.local/api/__CREDENTIAL__/lights/3/state")
      (= (field (value result) :method) "put")
      (= (field (value result) :body) "{\"on\":true}"))))

(defun test/hue-load-light-keeps-the-id ()
  (let ((result (hue/load-light "3" (hue/bridge "http://bridge.local" "default"))))
    (and
      (ok? result)
      (= (field (value result) :id) "3")
      (= (field (value result) :url)
         "http://bridge.local/api/__CREDENTIAL__/lights/3"))))

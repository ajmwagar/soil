; Unibus event subscription, body, and dedupe helpers.

(defun test/events-subscribe ()
  (let ((ok (events/subscribe (list "test.one.v1" "test.two.v1") 32))
        (bad (events/subscribe nil 32))
        (empty (events/subscribe (list) 32))
        (limit (events/subscribe (list "test.one.v1") 0)))
    (and
      (ok? ok)
      (= (field (value ok) :limit) 32)
      (not (ok? bad))
      (not (ok? empty))
      (not (ok? limit)))))

(defun test/events-encode-body ()
  (let ((object (events/encode-body (list (list :id "a"))))
        (array (events/encode-body (list 1 2))))
    (and
      (ok? object)
      (= (value object) "{\"id\":\"a\"}")
      (not (ok? array)))))

(defun test/events-decode-frame ()
  (let ((frame
          (list
            (list :kind "test.one.v1")
            (list :producer "test")
            (list :issued-at-ms 12)
            (list :body (string->bytes "{\"id\":\"a\"}")))))
    (let ((event (events/decode-frame frame)))
      (and
        (= (field event :kind) "test.one.v1")
        (= (field (field event :body) :id) "a")
        (= (field event :issued-at-ms) 12)))))

(defun test/events-unique ()
  (let ((events
          (list
            (list (list :body (list (list :id "a"))))
            (list (list :body (list (list :id "a"))))
            (list (list :body (list (list :id "b"))))
            (list (list :body (list (list :other "c")))))))
    (and
      (= (length (events/unique events :id)) 3)
      (= (field (field (first (events/unique events :id)) :body) :id) "a"))))

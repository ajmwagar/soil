; JSON object helpers.

(defun test/json-object-and-array ()
  (and
    (json/object? (json-decode "{}"))
    (json/object? (json-decode "{\"a\":1}"))
    (json/array? (json-decode "[1,2]"))
    (not (json/object? (json-decode "[1,2]")))))

(defun test/json-keys-and-values ()
  (let ((value (json-decode "{\"a\":1,\"b\":2}")))
    (and
      (= (first (json/keys value)) :a)
      (= (nth 1 (json/keys value)) :b)
      (= (first (json/values value)) 1)
      (= (nth 1 (json/values value)) 2))))

(defun test/json-has-and-delete ()
  (let ((value (list (list :a nil) (list :b 2))))
    (let ((without-a (json/delete value :a))
          (without-b (json/delete value :b)))
      (and
        (json/has-key? value :a)
        (not (json/has-key? value :c))
        (not (json/has-key? without-a :a))
        (json/has-key? without-a :b)
        (json/has-key? without-b :a)
        (not (json/has-key? without-b :b))))))

(defun test/json-set-in ()
  (let ((value (json/set-in (json-decode "{\"a\":{\"b\":1}}")
                            (list :a :b) 2)))
    (= (field (field value :a) :b) 2)))

(defun test/json-deep-merge ()
  (let ((value (json/deep-merge
                 (json-decode "{\"a\":{\"b\":1,\"c\":2},\"keep\":true}")
                 (json-decode "{\"a\":{\"b\":3},\"new\":4}"))))
    (and
      (= (field (field value :a) :b) 3)
      (= (field (field value :a) :c) 2)
      (= (field value :keep) #t)
      (= (field value :new) 4))))

(defun test/json-pretty ()
  (let ((text (json/pretty (json-decode "{\"a\":1,\"b\":[2]}"))))
    (and
      (string-contains? text "\n")
      (string-contains? text "\"a\": 1")
      (string-contains? text "[\n"))))

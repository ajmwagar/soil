; Component canonical-ABI probe: read the first argv string's length.
(import "cm32p2|wasi:cli/environment@0.2" "get-arguments" "get-arguments" (i32) unit)

(defun run ()
  (begin
    (void-call (get-arguments (i32.const 16)))
    (i64.extend_i32_u
      (i32.load
        (i32.add (i32.load (i32.const 16)) (i32.const 4))))))

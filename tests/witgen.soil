; WIT JSON -> Soil generator tests.

(defun witgen/sample ()
  "{\"packages\":[{\"name\":\"test:io@0.1.0\",\"interfaces\":{\"streams\":0}}],\"interfaces\":[{\"name\":\"streams\",\"package\":0,\"types\":{\"input-stream\":0},\"functions\":{\"[method]input-stream.read\":{\"name\":\"[method]input-stream.read\",\"kind\":{\"method\":0},\"params\":[{\"name\":\"self\",\"type\":1},{\"name\":\"len\",\"type\":\"u64\"}],\"result\":2}}}],\"types\":[{\"name\":\"input-stream\",\"kind\":\"resource\",\"owner\":{\"interface\":0}},{\"name\":null,\"kind\":{\"handle\":{\"borrow\":0}},\"owner\":null},{\"name\":null,\"kind\":{\"result\":{\"ok\":{\"list\":\"u8\"},\"err\":null}},\"owner\":null}],\"worlds\":[]}")

(defun test/witgen-generated-marker ()
  (string-contains? (wit/generate (json-decode (witgen/sample)) nil)
    "@generated by tools/witgen/main.soil"))

(defun test/witgen-resource ()
  (let ((out (wit/generate (json-decode (witgen/sample)) nil)))
    (and
      (string-contains? out "(define-resource test:io/streams.input-stream)")
      (string-contains? out "(host-call \"test:io/streams\" \"input-stream.read\""))))

(defun test/witgen-package ()
  (string-contains? (wit/generate (json-decode (witgen/sample)) "test:io@0.1.0")
    "(define-package \"test:io@0.1.0\""))

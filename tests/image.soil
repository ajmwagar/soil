; Core image protocol tests.

(defun test/image-ping ()
  (let ((response (image/handle-json "{\"op\":\"ping\"}" nil)))
    (and
      (= (field response :ok) #t)
      (= (field (field response :result) :pong) #t))))

(defun test/image-eval-host-action ()
  (let ((response
          (image/handle-json
            "{\"op\":\"eval\",\"session\":\"s1\",\"source\":\"(+ 20 22)\"}"
            nil)))
    (and
      (= (field response :action) :host)
      (= (field response :op) "eval"))))

(defun test/image-host-action ()
  (let ((response (image/handle-json "{\"op\":\"flush\",\"session\":\"s1\"}" nil)))
    (and
      (= (field response :action) :host)
      (= (field response :op) "flush"))))

(defun test/image-snapshot-host-action ()
  (let ((response (image/handle-json "{\"op\":\"snapshot\",\"session\":\"s1\",\"path\":\"x.json\"}" nil)))
    (and (= (field response :action) :host)
         (= (field response :op) "snapshot"))))

(defun test/image-restore-host-action ()
  (let ((response (image/handle-json "{\"op\":\"restore\",\"session\":\"s1\",\"path\":\"x.json\"}" nil)))
    (and (= (field response :action) :host)
         (= (field response :op) "restore"))))

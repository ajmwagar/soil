; SPDX-License-Identifier: MIT OR Apache-2.0
; The numeric-core compiler written in Soil emits WAT.

(defun test/selfhost-add ()
  (let ((wat (compiler/compile-source "(defun add (a b) (+ a b))")))
    (and
      (string-contains? wat "(func $add")
      (string-contains? wat "(export \"add\")")
      (string-contains? wat "(param $a i64)")
      (string-contains? wat "i64.add"))))

(defun test/selfhost-if ()
  (let ((wat (compiler/compile-source "(defun less (a b) (if (< a b) 1 0))")))
    (and
      (string-contains? wat "i64.lt_s")
      (string-contains? wat "if (result i64)")
      (string-contains? wat "else"))))

(defun test/selfhost-call ()
  (let ((wat (compiler/compile-source "(defun twice (x) (+ x x)) (defun four () (twice (twice 1)))")))
    (and
      (string-contains? wat "(func $twice")
      (string-contains? wat "call $twice"))))

(defun test/selfhost-macro ()
  (let ((wat
          (compiler/compile-source
            "(defmacro unless (c a b) `(if (not ,c) ,a ,b))
             (defun choose (x) (unless (= x 0) 10 20))")))
    (and
      (string-contains? wat "if (result i64)")
      (not (string-contains? wat "unless")))))

(defun test/selfhost-wit-export ()
  (let ((wit
          (compiler/wit
            "(package \"acme:counter@0.1.0\")
             (world \"counter\")
             (defun add (a b) (+ a b))
             (export add (a s32) (b s32) -> s32)")))
    (and
      (string-contains? wit "package acme:counter@0.1.0;")
      (string-contains? wit "world counter {")
      (string-contains? wit "export add: func(a: s32, b: s32) -> s32;"))))

(defun test/selfhost-wit-types ()
  (let ((wit
          (compiler/wit
            "(package \"acme:list@0.1.0\")
             (world \"list\")
             (export search
               (query string)
               (limit u32)
               -> (list string))")))
    (and
      (string-contains? wit "export search: func(query: string, limit: u32) -> list<string>;"))))

(defpackage "acme/one" (:export "shared" "public"))
(defpackage "acme/two" (:export "shared"))
(in-package "acme/one")
(defun shared (x) (+ x 1))
(defun public (x) (shared x))
(defun private (x) (+ x 2))
(in-package "acme/two")
(defun shared (x) (+ x 10))
(defpackage "acme/base" (:export "used"))
(in-package "acme/base")
(defun used (x) (+ x 100))
(defpackage "acme/app" (:use "acme/base") (:export "go"))
(in-package "acme/app")
(defun go () (used 1))
(defpackage "acme/a" (:export "same"))
(defpackage "acme/b" (:export "same"))
(defpackage "acme/c" (:use "acme/a" "acme/b") (:export "amb"))
(in-package "acme/a")
(defun same (x) x)
(in-package "acme/b")
(defun same (x) x)
(in-package "acme/c")
(defun amb () (try-eval (same 1)))
(defpackage "acme/const" (:export "answer"))
(in-package "acme/const")
(defconst answer 42)
(in-package "soil-user")

(defun test/package-qualified ()
  (and
    (= (acme/one:shared 1) 2)
    (= (acme/two:shared 1) 11)
    (= (acme/one:public 1) 2)))

(defun test/package-private ()
  (let ((result (try-eval (acme/one:private 1))))
    (and
      (err? result)
      (string-contains? (field (value result) :message) "private"))))

(defun test/package-use ()
  (= (acme/app:go) 101))

(defun test/package-collision ()
  (let ((result (acme/c:amb)))
    (and
      (err? result)
      (string-contains? (field (value result) :message) "ambiguous"))))

(defun test/package-const ()
  (= acme/const:answer 42))

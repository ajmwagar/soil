// Canonical ABI probe: a host call with strings, lists, records and an option
// cursor as parameters.
//
// The shape mirrors soil:records/query, whose spec is
//   record query-spec {
//     collection: string,
//     prefix: string,
//     filters: list<filter>,
//     fields: list<string>,
//     cursor: option<string>,
//     limit: u32,
//   }
// with filter = { field: string, op: string, value: string }.
//
// The result is the real soil:records page: an indirect return area containing
// result<page, error>, where page = list<entry> + option<string> next.
package test:records-query@0.1.0;

interface records {
  record filter {
    field: string,
    op: string,
    value: string,
  }

  record query-spec {
    collection: string,
    prefix: string,
    filters: list<filter>,
    fields: list<string>,
    cursor: option<string>,
    limit: u32,
  }

  enum error {
    denied,
    not-found,
    over-budget,
    invalid,
    stale,
    io,
    unsupported,
  }

  record key {
    collection: string,
    id: string,
  }

  record entry {
    key: key,
    schema: string,
    revision: u64,
    updated-at-ms: u64,
    origin: string,
    deleted: bool,
    body: list<u8>,
  }

  record page {
    entries: list<entry>,
    next: option<string>,
  }

  query: func(spec: query-spec) -> result<page, error>;
}

world probe {
  import records;
}

; Count environment entries through wasi:cli/environment.
(import "cm32p2|wasi:cli/environment@0.2" "get-environment" "get-environment" (i32) unit)

(defun run ()
  (begin
    (get-environment (i32.const 16))
    (i64.extend_i32_u (i32.load (i32.const 20)))))

; SPDX-License-Identifier: MIT OR Apache-2.0
; Small performance helpers for the REPL and scripts.
;
; The evaluator exposes `(runtime-stats)` and `(runtime-reset)`; these helpers
; add wall-clock measurements around one call, a repeated benchmark, and a
; quoted-form evaluator. They deliberately return data, not print, so a caller
; can assert or render the result.

(defun perf/now ()
  (monotonic-ms))

(defun perf/elapsed-ms (start)
  (- (perf/now) start))

(defun perf/measure (name f args)
  (let ((start (perf/now)))
    (let ((result (apply f args)))
      (list (list :name name)
            (list :ms (perf/elapsed-ms start))
            (list :value result)))))

(defun perf/bench-loop (f args runs n total min max)
  (if (>= n runs)
      (list (list :runs runs)
            (list :total_ms total)
            (list :min_ms min)
            (list :max_ms max)
            (list :mean_ms (if (= runs 0) 0 (/ total runs))))
      (let ((start (perf/now)))
        (apply f args)
        (let ((ms (perf/elapsed-ms start)))
          (perf/bench-loop f args runs (+ n 1) (+ total ms)
            (if (or (nil? min) (< ms min)) ms min)
            (if (or (nil? max) (> ms max)) ms max))))))

(defun perf/bench (f args runs)
  (perf/bench-loop f args runs 0 0 nil nil))

(defun perf/eval (source)
  (let ((forms (read source)))
    (if (nil? forms)
        nil
        (let ((start (perf/now)))
          (let ((result (eval (first forms))))
            (list (list :ms (perf/elapsed-ms start))
                  (list :value result)
                  (list :stats (runtime-stats))))))))

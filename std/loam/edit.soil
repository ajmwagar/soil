; SPDX-License-Identifier: MIT OR Apache-2.0
; Soil interface over host-owned edit sessions.
;
; The host owns the base package, scoped workdir, build, signing, and patch
; storage. This module only shapes commands and decodes JSON responses.
;
; The first adapter is `session/exec` -> `loam edit ... --json`. A later WIT
; adapter can implement the same functions without changing callers.

(defun edit/quote (value)
  (str "'" (string-replace (str value) "'" "'\\''") "'"))

(defun edit/shell-join (command)
  (if (nil? command)
      ""
      (str (edit/quote (first command))
           (if (nil? (rest command)) "" (str " " (edit/shell-join (rest command)))))))

(defun edit/command (op args)
  (append (list "loam" "edit" op) (append args (list "--json"))))

(defun edit/exec-command (command)
  (host-call "session" "exec"
    (list (edit/shell-join command) nil 30000)))

(defun edit/stdout (result)
  (let ((value (value result)))
    (let ((stream (field value :stdout)))
      (if (nil? stream) "" stream))))

(defun edit/decode (result)
  (if (not (ok? result))
      result
      (if (= (field (value result) :status) 0)
          (let ((value (json-decode (edit/stdout result))))
            (if (= (field value :ok) #f)
                (list 'err (field value :error))
                value))
          (list 'err (edit/stdout result)))))

(defun edit/session-id (session)
  (let ((id (field session :session)))
    (if (nil? id) session id)))

(defun edit/call-with (exec op args)
  (edit/decode (apply exec (list (edit/command op args)))))

(defun edit/call (op args)
  (edit/call-with (quote edit/exec-command) op args))

(defun edit/open-with (exec spore-id)
  (edit/call-with exec "open" (list spore-id)))

(defun edit/open (spore-id)
  (edit/open-with (quote edit/exec-command) spore-id))

(defun edit/read-with (exec session path)
  (edit/call-with exec "read" (list (edit/session-id session) path)))

(defun edit/read (session path)
  (edit/read-with (quote edit/exec-command) session path))

(defun edit/list-with (exec session)
  (edit/call-with exec "list" (list (edit/session-id session))))

(defun edit/list (session)
  (edit/list-with (quote edit/exec-command) session))

(defun edit/paths-with (exec session)
  (map (lambda (file) (field file :path))
    (or-empty (field (edit/list-with exec session) :files))))

(defun edit/paths (session)
  (edit/paths-with (quote edit/exec-command) session))

(defun edit/checkpoint-with (exec session message)
  (edit/call-with exec "checkpoint" (list (edit/session-id session) message)))

(defun edit/checkpoint (session message)
  (edit/checkpoint-with (quote edit/exec-command) session message))

(defun edit/build-with (exec session)
  (edit/call-with exec "build" (list (edit/session-id session))))

(defun edit/build (session)
  (edit/build-with (quote edit/exec-command) session))

(defun edit/save-with (exec session message)
  (edit/call-with exec "save" (list (edit/session-id session) message)))

(defun edit/save (session message)
  (edit/save-with (quote edit/exec-command) session message))

(defun edit/apply-with (exec session)
  (edit/call-with exec "apply" (list (edit/session-id session))))

(defun edit/apply (session)
  (edit/apply-with (quote edit/exec-command) session))

(defun edit/discard-with (exec session)
  (edit/call-with exec "discard" (list (edit/session-id session))))

(defun edit/discard (session)
  (edit/discard-with (quote edit/exec-command) session))

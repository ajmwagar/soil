; Edit-session LSP adapter.
;
; The LSP reads the edit session work directory through soil:vfs. It does not
; run `loam edit read` and it does not need process execution.

(defun edit/lsp-read-text (path)
  (vfs/read-text path))

(defun edit/lsp-doc-with (reader path)
  (workspace/doc-with reader path))

(defun edit/lsp-doc (path)
  (workspace/doc path))

(defun edit/lsp-diagnostics (text)
  (lsp/diagnostics-text text))

(defun edit/lsp-symbols (text)
  (lsp/symbols-text text))

(defun edit/lsp-definition (docs name)
  (lsp/definition-in-docs name docs))

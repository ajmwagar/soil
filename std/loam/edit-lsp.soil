; Edit-session adapter for the LSP analyzer.

(defun edit/read-text (session path)
  (let ((result (edit/read session path)))
    (field result :text)))

(defun edit/lsp-reader (session)
  (lambda (path) (edit/read-text session path)))

(defun edit/lsp-doc (session path)
  (let ((text (edit/read-text session path)))
    (if (nil? text)
        nil
        (let ((parsed (lsp/parse-doc text)))
          (if (ok? parsed)
              (list
                (list :uri (workspace/uri path))
                (list :text text)
                (list :parsed (value parsed)))
              nil)))))

(defun edit/lsp-diagnostics (text)
  (lsp/diagnostics-text text))

(defun edit/lsp-symbols (text)
  (lsp/symbols-text text))

(defun edit/lsp-definition (docs name)
  (lsp/definition-in-docs name docs))

(define-package "wasi:cli@0.2.4" :base "wasi:cli" :version "0.2.4")

(define-capability wasi:cli/environment.get-environment
  :interface "wasi:cli"
  :function "get-environment"
  :grant "wasi:cli"
  :version "0.2.4"
  :params ()
  :result (list (tuple string string)))

(defun wasi:cli/environment.get-environment ()
  (host-call "wasi:cli" "get-environment" nil))

(define-capability wasi:cli/environment.get-arguments
  :interface "wasi:cli"
  :function "get-arguments"
  :grant "wasi:cli"
  :version "0.2.4"
  :params ()
  :result (list string))

(defun wasi:cli/environment.get-arguments ()
  (host-call "wasi:cli" "get-arguments" nil))

(define-capability wasi:cli/environment.initial-cwd
  :interface "wasi:cli"
  :function "initial-cwd"
  :grant "wasi:cli"
  :version "0.2.4"
  :params ()
  :result (option string))

(defun wasi:cli/environment.initial-cwd ()
  (host-call "wasi:cli" "initial-cwd" nil))

(define-capability wasi:cli/exit.exit
  :interface "wasi:cli"
  :function "exit"
  :grant "wasi:cli"
  :version "0.2.4"
  :params ((status (result unit unit)))
  :result unit)

(defun wasi:cli/exit.exit (status)
  (host-call "wasi:cli" "exit" (list status)))

(define-capability wasi:cli/exit.exit-with-code
  :interface "wasi:cli"
  :function "exit-with-code"
  :grant "wasi:cli"
  :version "0.2.4"
  :params ((status-code u8))
  :result unit)

(defun wasi:cli/exit.exit-with-code (status-code)
  (host-call "wasi:cli" "exit-with-code" (list status-code)))

(define-capability wasi:cli/run.run
  :interface "wasi:cli"
  :function "run"
  :grant "wasi:cli"
  :version "0.2.4"
  :params ()
  :result (result unit unit))

(defun wasi:cli/run.run ()
  (host-call "wasi:cli" "run" nil))


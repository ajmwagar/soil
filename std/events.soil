; SPDX-License-Identifier: MIT OR Apache-2.0
; Unibus event helpers: local subscriptions, bounded polling, typed publishing.
;
; Unibus registration is host-owned: the host connects, authenticates, selects
; a hub, and decides which kinds a Spore may publish. `events/subscribe` is the
; observer's local declaration of the kinds it wants and the cursor it has
; reached. There is no second registration store in the program.
;
; Bodies are JSON objects. `events/publish` checks that locally so a caller gets
; a useful error before the host rejects the frame, and `events/next` decodes
; each frame body back into the same record shape `json-decode` uses.

;;; True when `kind` is a non-empty event kind.
(defun events/kind? (kind)
  (and (not (nil? kind))
       (> (length (string-chars (str kind))) 0)))

;;; Create a local subscription for `kinds`. `limit` is clamped to the host's
;;; 1..256 page size; `nil` means the default 64.
(defun events/subscribe (kinds limit)
  (let ((limit (if (nil? limit) 64 (int limit))))
    (cond
      ((or (nil? kinds) (= (length kinds) 0))
        (list 'err "events: at least one kind is required"))
      ((not (all? 'events/kind? kinds))
        (list 'err "events: kinds must be non-empty strings"))
      ((or (< limit 1) (> limit 256))
        (list 'err "events: limit must be between 1 and 256"))
      (else
        (list 'ok
          (list
            (list :kinds kinds)
            (list :cursor nil)
            (list :limit limit)))))))

;;; Reset a subscription to the live tail.
(defun events/reset (subscription)
  (assoc :cursor nil subscription))

;;; Change the page size of a subscription.
(defun events/with-limit (subscription limit)
  (assoc :limit (int limit) subscription))

(defun events/atom-or-bytes (body)
  (if (atom body)
      body
      (string-from-bytes body)))

;;; Decode one host frame into `(:kind :producer :issued-at-ms :body)`.
(defun events/decode-frame (frame)
  (list
    (list :kind (field frame :kind))
    (list :producer (field frame :producer))
    (list :issued-at-ms (field frame :issued-at-ms))
    (list :body (json-decode (events/atom-or-bytes (field frame :body))))))

;;; Encode a body and require it to be a JSON object. The host enforces the same
;;; rule; doing it here keeps the error local and testable.
(defun events/encode-body (body)
  (let ((text (json-encode body)))
    (let ((characters (string-chars text)))
      (if (and (not (nil? characters)) (= (first characters) "{"))
          (list 'ok text)
          (list 'err "events: body must be a JSON object")))))

;;; Poll the next page for a subscription. Returns
;;; `(ok (:events [...] :cursor next :subscription sub))` or the host error.
;;; The returned cursor is `nil` when the live tail has no next page.
(defun events/next (subscription)
  (let ((reply
          (soil:unibus/bus.poll
            (field subscription :kinds)
            (field subscription :cursor)
            (field subscription :limit))))
    (if (ok? reply)
        (let ((page (value reply)))
          (list 'ok
            (list
              (list :events
                (map 'events/decode-frame (field page :frames)))
              (list :cursor (field page :next))
              (list :subscription
                (assoc :cursor (field page :next) subscription)))))
        reply)))

;;; Alias for [[events/next]], named for the one-shot read.
(defun events/poll (subscription)
  (events/next subscription))

;;; Publish one JSON-object body. `destination` may be `nil`; `ttl-ms` 0 means
;;; the host default. Returns the host receipt or `(err ...)`.
(defun events/publish (kind body destination ttl-ms)
  (if (not (events/kind? kind))
      (list 'err "events: kind is required")
      (let ((encoded (events/encode-body body)))
        (if (ok? encoded)
            (soil:unibus/bus.publish kind (value encoded) destination ttl-ms)
            encoded))))

(defun events/member? (value values)
  (cond
    ((nil? values) #f)
    ((= value (first values)) #t)
    (else (events/member? value (rest values)))))

(defun events/event-key (event key)
  (field (field event :body) key))

(defun events/unique-loop (events key seen out)
  (if (nil? events)
      (reverse out)
      (let ((event (first events))
            (value (events/event-key (first events) key)))
        (cond
          ((nil? value)
            (events/unique-loop (rest events) key seen (cons event out)))
          ((events/member? value seen)
            (events/unique-loop (rest events) key seen out))
          (else
            (events/unique-loop
              (rest events) key (cons value seen) (cons event out)))))))

;;; Keep the first event for each value of `key` in its decoded body. Events
;;; whose body lacks `key` are kept, because there is nothing to compare.
(defun events/unique (events key)
  (events/unique-loop events key nil nil))

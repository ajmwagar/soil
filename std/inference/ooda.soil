; SPDX-License-Identifier: MIT OR Apache-2.0
; OODA / OpenAI-compatible non-streaming completions over soil:http.
;
; This is an adapter, not the soil:inference contract. The host owns the
; endpoint allowlist, credentials, redirects, budgets, and TLS.

(defun ooda/message (role content)
  (list (list :role role) (list :content content)))

(defun ooda/body (model system user max-tokens temperature)
  (let ((body
          (list
            (list :model model)
            (list :messages
              (list
                (ooda/message "system" system)
                (ooda/message "user" user))))))
    (let ((body (if (nil? max-tokens) body
                    (assoc :max_tokens max-tokens body))))
      (if (nil? temperature) body
          (assoc :temperature temperature body)))))

(defun ooda/headers ()
  (list
    (list :name "content-type")
    (list :value "application/json")))

(defun ooda/request (url model system user max-tokens temperature credential)
  (list
    (list :url url)
    (list :method 'post)
    (list :headers (list (ooda/headers)))
    (list :body (string->bytes
                  (json-encode (ooda/body model system user max-tokens temperature))))
    (list :credential credential)
    (list :max-bytes 4194304)
    (list :timeout-ms 120000)))

(defun ooda/error (message)
  (list 'err message))

(defun ooda/first-content (body)
  (let ((choices (field body :choices)))
    (if (nil? choices)
        nil
        (let ((message (field (first choices) :message)))
          (if (nil? message) nil (field message :content))))))

(defun ooda/complete-with (fetch url model system user max-tokens temperature credential)
  (let ((result (apply fetch (list (ooda/request url model system user max-tokens temperature credential)))))
    (if (not (ok? result))
        (ooda/error (str result))
        (let ((response (value result)))
          (if (not (= (field response :status) 200))
              (ooda/error (str "http status " (field response :status)))
              (let ((body (json-decode (bytes->string (field response :body)))))
                (let ((content (ooda/first-content body)))
                  (if (nil? content)
                      (ooda/error "completion returned no content")
                      (list 'ok content)))))))))

(defun ooda/complete (url model system user)
  (ooda/complete-with soil:http/fetch url model system user nil nil nil))

; ---------------------------------------------------------------------------
; Semantic soil:inference adapter
; ---------------------------------------------------------------------------

(defun ooda/encode-message (message)
  (list
    (list :role (str (field message :role)))
    (list :content (or (field message :content) ""))))

(defun ooda/body-messages (model messages max-tokens temperature)
  (let ((body
          (list
            (list :model model)
            (list :messages (map 'ooda/encode-message messages)))))
    (let ((body (if (nil? max-tokens) body
                    (assoc :max_tokens max-tokens body))))
      (if (nil? temperature) body
          (assoc :temperature temperature body)))))

(defun ooda/request-messages (url model messages max-tokens temperature credential)
  (list
    (list :url url)
    (list :method 'post)
    (list :headers (list (ooda/headers)))
    (list :body (string->bytes
                  (json-encode
                    (ooda/body-messages model messages max-tokens temperature))))
    (list :credential credential)
    (list :max-bytes 4194304)
    (list :timeout-ms 120000)))

(defun ooda/usage (usage)
  (if (nil? usage)
      nil
      (list
        (list :prompt-tokens (field usage :prompt_tokens))
        (list :completion-tokens (field usage :completion_tokens))
        (list :total-tokens (field usage :total_tokens)))))

(defun ooda/semantic-response (model body)
  (let ((choices (field body :choices)))
    (if (nil? choices)
        (ooda/error "completion returned no choices")
        (let ((choice (first choices)))
          (let ((message (field choice :message)))
            (if (nil? message)
                (ooda/error "completion choice has no message")
                (list 'ok
                  (list
                    (list :model (or (field body :model) model))
                    (list :message
                      (list
                        (list :role 'assistant)
                        (list :content (field message :content))
                        (list :name nil)))
                    (list :finish-reason (field choice :finish_reason))
                    (list :usage (ooda/usage (field body :usage)))))))))))

(defun ooda/complete-response-with (fetch url model messages max-tokens temperature credential)
  (let ((result
          (apply fetch
            (list (ooda/request-messages url model messages max-tokens temperature credential)))))
    (if (not (ok? result))
        (ooda/error (str result))
        (let ((response (value result)))
          (if (not (= (field response :status) 200))
              (ooda/error (str "http status " (field response :status)))
              (ooda/semantic-response model
                (json-decode (bytes->string (field response :body)))))))))

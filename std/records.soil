; SPDX-License-Identifier: MIT OR Apache-2.0
; Ergonomic read helpers over the low-level soil:records/query primitive.
;
; The host owns filtering, projection, cursors, and aggregation. These wrappers
; only build specs and unwrap pages; they never pull a whole store to emulate a
; query.

(defun records/filter (field op value)
  (list (list :field field) (list :op op) (list :value value)))

(defun records/spec (collection prefix filters fields cursor limit)
  (list
    (list :collection collection)
    (list :prefix prefix)
    (list :filters filters)
    (list :fields fields)
    (list :cursor cursor)
    (list :limit limit)))

(defun records/where (prefix field value)
  (soil:records/query
    (records/spec "" prefix (list (records/filter field "eq" value)) nil nil 4096)))

(defun records/select (prefix fields)
  (soil:records/query
    (records/spec "" prefix nil fields nil 4096)))

(defun records/aggregate-spec (collection prefix filters group-by bucket-field bucket-seconds)
  (list
    (list :collection collection)
    (list :prefix prefix)
    (list :filters filters)
    (list :group-by group-by)
    (list :bucket-field bucket-field)
    (list :bucket-seconds bucket-seconds)))

(defun records/aggregate (collection prefix filters group-by bucket-field bucket-seconds)
  (soil:records/aggregate collection
    (records/aggregate-spec collection prefix filters group-by bucket-field bucket-seconds)))

(defun records/entries (result)
  (if (ok? result) (or-empty (field (value result) :entries)) nil))

;;; Return the `:entries` list of a records page.
(defun page-entries (page)
  (field page :entries))

;;; Return the `:key` record from a records entry.
(defun entry-key (entry)
  (field entry :key))

;;; Return the id part of a records entry key.
(defun entry-id (entry)
  (field (entry-key entry) :id))

;;; Return the collection part of a records entry key.
(defun entry-collection (entry)
  (field (entry-key entry) :collection))

;;; Return the schema name of a records entry.
(defun entry-schema (entry)
  (field entry :schema))

;;; Return the update timestamp of a records entry, in milliseconds.
(defun entry-updated-at (entry)
  (field entry :updated-at-ms))

;;; Decode and return the JSON body of a records entry.
(defun entry-body (entry)
  (json-decode (field entry :body)))

;;; Build a records key from a collection name and an id.
(defun record-key (collection id)
  (list (list :collection collection) (list :id id)))

;;; Build a records entry from a key, schema, body, and timestamp.
(defun make-entry (collection id schema body now)
  (list
    (list :key (record-key collection id))
    (list :schema schema)
    (list :revision 0)
    (list :updated-at-ms now)
    (list :origin "soil")
    (list :deleted #f)
    (list :body (json-encode body))))

;;; Write an entry through the host records capability.
(defun upsert-record (collection id schema body now)
  (soil:records/upsert (make-entry collection id schema body now)))

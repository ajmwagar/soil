; SPDX-License-Identifier: MIT OR Apache-2.0
; Interactive demos for the Lisp 101 programs.
;
; Copy lives in site/book-copy.soil. Programs come from examples/lisp/*.soil
; through the generated site/lisp-code.soil table.

(defun demo-code-for (slug items)
  (if (nil? items)
      ""
      (if (= (field (first items) :slug) slug)
          (field (first items) :code)
          (demo-code-for slug (rest items)))))

(defun demo-p (text)
  (el "p" nil (list (txt text))))

(defun demo-repl (id title note code rows)
  (el "aside"
    (list
      (attr :class "repl demo-repl")
      (attr :data-repl-id id)
      (attr :aria-label title))
    (list
      (el "div" (list (attr :class "repl-head"))
        (list
          (el "h3" nil (list (txt title)))
          (el "span" (list (attr :class "repl-badge")) (list (txt "wasm")))))
      (el "p" (list (attr :class "repl-note")) (list (txt note)))
      (el "div" (list (attr :class "repl-editor"))
        (list
          (el "pre" (list (attr :class "repl-highlight") (attr :aria-hidden "true"))
            (list (el "code" nil nil)))
          (el "textarea"
            (list
              (attr :class "repl-input")
              (attr :spellcheck "false")
              (attr :autocomplete "off")
              (attr :rows rows))
            (list (txt code)))))
      (el "div" (list (attr :class "repl-actions"))
        (list
          (el "button" (list (attr :class "repl-run") (attr :type "button"))
            (list (txt "Run")))
          (el "button" (list (attr :class "repl-share") (attr :type "button"))
            (list (txt "Share")))
          (el "label" (list (attr :class "repl-live"))
            (list
              (el "input" (list (attr :type "checkbox") (attr :class "repl-live-toggle") (attr :checked "checked")) nil)
              (el "span" nil (list (txt "Live")))))
          (el "span" (list (attr :class "repl-hint"))
            (list (txt "⌘/Ctrl + Enter")))
          (el "span" (list (attr :class "repl-status"))
            (list (txt "loading…")))))
      (el "pre" (list (attr :class "repl-output") (attr :aria-live "polite"))
        (list (txt ""))))))

(defun demo-section (id number title body try code rows)
  (el "section" (list (attr :class "demo") (attr :id id))
    (list
      (el "div" (list (attr :class "demo-head"))
        (list
          (el "span" (list (attr :class "demo-number")) (list (txt number)))
          (el "h2" nil (list (txt title)))))
      (demo-p body)
      (el "p" (list (attr :class "demo-try")) (list (txt try)))
      (demo-repl id title "Edit the source. Run it. Change it again." code rows))))

(defun demo-styles ()
  (str
    (styles)
    ".demo-shell { max-width: 980px; margin: 0 auto; padding: clamp(34px, 6vw, 72px) 28px 96px; }\n"
    ".demo-kicker { margin: 0 0 14px; color: var(--color-accent); font-family: var(--font-mono); font-size: 12px; letter-spacing: .12em; text-transform: uppercase; }\n"
    ".demo-shell h1 { margin: 0 0 18px; font-family: var(--font-display); font-size: clamp(42px, 7vw, 76px); line-height: .98; letter-spacing: -.045em; overflow-wrap: anywhere; }\n"
    ".demo-lede { margin: 0 0 18px; color: var(--color-muted); font-family: var(--font-display); font-size: clamp(20px, 2.5vw, 27px); line-height: 1.35; letter-spacing: -.015em; max-width: 62ch; }\n"
    ".demo-intro { margin: 0 0 44px; color: var(--color-muted); max-width: 62ch; }\n"
    ".demo { padding: 38px 0 22px; border-top: 1px solid var(--color-line); }\n"
    ".demo-head { display: flex; gap: 16px; align-items: baseline; }\n"
    ".demo-number { color: var(--color-accent); font-family: var(--font-mono); font-size: 12px; letter-spacing: .08em; }\n"
    ".demo h2 { margin: 0; font-family: var(--font-display); font-size: clamp(30px, 4vw, 44px); line-height: 1.05; letter-spacing: -.03em; }\n"
    ".demo p { max-width: 62ch; }\n"
    ".demo-try { margin: 10px 0 0; color: var(--color-dim); font-family: var(--font-mono); font-size: 12px; }\n"
    ".demo-repl { margin: 22px 0 10px; }\n"
    ".demo-repl .repl-head h3 { margin: 0; font-family: var(--font-display); font-size: 22px; letter-spacing: -.02em; }\n"
    ".demo-repl .repl-highlight, .demo-repl .repl-input { min-height: 300px; }\n"
    ".demo-repl .repl-output { max-height: 560px; }\n"
    ".demo-notes { margin-top: 38px; padding: 20px; border: 1px solid var(--color-line); border-radius: 16px; background: var(--color-panel); }\n"
    ".demo-notes h2 { margin: 0 0 10px; font-family: var(--font-display); font-size: 26px; letter-spacing: -.02em; }\n"
    ".demo-notes p { margin: 0; color: var(--color-muted); }\n"
    ".demo-next { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 34px; }\n"
    "@media (max-width: 640px) { .demo-repl .repl-highlight, .demo-repl .repl-input { min-height: 220px; } }\n"))

(defun demo-view ()
  (el "div" (list (attr :class "site demo-site") (attr :id "top"))
    (list
      (nav)
      (el "main" (list (attr :class "demo-shell"))
        (list
          (el "p" (list (attr :class "demo-kicker")) (list (txt (book-copy :demos :eyebrow))))
          (el "h1" nil (list (txt (book-copy :demos :title))))
          (el "p" (list (attr :class "demo-lede")) (list (txt (book-copy :demos :lede))))
          (el "p" (list (attr :class "demo-intro")) (list (txt (book-copy :demos :intro))))

          (demo-section "fibonacci" "01" (book-copy :demos :fib-title) (book-copy :demos :fib-body) (book-copy :demos :fib-try) (demo-code-for "fibonacci" lisp-code) 20)
          (demo-section "sieve" "02" (book-copy :demos :sieve-title) (book-copy :demos :sieve-body) (book-copy :demos :sieve-try) (demo-code-for "sieve" lisp-code) 24)
          (demo-section "hanoi" "03" (book-copy :demos :hanoi-title) (book-copy :demos :hanoi-body) (book-copy :demos :hanoi-try) (demo-code-for "hanoi" lisp-code) 16)
          (demo-section "life" "04" (book-copy :demos :life-title) (book-copy :demos :life-body) (book-copy :demos :life-try) (demo-code-for "life" lisp-code) 30)

          (el "section" (list (attr :class "demo-notes"))
            (list
              (el "h2" nil (list (txt (book-copy :demos :notes-title))))
              (el "p" nil (list (txt (book-copy :demos :notes-body))))))

          (el "section" (list (attr :class "demo-notes"))
            (list
              (el "h2" nil (list (txt (book-copy :demos :next-title))))
              (el "p" nil (list (txt (book-copy :demos :next-body))))
              (el "div" (list (attr :class "demo-next"))
                (list
                  (a "lisp-101.html" "btn primary" (list (txt (book-copy :demos :next-book-label))))
                  (a "docs/" "btn" (list (txt (book-copy :demos :next-docs-label))))
                  (a "https://github.com/ajmwagar/soil/tree/master/examples/lisp" "btn" (list (txt (book-copy :demos :next-source-label))))))))))
      (demo-footer)
      (el "script" (list (attr :type "module") (attr :src "repl.js")) nil))))

(defun demo-footer ()
  (el "footer" (list (attr :class "footer"))
    (list
      (el "div" (list (attr :class "footer-grid"))
        (list
          (el "div" (list (attr :class "footer-col"))
            (list
              (el "h3" nil (list (txt "Read")))
              (a "lisp-101.html" "" (list (txt (copy :nav :book))))
              (a "demos.html" "" (list (txt (copy :nav :demos))))
              (a "getting-started.html" "" (list (txt (copy :nav :start))))))
          (el "div" (list (attr :class "footer-col"))
            (list
              (el "h3" nil (list (txt "Reference")))
              (a "docs/" "" (list (txt (copy :nav :api))))
              (a "/#language" "" (list (txt (copy :nav :language))))
              (a "/#examples" "" (list (txt (copy :nav :examples))))))
          (el "div" (list (attr :class "footer-col"))
            (list
              (el "h3" nil (list (txt "Source")))
              (a "https://github.com/ajmwagar/soil" "" (list (txt (copy :footer :github-label))))
              (a "https://github.com/ajmwagar/soil/tree/master/examples/lisp" "" (list (txt "Lisp examples")))))
          (el "div" (list (attr :class "footer-col"))
            (list
              (el "h3" nil (list (txt (copy :footer :sponsor-label))))
              (a "https://fpl.dev/" "" (list (txt (copy :footer :sponsor))))))))
      (el "div" (list (attr :class "footer-bottom"))
        (list
          (el "div" nil (list (txt (copy :footer :left))))
          (el "div" nil (list (txt (copy :footer :license))))
          (a "#top" "" (list (txt (copy :footer :back-to-top)))))))))

(defun main ()
  (println
    (render-page
      (book-copy :demos :title)
      (demo-styles)
      (demo-view))))

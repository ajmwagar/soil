; The soil-lang.org landing page.
;
; All editable copy lives in copy.soil. This file owns structure and CSS.

(defun a (href class children)
  (el "a" (list (attr :href href) (attr :class class)) children))

(defun nav ()
  (el "header" (list (attr :class "nav"))
    (list
      (el "div" (list (attr :class "nav-inner"))
        (list
          (a "/" "wordmark" (list (txt "Soil")))
          (el "nav" (list (attr :class "nav-links"))
            (list
              (a "getting-started.html" "" (list (txt (copy :nav :start))))
              (a "#language" "" (list (txt (copy :nav :language))))
              (a "#library" "" (list (txt (copy :nav :core))))
              (a "#loam" "" (list (txt (copy :nav :loam))))
              (a "#examples" "" (list (txt (copy :nav :examples))))
              (a "docs/" "" (list (txt (copy :nav :api))))
          (a "https://github.com/ajmwagar/soil" "nav-source"
            (list (txt (copy :nav :github)))))))))))

(defun fact-item (text)
  (el "li" nil (list (txt text))))

(defun example-code-for (slug items)
  (if (nil? items)
      ""
      (if (= (field (first items) :slug) slug)
          (field (first items) :code)
          (example-code-for slug (rest items)))))

(defun work-item (item)
  (let ((slug (field item :slug)))
    (el "article" (list (attr :class "work"))
      (list
        (el "header" (list (attr :class "work-head"))
          (list
            (el "h3" nil (list (txt (field item :title))))
            (el "p" nil (list (txt (field item :body))))))
        (el "div" (list (attr :class "work-switch") (attr :role "tablist"))
          (list
            (el "button"
              (list
                (attr :type "button")
                (attr :class "is-active")
                (attr :data-work-tab "preview")
                (attr :aria-selected "true")
                (attr :aria-controls (str "work-preview-" slug)))
              (list (txt "Preview")))
            (el "button"
              (list
                (attr :type "button")
                (attr :data-work-tab "source")
                (attr :aria-selected "false")
                (attr :aria-controls (str "work-source-" slug)))
              (list (txt "Source")))))
        (el "div"
          (list
            (attr :class "work-panel is-active")
            (attr :data-work-panel "preview")
            (attr :id (str "work-preview-" slug)))
          (list
            (el "iframe"
              (list
                (attr :src (str "examples/" slug ".html"))
                (attr :title (field item :title))
                (attr :loading "lazy")
                (attr :scrolling "no"))
              nil)))
        (el "div"
          (list
            (attr :class "work-panel")
            (attr :data-work-panel "source")
            (attr :id (str "work-source-" slug))
            (attr :hidden "hidden"))
          (list
            (el "pre" (list (attr :class "code soil-source"))
              (list (txt (example-code-for slug example-code))))))))))

(defun repl-panel (title code)
  (el "aside" (list (attr :class "repl repl-compact") (attr :aria-labelledby "try-repl-title"))
    (list
      (el "div" (list (attr :class "repl-head"))
        (list
          (el "h2" (list (attr :id "try-repl-title")) (list (txt title)))
          (el "span" (list (attr :class "repl-badge")) (list (txt "wasm")))))
      (el "p" (list (attr :class "repl-note"))
        (list (txt "Runs in your browser.")))
      (el "div" (list (attr :class "repl-editor"))
        (list
          (el "pre" (list (attr :class "repl-highlight") (attr :aria-hidden "true"))
            (list (el "code" nil nil)))
          (el "textarea"
            (list
              (attr :class "repl-input")
              (attr :spellcheck "false")
              (attr :autocomplete "off")
              (attr :rows "6"))
            (list (txt code)))))
      (el "div" (list (attr :class "repl-actions"))
        (list
          (el "button" (list (attr :class "repl-run") (attr :type "button"))
            (list (txt "Run")))
          (el "button" (list (attr :class "repl-share") (attr :type "button"))
            (list (txt "Share")))
          (el "label" (list (attr :class "repl-live"))
            (list
              (el "input" (list (attr :type "checkbox") (attr :class "repl-live-toggle") (attr :checked "checked")) nil)
              (el "span" nil (list (txt "Live")))))
          (el "span" (list (attr :class "repl-hint"))
            (list (txt "⌘/Ctrl + Enter")))
          (el "span" (list (attr :class "repl-status"))
            (list (txt "loading…")))))
      (el "pre" (list (attr :class "repl-output") (attr :aria-live "polite"))
        (list (txt ""))))))

(defun view (state)
  (el "div" (list (attr :class "site") (attr :id "top"))
    (list
      (nav)
      (el "main" nil
        (list
          (el "section" (list (attr :class "hero"))
            (list
              (el "div" (list (attr :class "hero-copy"))
                (list
                  (el "h1" nil (list (txt (copy :hero :title))))
                  (el "p" (list (attr :class "statement")) (list (txt (copy :hero :statement))))
                  (el "p" (list (attr :class "lede")) (list (txt (copy :hero :lede))))
                  (el "div" (list (attr :class "actions"))
                    (list
                      (a "getting-started.html" "btn primary" (list (txt (copy :hero :primary-label))))
                      (a "https://github.com/ajmwagar/soil" "btn" (list (txt (copy :hero :github-label))))))))
              (el "div" (list (attr :class "hero-code"))
                (list
                  (el "p" (list (attr :class "code-name")) (list (txt (copy :hero :code-name))))
                  (code-block (copy :hero :code))
                  (el "div" (list (attr :class "hero-live"))
                    (list
                      (el "p" (list (attr :class "code-name")) (list (txt (copy :hero :live-label))))
                      (el "iframe"
                        (list
                          (attr :src "examples/counter.html")
                          (attr :title (copy :hero :live-label))
                          (attr :loading "eager")
                          (attr :scrolling "no"))
                        nil)))))))

          (el "section" (list (attr :class "section") (attr :id "language"))
            (list
              (el "h2" nil (list (txt (copy :language :title))))
              (el "div" (list (attr :class "prose"))
                (list
                  (el "p" nil (list (txt (copy :language :body))))
                  (el "p" nil (list (txt (copy :language :body-2))))
                  (el "p" nil (list (txt (copy :language :body-3))))
                  (el "p" nil
                    (list
                      (a "https://paulgraham.com/avg.html" "text-link"
                        (list (txt (copy :language :essay-label))))))))
              (el "ul" (list (attr :class "facts"))
                (map 'fact-item (copy :language :facts)))))

          (el "section" (list (attr :class "section") (attr :id "try"))
            (list
              (el "div" (list (attr :class "try"))
                (list
                  (el "div" (list (attr :class "try-copy"))
                    (list
                      (el "h2" nil (list (txt (copy :try :title))))
                      (el "p" (list (attr :class "lede")) (list (txt (copy :try :body))))))
                  (repl-panel "Try Soil" (copy :try :code))))))

          (el "section" (list (attr :class "section") (attr :id "library"))
            (list
              (el "h2" nil (list (txt (copy :library :title))))
              (el "p" (list (attr :class "lede")) (list (txt (copy :library :body))))
              (el "div" (list (attr :class "actions"))
                (list
                  (a "docs/" "btn primary" (list (txt (copy :library :docs-label))))
                  (a "docs/prelude.html" "btn" (list (txt (copy :library :prelude-label))))
                  (a "docs/ui.html" "btn" (list (txt (copy :library :ui-label))))
                  (a "docs/events.html" "btn" (list (txt (copy :library :events-label))))))))

          (el "section" (list (attr :class "section") (attr :id "loam"))
            (list
              (el "div" (list (attr :class "loam-head"))
                (list
                  (el "img" (list (attr :src "loam.svg") (attr :alt (copy :loam :logo-alt)) (attr :class "loam-mark")) nil)
                  (el "h2" nil (list (txt (copy :loam :title))))))
              (el "div" (list (attr :class "prose"))
                (list
                  (el "p" nil (list (txt (copy :loam :body))))
                  (el "p" nil (list (txt (copy :loam :body-2))))))
              (el "div" (list (attr :class "actions"))
                (list
                  (a "https://github.com/mycelium-linux/loam" "btn"
                    (list (txt (copy :loam :label))))))))

          (el "section" (list (attr :class "section") (attr :id "examples"))
            (list
              (el "h2" nil (list (txt (copy :examples :title))))
              (el "p" (list (attr :class "lede")) (list (txt (copy :examples :body))))
              (el "div" (list (attr :class "works"))
                (map 'work-item (copy :examples :items)))))

          (el "section" (list (attr :class "closing"))
            (list
              (el "h2" nil (list (txt (copy :closing :title))))
              (el "p" (list (attr :class "lede")) (list (txt (copy :closing :body))))
              (el "div" (list (attr :class "actions"))
                (list
                  (a "https://github.com/ajmwagar/soil/tree/master/compiler" "btn primary"
                    (list (txt (copy :closing :compiler-label))))
                  (a "https://github.com/ajmwagar/soil/tree/master/core" "btn"
                    (list (txt (copy :closing :core-link-label))))
                  (a "https://github.com/ajmwagar/soil/tree/master/examples" "btn"
                    (list (txt (copy :closing :examples-link-label))))
                  (a "https://github.com/mycelium-linux/loam" "btn"
                    (list (txt (copy :closing :loam-label))))))))))
      (el "footer" (list (attr :class "footer"))
        (list
          (el "div" (list (attr :class "footer-grid"))
            (list
              (el "div" (list (attr :class "footer-col"))
                (list
                  (el "h3" nil (list (txt (copy :footer :language-label))))
                  (a "https://github.com/ajmwagar/soil/tree/master/compiler" "" (list (txt (copy :footer :compiler-label))))
                  (a "https://github.com/ajmwagar/soil/tree/master/core" "" (list (txt (copy :footer :core-label))))
                  (a "https://github.com/ajmwagar/soil/tree/master/std" "" (list (txt (copy :footer :std-label))))))
              (el "div" (list (attr :class "footer-col"))
                (list
                  (el "h3" nil (list (txt (copy :footer :runtime-label))))
                  (a "https://github.com/mycelium-linux/loam" "" (list (txt (copy :footer :loam-label))))
                  (a "https://wasmtime.dev/" "" (list (txt (copy :footer :wasmtime-label))))
                  (a "https://wgpu.rs/" "" (list (txt (copy :footer :wgpu-label))))))
              (el "div" (list (attr :class "footer-col"))
                (list
                  (el "h3" nil (list (txt (copy :footer :source-label))))
                  (a "https://github.com/ajmwagar/soil" "" (list (txt (copy :footer :github-label))))
                  (a "https://github.com/ajmwagar/soil/tree/master/site" "" (list (txt (copy :footer :site-source-label))))
                  (a "https://github.com/ajmwagar/soil/tree/master/examples" "" (list (txt (copy :footer :examples-label))))))
              (el "div" (list (attr :class "footer-col"))
                (list
                  (el "h3" nil (list (txt (copy :footer :sponsor-label))))
                  (a "https://fpl.dev/" "" (list (txt (copy :footer :sponsor))))))))
          (el "div" (list (attr :class "footer-bottom"))
            (list
              (el "div" nil (list (txt (copy :footer :left))))
              (el "div" nil (list (txt (copy :footer :license))))
              (a "#top" "" (list (txt (copy :footer :back-to-top))))))))
      (el "section" (list (attr :class "strata") (attr :aria-hidden "true"))
        (list
          (el "img" (list (attr :src "strata.svg") (attr :alt "") (attr :class "strata-art")) nil))))))

(defun styles ()
  (str
    "/* Hallmark · macrostructure: specimen sheet · theme: warm charcoal · genre: editorial\n"
    " * pre-emit critique: P5 H4 E4 S5 R5 V4\n"
    " * slop test: pass\n"
    " */\n"
    ":root {\n"
    "  color-scheme: dark;\n"
    "  --color-bg: #14120f;\n"
    "  --color-panel: #1b1814;\n"
    "  --color-ink: #f1ece3;\n"
    "  --color-muted: #b8afa1;\n"
    "  --color-dim: #8b8173;\n"
    "  --color-line: #3a342d;\n"
    "  --color-accent: #d77b52;\n"
    "  --color-accent-ink: #1d120d;\n"
    "  --color-moss: #a9b88a;\n"
    "  --tok-comment: #82786b;\n"
    "  --tok-string: #b7c99a;\n"
    "  --tok-keyword: #d9a06b;\n"
    "  --tok-literal: #e6c07b;\n"
    "  --tok-number: #d79b8f;\n"
    "  --tok-special: #d77b52;\n"
    "  --tok-paren: #8b8173;\n"
    "  --tok-fn: #f1ece3;\n"
    "  --tok-symbol: #d9d2c6;\n"
    "  --font-display: ui-serif, Georgia, \"Times New Roman\", serif;\n"
    "  --font-body: ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", sans-serif;\n"
    "  --font-mono: ui-monospace, SFMono-Regular, Menlo, monospace;\n"
    "}\n"
    "html, body { overflow-x: clip; }\n"
    "* { box-sizing: border-box; }\n"
    "::selection { background: var(--color-accent); color: var(--color-accent-ink); }\n"
    ".site {\n"
    "  min-height: 100vh;\n"
    "  color: var(--color-ink);\n"
    "  background: var(--color-bg);\n"
    "  font-family: var(--font-body);\n"
    "  font-size: 16px;\n"
    "  line-height: 1.6;\n"
    "}\n"
    ".nav {\n"
    "  position: sticky; top: 0; z-index: 10;\n"
    "  border-bottom: 1px solid var(--color-line);\n"
    "  background: var(--color-bg);\n"
    "}\n"
    ".nav-inner { max-width: 1120px; margin: 0 auto; padding: 18px 28px; display: flex; flex-wrap: wrap; align-items: center; gap: 18px 28px; }\n"
    ".wordmark { color: var(--color-ink); text-decoration: none; font-family: var(--font-display); font-size: 26px; font-weight: 700; letter-spacing: -.04em; }\n"
    ".wordmark::after { content: \".\"; color: var(--color-accent); }\n"
    ".nav-links { display: flex; flex-wrap: wrap; gap: 16px 22px; flex: 1; }\n"
    ".nav-links a, .nav-source, .btn, .footer a { white-space: nowrap; }\n"
    ".nav-links a, .nav-source { color: var(--color-muted); text-decoration: none; font-size: 14px; }\n"
    ".nav-links a:hover, .nav-source:hover { color: var(--color-ink); }\n"
    ".nav-source { border-bottom: 1px solid var(--color-line); padding-bottom: 2px; }\n"
    "main { max-width: 1120px; margin: 0 auto; padding: 0 28px 32px; }\n"
    "h1, h2, h3 { overflow-wrap: anywhere; min-width: 0; }\n"
    ".hero { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, .9fr); gap: 56px; align-items: end; padding: clamp(56px, 9vw, 120px) 0 clamp(56px, 8vw, 96px); }\n"
    ".hero h1 { margin: 0; font-family: var(--font-display); font-size: clamp(76px, 14vw, 190px); line-height: .82; letter-spacing: -.07em; font-weight: 700; }\n"
    ".statement { margin: 18px 0 0; color: var(--color-accent); font-family: var(--font-display); font-size: clamp(24px, 3.4vw, 40px); line-height: 1.1; letter-spacing: -.03em; }\n"
    ".lede { margin: 18px 0 0; max-width: 54ch; color: var(--color-muted); font-size: clamp(16px, 1.7vw, 19px); }\n"
    ".actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 26px; }\n"
    ".btn { display: inline-flex; align-items: center; justify-content: center; border: 1px solid var(--color-line); border-radius: 999px; padding: 10px 16px; color: var(--color-ink); text-decoration: none; font-size: 14px; font-weight: 650; background: var(--color-panel); }\n"
    ".btn:hover { border-color: var(--color-accent); color: var(--color-accent); }\n"
    ".btn.primary { background: var(--color-accent); border-color: var(--color-accent); color: var(--color-accent-ink); }\n"
    ".btn.primary:hover { background: var(--color-moss); border-color: var(--color-moss); color: var(--color-accent-ink); }\n"
    ".hero-code { min-width: 0; }\n"
    ".hero-live { margin-top: 18px; }\n"
    ".hero-live iframe { display: block; width: 100%; height: 240px; border: 1px solid var(--color-line); border-radius: 12px; background: var(--color-panel); }\n"
    ".code-name { margin: 0 0 10px; color: var(--color-dim); font-family: var(--font-mono); font-size: 12px; }\n"
    ".code-note { margin: 10px 0 0; color: var(--color-dim); font-size: 13px; }\n"
    ".code { margin: 0; padding: 18px; overflow-x: auto; border: 1px solid var(--color-line); border-radius: 14px; background: var(--color-panel); color: var(--tok-symbol); font-family: var(--font-mono); font-size: 12.5px; line-height: 1.65; white-space: pre; }\n"
    ".tok-comment { color: var(--tok-comment); font-style: italic; }\n"
    ".tok-string { color: var(--tok-string); }\n"
    ".tok-keyword { color: var(--tok-keyword); }\n"
    ".tok-literal { color: var(--tok-literal); }\n"
    ".tok-number { color: var(--tok-number); }\n"
    ".tok-special { color: var(--tok-special); font-weight: 700; }\n"
    ".tok-paren { color: var(--tok-paren); }\n"
    ".tok-fn { color: var(--tok-fn); }\n"
    ".tok-symbol { color: var(--tok-symbol); }\n"
    ".section { padding: clamp(52px, 7vw, 88px) 0; border-top: 1px solid var(--color-line); }\n"
    ".section h2, .closing h2 { margin: 0 0 24px; max-width: 24ch; font-family: var(--font-display); font-size: clamp(32px, 4.4vw, 56px); line-height: 1.02; letter-spacing: -.045em; }\n"
    ".loam-head { display: flex; align-items: center; gap: 16px; margin-bottom: 24px; }\n"
    ".loam-head h2 { margin: 0; }\n"
    ".loam-mark { width: 48px; height: 48px; border-radius: 10px; }\n"
    ".prose { max-width: 62ch; }\n"
    ".prose p { margin: 0 0 14px; color: var(--color-muted); }\n"
    ".prose p:last-child { margin-bottom: 0; }\n"
    ".text-link { color: var(--color-accent); text-decoration: none; border-bottom: 1px solid var(--color-accent); }\n"
    ".text-link:hover { color: var(--color-moss); border-bottom-color: var(--color-moss); }\n"
    ".facts { display: flex; flex-wrap: wrap; gap: 10px 24px; margin: 26px 0 0; padding: 0; list-style: none; color: var(--color-dim); font-family: var(--font-mono); font-size: 12px; }\n"
    ".facts li::before { content: \"· \"; color: var(--color-accent); }\n"
    ".try { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 430px); gap: 56px; align-items: start; }\n"
    ".try-copy .lede { margin: 0; }\n"
    ".repl { min-width: 0; padding: 16px; border: 1px solid var(--color-line); border-radius: 16px; background: var(--color-panel); }\n"
    ".repl-head { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; }\n"
    ".repl-head h2 { margin: 0; font-family: var(--font-display); font-size: 24px; letter-spacing: -.02em; }\n"
    ".repl-badge { color: var(--color-accent); font-family: var(--font-mono); font-size: 11px; letter-spacing: .08em; text-transform: uppercase; }\n"
    ".repl-note { margin: 6px 0 12px; color: var(--color-dim); font-size: 12.5px; }\n"
    ".repl-editor { position: relative; overflow: hidden; border: 1px solid var(--color-line); border-radius: 10px; background: var(--color-bg); }\n"
    ".repl-editor:focus-within { outline: 2px solid var(--color-accent); outline-offset: 2px; }\n"
    ".repl-highlight, .repl-input { margin: 0; width: 100%; min-height: 136px; padding: 12px; font-family: var(--font-mono); font-size: 12px; line-height: 1.55; white-space: pre-wrap; overflow-wrap: anywhere; tab-size: 2; }\n"
    ".repl-highlight { position: absolute; inset: 0; overflow: hidden; pointer-events: none; color: var(--tok-symbol); }\n"
    ".repl-highlight code { font: inherit; }\n"
    ".repl-input { position: relative; display: block; border: 0; outline: 0; resize: vertical; background: transparent; color: transparent; caret-color: var(--color-ink); }\n"
    ".repl-input::selection { background: rgba(215,123,82,.35); color: transparent; }\n"
    ".repl-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; margin-top: 10px; }\n"
    ".repl-run { appearance: none; border: 1px solid var(--color-accent); border-radius: 999px; padding: 7px 14px; background: var(--color-accent); color: var(--color-accent-ink); cursor: pointer; font-family: var(--font-mono); font-size: 12px; line-height: 1.2; }\n"
    ".repl-run:hover { background: var(--color-moss); border-color: var(--color-moss); }\n"
    ".repl-run:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 2px; }\n"
    ".repl-share { appearance: none; border: 1px solid var(--color-line); border-radius: 999px; padding: 7px 14px; background: transparent; color: var(--color-muted); cursor: pointer; font-family: var(--font-mono); font-size: 12px; line-height: 1.2; }\n"
    ".repl-share:hover { border-color: var(--color-accent); color: var(--color-accent); }\n"
    ".repl-share:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 2px; }\n"
    ".repl-live { display: inline-flex; align-items: center; gap: 5px; color: var(--color-muted); font-family: var(--font-mono); font-size: 11px; cursor: pointer; }\n"
    ".repl-live input { accent-color: var(--color-accent); }\n"
    ".repl-hint { color: var(--color-dim); font-family: var(--font-mono); font-size: 11px; }\n"
    ".repl-status { margin-left: auto; color: var(--color-dim); font-family: var(--font-mono); font-size: 11px; }\n"
    ".repl-status.is-error { color: var(--color-accent); }\n"
    ".repl-output { margin: 12px 0 0; min-height: 48px; max-height: 220px; overflow: auto; padding: 12px; border: 1px solid var(--color-line); border-radius: 10px; background: var(--color-bg); color: var(--color-ink); font-family: var(--font-mono); font-size: 12.5px; line-height: 1.55; white-space: pre-wrap; }\n"
    ".repl-output.is-error { color: var(--color-accent); }\n"
    ".works { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px 20px; margin-top: 34px; }\n"
    ".work { min-width: 0; }\n"
    ".work-head { padding: 0 0 10px; border-bottom: 1px solid var(--color-line); }\n"
    ".work-head h3 { margin: 0; font-family: var(--font-display); font-size: 22px; letter-spacing: -.02em; }\n"
    ".work-head p { margin: 2px 0 0; color: var(--color-dim); font-size: 13px; }\n"
    ".work-switch { display: flex; gap: 6px; margin-top: 12px; }\n"
    ".work-switch button { appearance: none; border: 1px solid var(--color-line); border-radius: 999px; padding: 6px 12px; background: transparent; color: var(--color-muted); cursor: pointer; font-family: var(--font-mono); font-size: 11px; line-height: 1.2; white-space: nowrap; }\n"
    ".work-switch button:hover { color: var(--color-ink); border-color: var(--color-muted); }\n"
    ".work-switch button.is-active { color: var(--color-accent); border-color: var(--color-accent); }\n"
    ".work-switch button:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 2px; }\n"
    ".work-panel { margin-top: 10px; }\n"
    ".work-panel[hidden] { display: none; }\n"
    ".work-panel iframe { display: block; width: 100%; height: 320px; border: 1px solid var(--color-line); border-radius: 12px; background: var(--color-panel); }\n"
    ".work-panel .code { margin: 0; max-height: 420px; font-size: 11.5px; }\n"
    ".closing { margin: 20px 0 0; padding: clamp(32px, 6vw, 64px); border: 1px solid var(--color-line); border-radius: 18px; }\n"
    ".closing .lede { margin-bottom: 0; }\n"
    ".kicker { margin: 0 0 14px; color: var(--color-accent); font-family: var(--font-mono); font-size: 11px; font-weight: 700; letter-spacing: .14em; }\n"
    ".body { color: var(--color-muted); max-width: 56ch; }\n"
    ".footer { max-width: 1120px; margin: 0 auto; padding: 28px; border-top: 1px solid var(--color-line); display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px 20px; color: var(--color-dim); font-size: 12.5px; }\n"
    ".footer-grid { width: 100%; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 28px; padding-bottom: 24px; border-bottom: 1px solid var(--color-line); }\n"
    ".footer-col h3 { margin: 0 0 8px; color: var(--color-accent); font-family: var(--font-mono); font-size: 11px; letter-spacing: .1em; text-transform: uppercase; }\n"
    ".footer-col a { display: block; margin: 5px 0; }\n"
    ".footer-bottom { width: 100%; display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px 20px; padding-top: 18px; }\n"
    ".footer-links { display: flex; flex-wrap: wrap; gap: 16px; }\n"
    ".footer a { color: var(--color-muted); text-decoration: none; }\n"
    ".footer a:hover { color: var(--color-ink); }\n"
    ".sponsor { color: var(--color-muted); text-decoration: none; border-bottom: 1px solid var(--color-line); }\n"
    ".sponsor:hover { color: var(--color-accent); border-bottom-color: var(--color-accent); }\n"
    ".strata { line-height: 0; background: #0f0d0b; border-top: 1px solid var(--color-line); }\n"
    ".strata-art { display: block; width: 100%; height: clamp(560px, 105vh, 1000px); object-fit: cover; object-position: center top; }\n"
    "@media (max-width: 860px) {\n"
    "  .hero, .try, .works { grid-template-columns: minmax(0, 1fr); }\n"
    "  .hero { gap: 32px; }\n"
    "  .footer-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }\n"
    "}\n"
    "@media (max-width: 560px) {\n"
    "  .nav-inner { padding: 14px 18px; gap: 12px 18px; }\n"
    "  main, .footer { padding-left: 18px; padding-right: 18px; }\n"
    "  .nav-links { gap: 10px 14px; }\n"
    "  .nav-links a, .nav-source { font-size: 12.5px; }\n"
    "  .hero { padding-top: 44px; }\n"
    "  .facts { display: grid; gap: 6px; }\n"
    "  .modules li { grid-template-columns: minmax(0, 1fr); gap: 2px; }\n"
    "  .closing { padding: 24px 18px; }\n"
    "  .footer { flex-direction: column; align-items: flex-start; }\n"
    "  .footer-grid { grid-template-columns: minmax(0, 1fr); }\n"
    "  .strata-art { height: clamp(520px, 110vh, 900px); }\n"
    "}\n"))

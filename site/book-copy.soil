; SPDX-License-Identifier: MIT OR Apache-2.0
; Copy for the Lisp 101 book page and the interactive demos page.

(defconst book-copy-data
  (list
    (list :book
      (list
        (list :eyebrow "LISP 101")
        (list :title "Read Lisp like a sentence")
        (list :lede "Lisp is not a language about parentheses. It is a language about forms: small lists that mean something when they are evaluated. Once you can see the form, the rest is vocabulary.")
        (list :toc-label "Contents")
        (list :toc-origins "Origins")
        (list :toc-forms "Forms")
        (list :toc-atoms "Atoms")
        (list :toc-defun "Functions")
        (list :toc-lists "Lists")
        (list :toc-recursion "Recursion")
        (list :toc-classics "Four classics")
        (list :toc-next "Next")

        (list :origins-title "Where the parentheses came from")
        (list :origins-lede "Lisp is older than the web, older than Unix, and almost as old as Fortran. Its shape has survived because the shape is the idea.")
        (list :origins-p1 "John McCarthy published the first Lisp design in 1958 while working on artificial intelligence at MIT. The goal was not a general-purpose business language. The goal was a notation for manipulating symbolic expressions: lists of names, numbers, and other lists.")
        (list :origins-p2 "The name stands for LISt Processing. The original notation used parentheses to write those lists, and the evaluator read the same lists the programmer wrote. Code and data were made of the same stuff. That property is called homoiconicity, and it is why Lisp macros can build new syntax from ordinary list transformations.")
        (list :origins-p3 "Lisp has many descendants: Scheme, Common Lisp, Clojure, Emacs Lisp, Racket, and many smaller dialects. Soil belongs to that family. It keeps the small form, the prefix notation, and the idea that a program is a tree you can read.")
        (list :origins-note "The important inheritance is not the parentheses. It is the decision to make the program’s structure visible.")

        (list :forms-title "How to read a form")
        (list :forms-lede "Every form is a list. The first element is usually the operator, and the rest are its arguments. That is the whole rule.")
        (list :forms-p1 "In most languages you write `add(2, 3)` or `2 + 3`. In Lisp you write `(add 2 3)`. The operator moves to the front, and the parentheses mark the boundary. Nothing is hidden in precedence tables: `(+ 2 (* 3 4))` says exactly what it means.")
        (list :forms-p2 "Read from the outside in. The outer list is the expression being evaluated. Its first element says what kind of expression it is. The inner lists are arguments, and they are evaluated before the outer operator unless the operator is a special form.")
        (list :forms-p3 "A useful reading habit is to say the form out loud: “call `+` with two and the result of calling `*` with three and four.” Once you do that, nested forms stop looking like punctuation and start looking like a tree.")
        (list :forms-note "Parentheses are not decoration. They are the syntax tree written directly.")

        (list :atoms-title "Atoms, names, and truth")
        (list :atoms-lede "Not every form is a call. Numbers, strings, booleans, keywords, and symbols evaluate to themselves or to a binding.")
        (list :atoms-p1 "Numbers are written as you expect: `0`, `42`, `-7`. Strings use double quotes: `\"hello\"`. Booleans are `#t` and `#f`. The empty list is `nil`. Keywords begin with a colon: `:name`, `:count`. They are useful as record keys and never need quoting.")
        (list :atoms-p2 "Symbols are names. A symbol can name a function, a value, or a macro. In `(defun square (x) (* x x))`, `square` and `x` are symbols. The quote form `'square` means “the symbol itself, not its value.”")
        (list :atoms-p3 "Comments begin with a semicolon and run to the end of the line. Soil has no significant whitespace: indentation is for humans, not the parser.")
        (list :atoms-note "The reader turns text into lists. Evaluation turns lists into values. Those are separate steps.")

        (list :defun-title "Defun: naming a transformation")
        (list :defun-lede "A function is a named transformation from arguments to a result. `defun` is the form that gives it a name.")
        (list :defun-p1 "`(defun square (x) (* x x))` defines a function called `square` with one parameter, `x`. The body is `(* x x)`. Calling `(square 9)` evaluates the body with `x` bound to `9`, so the result is `81`.")
        (list :defun-p2 "`let` creates local bindings. `(let ((x 2) (y 3)) (+ (* x x) (* y y)))` binds two names for the body and returns `13`. Bindings are lexical: the body sees the names, and nothing outside the `let` does.")
        (list :defun-p3 "`if` chooses between two expressions. `(if (< 3 5) \"yes\" \"no\")` returns `\"yes\"`. `cond` is the multi-branch version. Both are special forms: they decide which arguments to evaluate.")
        (list :defun-note "A function call is just a list whose first element names the function.")

        (list :thinking-title "Think in lists")
        (list :thinking-lede "Lisp programs are built from lists, and the standard library is built from a few list operations.")
        (list :thinking-p1 "`(list 1 2 3)` constructs a list. `(first xs)` returns its head. `(rest xs)` returns everything after the head. `(cons 0 xs)` puts a new head on the front. `nil` is the empty list.")
        (list :thinking-p2 "`map` applies a function to every element. `filter` keeps the elements that satisfy a predicate. `reduce` folds a list into one value. These are not loops with hidden state; they are recursive walks over a tree.")
        (list :thinking-p3 "Because code is data, a list can also be a program. `'(+ 1 2)` is a list containing the symbol `+`, the number `1`, and the number `2`. Evaluating that quoted list gives a value; evaluating the unquoted form calls the operator. This is the door to macros.")
        (list :thinking-note "Lists are the data structure and the syntax. That is the trick.")

        (list :recursion-title "Recursion is the loop")
        (list :recursion-lede "Most Lisp iteration is recursion: a function calls itself on a smaller input until it reaches a base case.")
        (list :recursion-p1 "The shape is always the same. Check for the smallest case. If you are there, return the answer. Otherwise, do one step and call yourself on what remains. The base case is what stops the walk.")
        (list :recursion-p2 "`(defun count-down (n) (if (= n 0) 0 (+ 1 (count-down (- n 1)))))` is a loop written as a function. Soil also has `map`, `filter`, and `reduce` for the common list walks, so you do not have to hand-write every recursion.")
        (list :recursion-p3 "The four programs below are chosen because each one has a different recursive shape: a tree of calls, a sweep over a range, a divide-and-conquer plan, and a transformation of a grid.")
        (list :recursion-note "When a recursive function looks mysterious, write down the base case first.")

        (list :classics-title "Four classic programs")
        (list :classics-lede "Each example is a real Soil program. Edit it, run it, and change the constants. The browser is the interpreter. Evaluation is capped at three seconds, and the programs clamp their inputs to keep the page responsive.")
        (list :fib-title "Fibonacci")
        (list :fib-body "The naive Fibonacci function is the cleanest example of a tree-recursive call. It is also a warning: the number of calls grows exponentially. The browser build caps n at 25 and returns a short string above that.")
        (list :fib-try "Try changing the final range. `(map 'fib (range 0 12))` returns the first twelve values.")
        (list :sieve-title "Prime sieve")
        (list :sieve-body "The sieve keeps a list of flags, one per number. For each prime it finds, it marks that prime’s multiples as composite. The final filter reads the surviving flags. The browser build caps the limit at 300.")
        (list :sieve-try "Try `(primes-up-to 100)` or `(primes-up-to 300)`. The list is the answer.")
        (list :hanoi-title "Towers of Hanoi")
        (list :hanoi-body "To move a stack of n disks, move n−1 disks out of the way, move the largest disk, then move the n−1 disks back on top. The code is almost a direct translation of that sentence. The browser build caps the disk count at 15.")
        (list :hanoi-try "Try `(hanoi 4 \"A\" \"C\" \"B\")`. Count the moves: each extra disk doubles the work.")
        (list :life-title "Game of Life")
        (list :life-body "A board is a list of rows. Each cell counts its eight neighbours, then applies the birth and survival rules. The next generation is a new board; the old one is never mutated. The browser build caps the generation count at 100.")
        (list :life-try "Try `(generations (glider) 1)`, then 4, then 8. The canvas animates the frames; use Play/Pause or the slider to step through them.")
        (list :next-title "Keep reading")
        (list :next-body "The demo page gives each program a larger editor and more room for the output. The API docs explain the core functions used here. The repository has the source for the site, the compiler, and the examples.")
        (list :next-demos-label "Open the demo page")
        (list :next-docs-label "API docs")
        (list :next-source-label "Source")))

    (list :demos
      (list
        (list :eyebrow "INTERACTIVE DEMOS")
        (list :title "Four programs, with room to breathe")
        (list :lede "These are the same programs from Lisp 101, in larger editors. Change the constants, edit the functions, and run them again. Everything executes in your browser.")
        (list :intro "The point is not to admire the code. The point is to take it apart. Each panel keeps its own source, so you can experiment without losing the others. Evaluation is capped at three seconds, and the examples clamp their inputs to keep the browser responsive.")
        (list :fib-title "Fibonacci")
        (list :fib-body "A tree-recursive function. The base case is `n < 2`. The recursive case adds the two previous values. This is elegant and intentionally inefficient; it is a good first recursion, not a production algorithm. The browser caps n at 25.")
        (list :fib-try "Change the range at the bottom. Try 0 through 15, then 0 through 20. Notice where the pause appears.")
        (list :sieve-title "Prime sieve")
        (list :sieve-body "A list of booleans stands in for an array. `mark` walks the list and turns multiples off; `sweep` advances to the next prime. The final `filter-with` reads the flags. The browser caps the limit at 300.")
        (list :sieve-try "Change the limit. The output is a list of primes, not a count. Try 100 and 300.")
        (list :hanoi-title "Towers of Hanoi")
        (list :hanoi-body "The recursion has two calls around one move. `append` joins the three parts: move the small stack aside, move the large disk, move the small stack back. The browser caps the disk count at 15.")
        (list :hanoi-try "Change the disk count and the peg names. The strings in the result are the moves.")
        (list :life-title "Game of Life")
        (list :life-body "The board is a list of rows of `0` and `1`. `neighbor-sum` walks eight offsets. `next-board` builds a new board for each generation. `generations` prints the history as a string. The browser caps the generation count at 100.")
        (list :life-try "Try a different number of generations. The canvas animates the frames; use Play/Pause or the slider. Then edit the glider rows: `O` is alive and `.` is dead.")
        (list :notes-title "How to experiment")
        (list :notes-body "Each editor is independent. Live mode evaluates after a pause; Run evaluates immediately. Share puts the current source in the URL so you can send the exact program to someone else.")
        (list :next-title "Back to the book")
        (list :next-body "The book page explains the syntax behind these programs: forms, atoms, functions, lists, and recursion.")
        (list :next-book-label "Read Lisp 101")
        (list :next-docs-label "API docs")
        (list :next-source-label "Source")))))

;;; Read one section or one key inside a section from `book-copy-data`.
(defun book-copy (section key)
  (field (field book-copy-data section) key))

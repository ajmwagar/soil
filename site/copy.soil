; Editable copy for soil-lang.org.
;
; Structure, tags, and CSS classes live in soil-lang.soil. This file owns the
; words: nav labels, headings, prose, cards, and code samples.

(defconst site-copy
  (list
    (list :site
      (list
        (list :title "Soil — a Lisp for WebAssembly")))

    (list :nav
      (list
        (list :start "Get started")
        (list :language "Language")
        (list :core "Core")
        (list :examples "Examples")
        (list :api "API")
        (list :github "Source")))

    (list :hero
      (list
        (list :title "Soil")
        (list :statement "A Lisp for WebAssembly.")
        (list :lede "Soil is a small Lisp that compiles to Wasm. The runtime is Loam. The compiler, core library, and this site are written in Soil.")
        (list :primary-label "Get started")
        (list :github-label "Read the source")
        (list :code-name "counter.soil")
        (list :code "(defun view (state)\n  (el \"main\" nil\n    (list\n      (el \"h1\" nil (list (txt \"Hello from Soil\")))\n      (el \"button\" (list (attr :data-op \"inc\"))\n        (list (txt \"+\"))))))")
        (list :code-note "The form is the program. The host renders it.")))

    (list :language
      (list
        (list :title "One form, all the way down.")
        (list :body "Soil keeps the Lisp bargain: code is data, macros are ordinary forms, and the compiler is a Soil program. There is no second language for the build.")
        (list :body-2 "It emits WebAssembly. Run the module in Loam, in the browser, or in any compatible host.")
        (list :facts
          (list
            "compiler written in Soil"
            "core has no soil:* imports"
            "std is the capability layer"))))

    (list :library
      (list
        (list :title "Core and std.")
        (list :body "Core is host-free. Std is the layer that calls soil:*.")
        (list :core-label "core")
        (list :std-label "std")
        (list :core-items
          (list
            (list (list :name "prelude") (list :body "lists, JSON, records"))
            (list (list :name "date") (list :body "UTC dates and labels"))
            (list (list :name "url") (list :body "encoding and queries"))
            (list (list :name "json") (list :body "objects and arrays"))
            (list (list :name "ui") (list :body "forms and components"))
            (list (list :name "cli") (list :body "specs, argv, help"))
            (list (list :name "highlight") (list :body "source colouring"))
            (list (list :name "doc") (list :body "extract and render"))))
        (list :std-items
          (list
            (list (list :name "events") (list :body "Unibus observe and publish"))
            (list (list :name "records") (list :body "typed records and writes"))
            (list (list :name "time") (list :body "host wall clock"))
            (list (list :name "perf") (list :body "counters and timing"))))))

    (list :examples
      (list
        (list :title "Real programs.")
        (list :body "These are Soil views, mounted inline. No app shell around them.")
        (list :items
          (list
            (list (list :slug "todo") (list :title "TODO") (list :body "A list with state and actions."))
            (list (list :slug "counter") (list :title "Counter") (list :body "The smallest complete UI."))
            (list (list :slug "calculator") (list :title "Calculator") (list :body "Forms and dispatch."))
            (list (list :slug "tictactoe") (list :title "Tic-tac-toe") (list :body "A board and a winner."))
            (list (list :slug "tabs") (list :title "Tabs") (list :body "Local state, no router."))
            (list (list :slug "form") (list :title "Form") (list :body "Inputs and validation."))))))

    (list :closing
      (list
        (list :title "The site is Soil too.")
        (list :body "This page, the getting-started guide, and the inline examples are Soil views. The build writes HTML. No client framework is required.")
        (list :compiler-label "Compiler")
        (list :core-link-label "Core")
        (list :examples-link-label "Examples")
        (list :loam-label "Loam")))

    (list :guide
      (list
        (list :kicker "GET STARTED")
        (list :title "Get started with Soil")
        (list :lede "Get the compiler, run a program, then try the examples.")
        (list :build-title "1. Get the compiler")
        (list :build-body "The bootstrap compiler lives in ajmwagar/soil-rust. Point SOIL_LANG at it:")
        (list :build-code "export SOIL_LANG=/path/to/soil-lang")
        (list :run-title "2. Run a file")
        (list :run-body "Create hello.soil:")
        (list :hello-code "(defun main ()\n  (println \"hello from Soil\"))")
        (list :run-code "$SOIL_LANG hello.soil")
        (list :run-note "Any compatible Soil host can run the compiled module.")
        (list :examples-title "3. Try the examples")
        (list :examples-body "The examples cover core, std, and UI programs.")
        (list :examples-site-label "Examples on soil-lang.org")
        (list :examples-repo-label "examples")
        (list :next-title "Next")
        (list :next-language-label "Language")
        (list :next-architecture-label "LOAM")
        (list :next-api-label "API docs")
        (list :home-label "Home")))

    (list :footer
      (list
        (list :left "Soil · soil-lang.org")
        (list :license "MIT OR Apache-2.0")))))

;;; Read one section or one key inside a section from `site-copy`.
(defun copy (section key)
  (field (field site-copy section) key))

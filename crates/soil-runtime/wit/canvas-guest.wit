// The world a component guest targets on the device runtime.
//
// This is the same `soil:present/surface` the desktop presenter binds; the
// runtime lowering it through the component model is what makes one Spore run
// on both. A guest may deliver either encoded pixels or a texture.
package soil:canvas-guest@0.1.0;

world canvas-guest {
  import soil:present/surface@0.1.0;

  /// Render one frame, present it, and report a status code.
  export run: func() -> u32;
}

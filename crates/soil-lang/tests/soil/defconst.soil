(defconst LIMIT 3)
(defconst GREETING "hello")
(defconst DERIVED (+ LIMIT 1))

(defun under-limit? (n)
  (< n LIMIT))

(defun derived-value ()
  DERIVED)

(defun test/const-value ()
  (= LIMIT 3))

(defun test/const-in-function ()
  (and (under-limit? 2) (not (under-limit? 4))))

(defun test/const-expression ()
  (= (derived-value) 4))

(defun test/const-string ()
  (= GREETING "hello"))

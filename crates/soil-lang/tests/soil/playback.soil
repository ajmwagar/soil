; SPDX-License-Identifier: MIT OR Apache-2.0
; Playback URL/body builders, without a bridge or a provider token.

(defun test/playback-source-trims-the-base ()
  (let ((source (deadwax/source "http://127.0.0.1:6601/")))
    (and
      (= (field source :kind) "deadwax")
      (= (field source :base) "http://127.0.0.1:6601"))))

(defun test/playback-encodes-a-query ()
  (and
    (= (playback/encode "aphex twin") "aphex+twin")
    (= (playback/encode "a&b") "a%26b")
    (= (playback/encode "a?b") "a%3Fb")))

(defun test/deadwax-search-path ()
  (= (deadwax/search-path "board of canada" 20)
     "/search?q=board+of+canada&limit=20"))

(defun test/spotify-uri-normalization ()
  (and
    (= (spotify/play-uri "https://open.spotify.com/track/abc")
       "spotify:track:abc")
    (= (spotify/play-uri "spotify:album:xyz") "spotify:album:xyz")))

(defun test/spotify-play-body ()
  (let ((track (spotify/play-body "https://open.spotify.com/track/abc")))
    (let ((album (spotify/play-body "spotify:album:xyz")))
      (and
        (= (field track :uris) (list "spotify:track:abc"))
        (= (field album :context_uri) "spotify:album:xyz")
        (nil? (field album :uris))))))

(defun test/spotify-device-query ()
  (and
    (= (spotify/with-device "/v1/me/player/play" nil)
       "/v1/me/player/play")
    (= (spotify/with-device "/v1/me/player/play" "pi")
       "/v1/me/player/play?device_id=pi")
    (= (spotify/with-device "/v1/me/player/volume?volume_percent=40" "pi")
       "/v1/me/player/volume?volume_percent=40&device_id=pi")))

(defun test/spotify-device-by-name ()
  (let ((devices
          (list
            (list (list :id "mac") (list :name "Mac"))
            (list (list :id "pi") (list :name "raspotify")))))
    (and
      (= (spotify/device-id-by-name devices "raspotify") "pi")
      (nil? (spotify/device-id-by-name devices "missing")))))

(defmacro unless (test body)
  `(if ,test nil ,body))

(defmacro values-of (items)
  `(list ,@items))

(defun double (value)
  (* value 2))

(defun test/backquote-basic ()
  (= `(a ,(+ 1 2) c) (list 'a 3 'c)))

(defun test/backquote-splice ()
  (= `(a ,@(list 1 2) b) (list 'a 1 2 'b)))

(defun test/backquote-nested ()
  (= `(a `(b ,(c))) (list 'a (list 'quasiquote (list 'b (list 'unquote (list 'c)))))))

(defun test/macro-unless ()
  (and
    (= (unless #f 42) 42)
    (nil? (unless #t 42))))

(defun test/macro-splice ()
  (= (values-of (1 2 3)) (list 1 2 3)))

(defun test/macroexpand ()
  (= (first (macroexpand '(unless #t 1))) 'if))

(defun test/macroexpand-one ()
  (= (first (macroexpand-1 '(unless #t 1))) 'if))

(defun test/gensym-is-unique ()
  (not (= (gensym) (gensym))))

(defun test/lambda-funcall ()
  (= (funcall (lambda (x) (+ x 1)) 2) 3))

(defun test/lambda-apply ()
  (= (apply (lambda (x) (* x 2)) (list 3)) 6))

(defun test/lambda-closure ()
  (let ((n 10))
    (= (funcall (lambda (x) (+ x n)) 5) 15)))

(defun test/function-designator ()
  (= (funcall #'double 4) 8))

(defun test/map-lambda ()
  (= (map (lambda (x) (* x x)) (list 1 2 3)) (list 1 4 9)))

; URL components, query strings, and joining.

(defun test/url-encode ()
  (and
    (= (url/encode "a b&c") "a%20b%26c")
    (= (url/encode-query "a b&c") "a+b%26c")
    (= (url/encode "é") "%C3%A9")
    (= (url/encode "safe-._~") "safe-._~")))

(defun test/url-decode ()
  (and
    (= (url/decode "a%20b%26c") "a b&c")
    (= (url/decode-query "a+b%26c") "a b&c")
    (= (url/decode "100%25") "100%")
    (= (url/decode "é") "é")))

(defun test/url-query ()
  (let ((query (url/query (list (list "q" "a b") (list "x" "1&2")))))
    (and
      (= query "q=a+b&x=1%262")
      (= (url/decode-query query) "q=a b&x=1&2"))))

(defun test/url-parse-query ()
  (let ((pairs (url/parse-query "q=a+b&x=1%262&empty=")))
    (and
      (= (length pairs) 3)
      (= (first (first pairs)) "q")
      (= (nth 1 (first pairs)) "a b")
      (= (nth 1 (nth 1 pairs)) "1&2")
      (= (nth 1 (nth 2 pairs)) ""))))

(defun test/url-with-query-and-join ()
  (and
    (= (url/with-query "https://example.com/a" (list (list "x" "1")))
       "https://example.com/a?x=1")
    (= (url/with-query "https://example.com/a?q=1" (list (list "x" "1")))
       "https://example.com/a?q=1&x=1")
    (= (url/join "https://example.com/" "/a/b") "https://example.com/a/b")
    (= (url/join "https://example.com" "a") "https://example.com/a")))

(defun test/url-valid ()
  (and
    (url/valid? "https://example.com/x")
    (url/valid? "http://192.168.1.1:8080")
    (not (url/valid? "ftp://example.com"))
    (not (url/valid? "https:///x"))
    (not (url/valid? "example.com"))))

; SPDX-License-Identifier: MIT OR Apache-2.0
(defun inc (n) (+ n 1))
(defun even? (n) (or (= n 2) (= n 4)))
(defun over-two? (n) (> n 2))

(defun test/map ()
  (= (map (quote inc) (list 1 2 3)) (list 2 3 4)))

(defun test/filter ()
  (= (filter (quote even?) (list 1 2 3 4)) (list 2 4)))

(defun test/any ()
  (any? (quote over-two?) (list 1 2 3)))

(defun under-three? (n) (< n 3))

(defun test/take-while ()
  (= (take-while 'under-three? (list 1 2 3 1)) (list 1 2)))

(defun test/drop-while ()
  (= (drop-while 'under-three? (list 1 2 3 1)) (list 3 1)))

(defun test/last-of ()
  (= (last-of (list 1 2 3)) 3))

(defun test/append ()
  (= (append (list 1 2) (list 3 4)) (list 1 2 3 4)))

(defun test/assoc-all ()
  (let ((record (list (list :a 1) (list :b 2))))
    (= (json-encode (assoc-all record (list (list :b 3) (list :c 4))))
       "{\"a\":1,\"b\":3,\"c\":4}")))

(defun test/json-object ()
  (= (json-encode (json-object)) "{}"))

(defun test/json-empty-object ()
  (= (json-encode (json-decode "{}")) "{}"))

(defun test/keyword ()
  (= (json-encode (list (list (keyword "k") 1))) "{\"k\":1}"))

(defun test/int ()
  (= (int 3.9) 3))

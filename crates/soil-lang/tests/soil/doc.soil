; Doc-comment extraction and projection.

(defun test/doc-extract ()
  (let ((source (str
                  ";;; Add one.\n"
                  "(defun add1 (x) (+ x 1))\n"
                  "(defun internal (x) x)\n")))
    (let ((all (doc-extract source))
          (public (doc-extract-public source)))
      (and
        (= (length all) 2)
        (= (length public) 1)
        (= (field (first public) :name) "add1")
        (= (field (first public) :signature) "(defun add1 (x))")
        (= (field (first public) :doc) "Add one.")))))

(defun test/doc-markdown ()
  (let ((source (str
                  ";;; Add one.\n"
                  ";;; Returns `x + 1`.\n"
                  "(defun add1 (x) (+ x 1))\n")))
    (let ((markdown (doc-page-markdown "Prelude" "Small helpers." (doc-extract-public source))))
      (and
        (string-contains? markdown "# Prelude")
        (string-contains? markdown "## `add1`")
        (string-contains? markdown "(defun add1 (x))")
        (string-contains? markdown "Returns `x + 1`.")))))

(defun test/doc-inline ()
  (let ((html (render-html (el "p" nil (doc-prose "Use `el` here.")))))
    (and
      (string-contains? html "<code>el</code>")
      (string-contains? html "Use "))))

(defun test/doc-llms-index ()
  (let ((pages (list
                 (list
                   (list :slug "ui")
                   (list :title "UI forms")
                   (list :summary "Forms.")))))
    (let ((index (doc-index-markdown "Soil" pages)))
      (and
        (string-contains? index "# Soil")
        (string-contains? index "https://soil-lang.org/docs/ui.md")
        (string-contains? index "https://soil-lang.org/llms-full.txt")))))

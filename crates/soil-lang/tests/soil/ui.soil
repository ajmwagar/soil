; UI forms, HTML escaping, and the Soil highlighter.

(defun test/ui-escape ()
  (= (render-html (el "p" (list (attr :class "a&b")) (list (txt "x < y & z"))))
     "<p class=\"a&amp;b\">x &lt; y &amp; z</p>"))

(defun test/ui-void-and-fragment ()
  (and
    (= (render-html (el "input" (list (attr :name "x") (attr :disabled #t)) nil))
       "<input name=\"x\" disabled>")
    (= (render-html (list (el "b" nil (list (txt "1"))) (txt "2")))
       "<b>1</b>2")))

(defun test/ui-page ()
  (let ((page (render-page "A < B" "body { color: red; }" (txt "hello"))))
    (and
      (string-contains? page "<!doctype html>")
      (string-contains? page "<title>A &lt; B</title>")
      (string-contains? page "body { color: red; }")
      (string-contains? page "hello"))))

(defun test/ui-highlight ()
  (let ((html (render-html
                (code-block "(defun view (state)\n  (el \"div\" nil (list (txt \"hi\"))))\n; note\n"))))
    (and
      (string-contains? html "tok-special")
      (string-contains? html "tok-fn")
      (string-contains? html "tok-string")
      (string-contains? html "tok-comment"))))

(defun test/ui-string-primitives ()
  (and
    (= (string-replace "a-b-a" "a" "x") "x-b-x")
    (= (string-join (list "a" "b") "-") "a-b")
    (= (string-chars "ab") (list "a" "b"))))

(defun test/ui-components-card-and-table ()
  (let ((html
          (render-html
            (ui/card "Status" "All systems"
              (list
                (ui/table
                  (list "Name" "State")
                  (list (list "lights" "ok") (list "music" "paused"))))))))
    (and
      (string-contains? html "ui-card")
      (string-contains? html "Status")
      (string-contains? html "<th scope=\"col\">Name</th>")
      (string-contains? html "<td>lights</td>"))))

(defun test/ui-components-form ()
  (let ((html
          (render-html
            (ui/form "/save" "post"
              (list
                (ui/field "Name" (ui/input "name" "Avery" "Your name" nil) "Shown on the wall")
                (ui/field "Room" (ui/select "room"
                                  (list (list "living" "Living room")
                                        (list "kitchen" "Kitchen"))
                                  "living")
                          nil)
                (ui/button "Save" "save" "primary"))))))
    (and
      (string-contains? html "action=\"/save\"")
      (string-contains? html "method=\"post\"")
      (string-contains? html "name=\"name\"")
      (string-contains? html "value=\"Avery\"")
      (string-contains? html "<option value=\"living\" selected>Living room</option>")
      (string-contains? html "data-action=\"save\"")
      (string-contains? html "ui-button-primary"))))

(defun test/ui-components-cover-and-sparkline ()
  (let ((cover (render-html (ui/cover "cover.jpg" "Album" "AB")))
        (fallback (render-html (ui/cover nil "Album" "AB")))
        (spark (render-html (ui/sparkline (list 1 4 2 8) 100 30))))
    (and
      (string-contains? cover "ui-cover-fallback")
      (string-contains? cover "<img")
      (string-contains? cover "src=\"cover.jpg\"")
      (not (string-contains? fallback "<img"))
      (string-contains? fallback ">AB<")
      (string-contains? spark "<svg")
      (string-contains? spark "<polyline")
      (string-contains? spark "points=\""))))

(defun test/ui-components-states ()
  (let ((empty (render-html (ui/empty "Nothing here" "Come back later")))
        (error (render-html (ui/error-state "Offline" "Bridge unreachable")))
        (progress (render-html (ui/progress 50 100)))
        (skeleton (render-html (ui/skeleton 3))))
    (and
      (string-contains? empty "ui-empty")
      (string-contains? error "ui-error-state")
      (string-contains? progress "role=\"progressbar\"")
      (string-contains? progress "width:50%")
      (string-contains? skeleton "ui-skeleton-line"))))

(defun test/ui-base-css ()
  (let ((css (ui/base-css)))
    (and
      (string-contains? css ".ui-card")
      (string-contains? css ".ui-cover")
      (string-contains? css ".ui-sparkline")
      (string-contains? css "@media (prefers-reduced-motion:reduce)"))))

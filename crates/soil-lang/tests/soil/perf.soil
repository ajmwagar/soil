(defun perf-test-id (x) x)

(defun test/runtime-stats ()
  (let ((stats (runtime-stats)))
    (and (> (field stats :evals) 0)
         (>= (field stats :host_calls) 0)
         (>= (field stats :elapsed_ms) 0))))

(defun test/perf-measure ()
  (let ((result (perf/measure "id" 'perf-test-id (list 7))))
    (and (= (field result :name) "id")
         (= (field result :value) 7)
         (>= (field result :ms) 0))))

(defun test/perf-bench ()
  (let ((result (perf/bench 'perf-test-id (list 1) 3)))
    (and (= (field result :runs) 3)
         (>= (field result :total_ms) 0)
         (>= (field result :mean_ms) 0))))

(defun test/perf-eval ()
  (let ((result (perf/eval "(+ 1 2)")))
    (and (= (field result :value) 3)
         (>= (field result :ms) 0))))

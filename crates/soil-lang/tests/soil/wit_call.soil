(defun test/wit-call ()
  (let ((clock (value (soil:time/wall-clock))))
    (let ((now (field clock :unix-ms)))
      (let ((entry (make-entry
                     "test:wit"
                     "hello"
                     "test.wit.v1"
                     (list (list :message "called from Soil")
                           (list :unix_ms now))
                     now)))
        (let ((write (soil:records/upsert entry)))
          (let ((read (soil:records/get (record-key "test:wit" "hello"))))
            (and (ok? write)
                 (ok? read)
                 (= (field (entry-body (value read)) :message)
                    "called from Soil"))))))))

(defun test/boot-arithmetic ()
  (= (boot/eval '(+ 1 2) '()) 3))

(defun test/boot-if ()
  (eq (boot/eval '(if (= 1 1) 'yes 'no) '()) 'yes))

(defun test/boot-lambda ()
  (= (boot/eval '((lambda (x) (+ x 1)) 4) '()) 5))

(defun test/boot-let ()
  (= (boot/eval '(let ((x 2) (y 3)) (* x y)) '()) 6))

(defun test/boot-cond ()
  (eq (boot/eval '(cond ((= 1 2) 'no) (else 'yes)) '()) 'yes))

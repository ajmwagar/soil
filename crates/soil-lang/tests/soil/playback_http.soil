; Playback requests, asserted against the harness' deterministic HTTP echo.

(defun test/deadwax-search-request ()
  (let ((result
          (deadwax/search
            (deadwax/source "http://deadwax.local/")
            "aphex twin"
            20)))
    (and
      (ok? result)
      (= (field (value result) :url)
         "http://deadwax.local/search?q=aphex+twin&limit=20")
      (= (field (value result) :method) "get"))))

(defun test/deadwax-next-request ()
  (let ((result
          (playback/control
            (deadwax/source "http://deadwax.local")
            "next"
            nil)))
    (and
      (ok? result)
      (= (field (value result) :url) "http://deadwax.local/mpd/next")
      (= (field (value result) :method) "post"))))

(defun test/spotify-volume-request ()
  (let ((result
          (playback/control
            (spotify/source "default" "pi")
            "volume"
            40)))
    (and
      (ok? result)
      (= (field (value result) :url)
         "https://api.spotify.com/v1/me/player/volume?volume_percent=40&device_id=pi")
      (= (field (value result) :method) "put"))))

(defun test/spotify-play-body ()
  (let ((result
          (playback/control
            (spotify/source "default" nil)
            "play"
            "spotify:album:xyz")))
    (and
      (ok? result)
      (= (field (value result) :url)
         "https://api.spotify.com/v1/me/player/play")
      (= (field (value result) :method) "put")
      (string-contains? (field (value result) :body) "context_uri")
      (string-contains? (field (value result) :body) "spotify:album:xyz"))))

; SPDX-License-Identifier: MIT OR Apache-2.0
; Soil bootstrap: the first evaluator written in Soil.
;
; This is the seed of Phase 7, not the finished self-host. The Rust host still
; provides the reader, GC, and primitive values; this file defines environments,
; binding, a metacircular evaluator, and a small primitive dispatcher.
;
; Bootstrap stages:
;   1. environments: lookup + bind
;   2. list evaluation: eval-list + eval-body
;   3. special forms: let + cond
;   4. application: lambda detection + bind + dispatch
;   5. evaluator: boot/eval
;   6. primitive table (the current native floor)
;
; Stage 0 primitives expected from Rust:
;   quote if cond let lambda begin
;   atom symbol? eq cons car cdr list
;   + - * / = < > nil? first rest
;
; Everything below is ordinary Soil.

;;; Environments ---------------------------------------------------------
; An environment is an association list of (name value) pairs.

(defun boot/lookup (name env)
  (cond
    ((nil? env) nil)
    ((eq (first (first env)) name) (first (rest (first env))))
    (else (boot/lookup name (rest env)))))

(defun boot/bind (names values env)
  (if (nil? names)
      env
      (boot/bind (rest names)
                 (rest values)
                 (cons (list (first names) (first values)) env))))

;;; Lists ----------------------------------------------------------------

(defun boot/eval-list (exprs env)
  (if (nil? exprs)
      nil
      (cons (boot/eval (first exprs) env)
            (boot/eval-list (rest exprs) env))))

(defun boot/eval-body (body env)
  (if (nil? body)
      nil
      (if (nil? (rest body))
          (boot/eval (first body) env)
          (begin
            (boot/eval (first body) env)
            (boot/eval-body (rest body) env)))))

;;; Special forms --------------------------------------------------------

(defun boot/eval-let (bindings body env)
  (if (nil? bindings)
      (boot/eval body env)
      (let ((binding (first bindings)))
        (boot/eval-let (rest bindings)
                       body
                       (cons (list (first binding)
                                   (boot/eval (first (rest binding)) env))
                             env)))))

(defun boot/evcon (clauses env)
  (cond
    ((nil? clauses) nil)
    ((or (eq (first (first clauses)) 'else)
         (boot/eval (first (first clauses)) env))
     (boot/eval (first (rest (first clauses))) env))
    (else (boot/evcon (rest clauses) env))))

;;; Application ----------------------------------------------------------

(defun boot/lambda? (value)
  (and (not (atom value)) (eq (first value) 'lambda)))

(defun boot/apply (fn args)
  (if (boot/lambda? fn)
      (boot/eval-body (rest (rest fn))
                      (boot/bind (first (rest fn)) args '()))
      (boot/primitive fn args)))

(defun boot/primitive? (value)
  (or (eq value '+)
      (eq value '-)
      (eq value '*)
      (eq value '/)
      (eq value '=)
      (eq value '<)
      (eq value '>)
      (eq value 'atom)
      (eq value 'eq)
      (eq value 'cons)
      (eq value 'car)
      (eq value 'cdr)
      (eq value 'first)
      (eq value 'rest)
      (eq value 'list)))

(defun boot/primitive (fn args)
  (cond
    ((eq fn '+) (+ (first args) (first (rest args))))
    ((eq fn '-) (- (first args) (first (rest args))))
    ((eq fn '*) (* (first args) (first (rest args))))
    ((eq fn '/) (/ (first args) (first (rest args))))
    ((eq fn '=) (= (first args) (first (rest args))))
    ((eq fn '<) (< (first args) (first (rest args))))
    ((eq fn '>) (> (first args) (first (rest args))))
    ((eq fn 'atom) (atom (first args)))
    ((eq fn 'eq) (eq (first args) (first (rest args))))
    ((eq fn 'cons) (cons (first args) (first (rest args))))
    ((eq fn 'car) (car (first args)))
    ((eq fn 'cdr) (cdr (first args)))
    ((eq fn 'first) (first (first args)))
    ((eq fn 'rest) (rest (first args)))
    ((eq fn 'list) args)
    (else (list :error fn))))

;;; Evaluator ------------------------------------------------------------

(defun boot/eval (expr env)
  (cond
    ((atom expr)
     (if (symbol? expr)
         (let ((value (boot/lookup expr env)))
           (if (nil? value)
               (if (boot/primitive? expr) expr nil)
               value))
         expr))
    ((eq (first expr) 'quote) (first (rest expr)))
    ((eq (first expr) 'if)
     (if (boot/eval (first (rest expr)) env)
         (boot/eval (first (rest (rest expr))) env)
         (boot/eval (first (rest (rest (rest expr)))) env)))
    ((eq (first expr) 'cond) (boot/evcon (rest expr) env))
    ((eq (first expr) 'let)
     (boot/eval-let (first (rest expr))
                    (first (rest (rest expr)))
                    env))
    ((eq (first expr) 'lambda) expr)
    ((eq (first expr) 'begin) (boot/eval-body (rest expr) env))
    (else
     (boot/apply (boot/eval (first expr) env)
                 (boot/eval-list (rest expr) env)))))

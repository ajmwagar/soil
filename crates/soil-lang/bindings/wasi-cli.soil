; Standard command-line inputs.
;
; The host owns argv. On native, `soil-lang` fills it from the tokens after
; `--`; in a WASI command component the same values come from
; `wasi:cli/environment.get-arguments`.

;;; Return the command arguments, including argv[0] when the host provides it.
(defun cli-args ()
  (argv))

; SPDX-License-Identifier: MIT OR Apache-2.0
; UTC date and time helpers.
;
; Soil's only built-in civil-date primitive is `date-string` (epoch seconds to
; `YYYY-MM-DD`). This module adds the rest of the small vocabulary a UI needs:
; time of day, ISO timestamps, day boundaries, date parsing, weekday, and
; relative labels. Everything is UTC; a host that wants local time should pass
; an offset explicitly rather than guessing from the machine.

;;; Floor division for integers. Soil's `/` is float division, so negative
;;; epochs need an explicit floor before the remainder is taken.
(defun date/floor-div (a b)
  (let ((q (int (/ a b))))
    (if (and (< a 0) (not (= (* q b) a)))
        (- q 1)
        q)))

;;; Non-negative remainder paired with [[date/floor-div]].
(defun date/mod (a b)
  (- a (* (date/floor-div a b) b)))

(defun date/pad2 (n)
  (let ((n (int n)))
    (if (< n 10) (str "0" n) (str n))))

(defun date/pad4 (n)
  (let ((n (int n)))
    (cond
      ((< n 10) (str "000" n))
      ((< n 100) (str "00" n))
      ((< n 1000) (str "0" n))
      (else (str n)))))

;;; Convert Unix milliseconds to whole Unix seconds.
(defun date/seconds (ms)
  (date/floor-div ms 1000))

;;; Convert whole Unix seconds to Unix milliseconds.
(defun date/ms (seconds)
  (* seconds 1000))

;;; The UTC calendar date of `ms`, as `YYYY-MM-DD`.
(defun date/date (ms)
  (date-string (date/seconds ms)))

;;; The UTC time of day of `ms`, as `HH:MM:SS`.
(defun date/time (ms)
  (let ((seconds (date/mod (date/seconds ms) 86400)))
    (str
      (date/pad2 (date/floor-div seconds 3600)) ":"
      (date/pad2 (date/floor-div (date/mod seconds 3600) 60)) ":"
      (date/pad2 (date/mod seconds 60)))))

;;; A readable UTC timestamp: `YYYY-MM-DD HH:MM:SS UTC`.
(defun date/format (ms)
  (str (date/date ms) " " (date/time ms) " UTC"))

;;; An ISO-8601 UTC timestamp with second precision.
(defun date/iso (ms)
  (str (date/date ms) "T" (date/time ms) "Z"))

;;; Midnight UTC on the calendar day containing `ms`.
(defun date/start-of-day (ms)
  (* (date/floor-div (date/seconds ms) 86400) 86400000))

;;; Add whole UTC days to a millisecond timestamp.
(defun date/add-days (ms days)
  (+ ms (* days 86400000)))

;;; Day of week for `ms`: 0 = Sunday, 1 = Monday, ... 6 = Saturday.
(defun date/weekday (ms)
  (date/mod (+ 4 (date/floor-div (date/seconds ms) 86400)) 7))

;;; Human weekday name for `ms`.
(defun date/weekday-name (ms)
  (let ((day (date/weekday ms)))
    (cond
      ((= day 0) "Sunday")
      ((= day 1) "Monday")
      ((= day 2) "Tuesday")
      ((= day 3) "Wednesday")
      ((= day 4) "Thursday")
      ((= day 5) "Friday")
      (else "Saturday"))))

(defun date/leap? (year)
  (and
    (= (date/mod year 4) 0)
    (or (not (= (date/mod year 100) 0)) (= (date/mod year 400) 0))))

(defun date/days-in-month (year month)
  (cond
    ((= month 2) (if (date/leap? year) 29 28))
    ((or (= month 4) (= month 6) (= month 9) (= month 11)) 30)
    (else 31)))

(defun date/digit (character)
  (cond
    ((= character "0") 0)
    ((= character "1") 1)
    ((= character "2") 2)
    ((= character "3") 3)
    ((= character "4") 4)
    ((= character "5") 5)
    ((= character "6") 6)
    ((= character "7") 7)
    ((= character "8") 8)
    ((= character "9") 9)
    (else nil)))

(defun date/digits (characters value)
  (if (nil? characters)
      value
      (let ((digit (date/digit (first characters))))
        (if (nil? digit)
            nil
            (date/digits (rest characters) (+ (* value 10) digit))))))

(defun date/part (characters width)
  (date/digits (take width characters) 0))

;;; Howard Hinnant's days-from-civil inverse. Returns days since 1970-01-01.
(defun date/days-from-civil (year month day)
  (let ((year (if (<= month 2) (- year 1) year)))
    (let ((era (date/floor-div year 400)))
      (let ((yoe (- year (* era 400))))
        (let ((mp (if (> month 2) (- month 3) (+ month 9))))
          (let ((doy (+ (date/floor-div (+ (* 153 mp) 2) 5) (- day 1))))
            (let ((doe (+ (* yoe 365)
                          (date/floor-div yoe 4)
                          (- 0 (date/floor-div yoe 100))
                          doy)))
              (- (+ (* era 146097) doe) 719468))))))))

;;; Parse `YYYY-MM-DD` as UTC midnight, returning `(ok milliseconds)` or
;;; `(err "date: ...")`. The parser is deliberately strict about the shape and
;;; about a real calendar day; it does not guess a timezone.
(defun date/parse-date (text)
  (let ((characters (string-chars text)))
    (if (or (nil? characters) (not (= (length characters) 10)))
        (list 'err (str "date: " text " is not YYYY-MM-DD"))
        (if (not (and
                   (= (nth 4 characters) "-")
                   (= (nth 7 characters) "-")))
            (list 'err (str "date: " text " is not YYYY-MM-DD"))
            (let ((year (date/part characters 4))
                  (month (date/part (drop 5 characters) 2))
                  (day (date/part (drop 8 characters) 2)))
              (cond
                ((or (nil? year) (nil? month) (nil? day))
                  (list 'err (str "date: " text " has a non-digit")))
                ((or (< month 1) (> month 12))
                  (list 'err (str "date: " text " has no such month")))
                ((or (< day 1) (> day (date/days-in-month year month)))
                  (list 'err (str "date: " text " has no such day")))
                (else
                  (list 'ok
                    (* (date/days-from-civil year month day) 86400000))))))))))

(defun date/relative-value (value diff unit)
  (if (< diff 0)
      (str "in " value unit)
      (str value unit " ago")))

;;; A compact relative label: `just now`, `5m ago`, `in 2h`, `3d ago`, or the
;;; calendar date once the distance is a week or more.
(defun date/relative (now-ms then-ms)
  (let ((diff (- now-ms then-ms)))
    (let ((distance (if (< diff 0) (- 0 diff) diff)))
      (cond
        ((< distance 60000) "just now")
        ((< distance 3600000)
          (date/relative-value (date/floor-div distance 60000) diff "m"))
        ((< distance 86400000)
          (date/relative-value (date/floor-div distance 3600000) diff "h"))
        ((< distance 604800000)
          (date/relative-value (date/floor-div distance 86400000) diff "d"))
        (else (date/date then-ms))))))

; SPDX-License-Identifier: MIT OR Apache-2.0
; Call two host WITs from Soil: soil:time and soil:records.
; Run with:
;   soil-lang --prelude stdlib/prelude.soil \
;     --records-root /tmp/r --book soil \
;     bindings/soil-time.soil bindings/soil-records.soil \
;     examples/wit_call.soil

(defun main ()
  (let ((clock (value (soil:time/wall-clock))))
    (let ((now (field clock :unix-ms)))
      (let ((entry (make-entry
                     "demo:wit"
                     "hello"
                     "demo.wit.v1"
                     (list (list :message "called from Soil")
                           (list :unix_ms now))
                     now)))
        (let ((write (soil:records/upsert entry)))
          (let ((read (soil:records/get (record-key "demo:wit" "hello"))))
            (list (list :time now)
                  (list :write-ok (ok? write))
                  (list :read (entry-body (value read))))))))))

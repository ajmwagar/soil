; SPDX-License-Identifier: MIT OR Apache-2.0
; Extract doc comments and project them into Markdown.
;
; A doc comment is a run of lines beginning with `;;;` immediately before a
; top-level `defun`, `defmacro`, or `defspore`:
;
;   ;;; Build a UI form from a tag, attributes, and children.
;   ;;; `attrs` is a list of `(attr key value)` pairs.
;   (defun el (tag attrs children) ...)
;
; The first line is the summary. The rest is Markdown and is copied unchanged
; into generated docs. Extraction is deliberately source-oriented: it uses the
; same characters a human reads, so a formatter or editor cannot desync a doc
; comment from its form.

(defun doc-space? (character)
  (or
    (= character " ")
    (= character "\n")
    (= character "\r")
    (= character "\t")))

(defun doc-symbol-char? (character)
  (not
    (or
      (doc-space? character)
      (= character "(")
      (= character ")"))))

(defun doc-prefix? (chars prefix)
  (cond
    ((nil? prefix) #t)
    ((nil? chars) #f)
    ((= (first chars) (first prefix))
      (doc-prefix? (rest chars) (rest prefix)))
    (else #f)))

(defun doc-starts-with? (text prefix)
  (doc-prefix? (string-chars text) (string-chars prefix)))

(defun doc-trim-left (text)
  (string-join (drop-while 'doc-space? (string-chars text)) ""))

(defun doc-trim-right (text)
  (if (= text "")
      ""
      (string-join (reverse (drop-while 'doc-space? (reverse (string-chars text)))) "")))

(defun doc-trim (text)
  (doc-trim-left (doc-trim-right text)))

(defun doc-drop-chars (n text)
  (string-join (drop n (string-chars text)) ""))

(defun doc-not-newline? (character)
  (not (= character "\n")))

(defun doc-lines-scan (chars out)
  (if (or (nil? chars) (= (length chars) 0))
      (reverse out)
      (let ((line (take-while 'doc-not-newline? chars)))
        (let ((rest-chars (drop (if (nil? line) 0 (length line)) chars)))
          (let ((next (if (and
                            (not (nil? rest-chars))
                            (= (first rest-chars) "\n"))
                          (rest rest-chars)
                          rest-chars)))
            (doc-lines-scan next (cons (string-join line "") out)))))))

(defun doc-lines (text)
  (doc-lines-scan (string-chars text) nil))

(defun doc-comment-line (line)
  (let ((trimmed (doc-trim-left line)))
    (if (doc-starts-with? trimmed ";;;")
        (doc-trim-left (doc-drop-chars 3 trimmed))
        nil)))

(defun doc-kind (line)
  (let ((trimmed (doc-trim-left line)))
    (cond
      ((doc-starts-with? trimmed "(defun ") "defun")
      ((doc-starts-with? trimmed "(defmacro ") "defmacro")
      ((doc-starts-with? trimmed "(defspore ") "defspore")
      (else nil))))

(defun doc-name (line)
  (let ((kind (doc-kind line)))
    (if (nil? kind)
        ""
        (let ((after (doc-drop-chars (+ (length (string-chars kind)) 2) (doc-trim-left line))))
          (string-join (take-while 'doc-symbol-char? (string-chars after)) "")))))

; Scan a line, returning `(depth in-string)`. Comments run to end of line.
(defun doc-scan-line (chars depth in-string)
  (cond
    ((or (nil? chars) (= (length chars) 0)) (list depth in-string))
    ((= (first chars) ";") (list depth in-string))
    (in-string
      (cond
        ((= (first chars) "\\")
          (if (nil? (rest chars))
              (list depth in-string)
              (doc-scan-line (rest (rest chars)) depth #t)))
        ((= (first chars) "\"")
          (doc-scan-line (rest chars) depth #f))
        (else
          (doc-scan-line (rest chars) depth #t))))
    ((= (first chars) "\"")
      (doc-scan-line (rest chars) depth #t))
    ((= (first chars) "(")
      (doc-scan-line (rest chars) (+ depth 1) #f))
    ((= (first chars) ")")
      (doc-scan-line (rest chars) (- depth 1) #f))
    (else
      (doc-scan-line (rest chars) depth #f))))

(defun doc-form-end (lines index depth)
  (if (nil? lines)
      index
      (let ((next (first (doc-scan-line (string-chars (first lines)) depth #f))))
        (if (<= next 0)
            index
            (doc-form-end (rest lines) (+ index 1) next)))))

; Take a balanced parenthesized run starting at `chars`, including the parens.
(defun doc-paren-run (chars depth in-string out)
  (cond
    ((or (nil? chars) (= (length chars) 0)) (reverse out))
    (in-string
      (cond
        ((= (first chars) "\\")
          (if (nil? (rest chars))
              (reverse (cons (first chars) out))
              (doc-paren-run
                (rest (rest chars))
                depth
                #t
                (cons (first (rest chars)) (cons (first chars) out)))))
        ((= (first chars) "\"")
          (doc-paren-run (rest chars) depth #f (cons (first chars) out)))
        (else
          (doc-paren-run (rest chars) depth #t (cons (first chars) out)))))
    ((= (first chars) "\"")
      (doc-paren-run (rest chars) depth #t (cons (first chars) out)))
    ((= (first chars) "(")
      (doc-paren-run (rest chars) (+ depth 1) #f (cons (first chars) out)))
    ((= (first chars) ")")
      (if (= depth 1)
          (reverse (cons (first chars) out))
          (doc-paren-run (rest chars) (- depth 1) #f (cons (first chars) out))))
    (else
      (doc-paren-run (rest chars) depth #f (cons (first chars) out)))))

(defun doc-skip-to-open (chars)
  (cond
    ((nil? chars) nil)
    ((= (first chars) "(") chars)
    (else (doc-skip-to-open (rest chars)))))

(defun doc-after-nth-open (chars n)
  (cond
    ((nil? chars) nil)
    ((= (first chars) "(")
      (if (<= n 1)
          chars
          (doc-after-nth-open (rest chars) (- n 1))))
    (else (doc-after-nth-open (rest chars) n))))

(defun doc-signature (source)
  (let ((first-line (doc-trim-left (first (doc-lines source)))))
    (let ((kind (doc-kind first-line)))
      (if (nil? kind)
          first-line
          (let ((name (doc-name first-line)))
            (let ((args-start (doc-after-nth-open (string-chars first-line) 2)))
              (let ((args (if (nil? args-start)
                              ""
                              (string-join (doc-paren-run args-start 0 #f nil) ""))))
                (str "(" kind " " name
                     (if (= args "") "" (str " " args))
                     ")"))))))))

(defun doc-entry (line form-lines doc)
  (let ((source (string-join form-lines "\n")))
    (list
      (list :name (doc-name line))
      (list :kind (doc-kind line))
      (list :signature (doc-signature source))
      (list :doc doc)
      (list :source source))))

(defun doc-extract-lines (lines pending entries)
  (if (nil? lines)
      (reverse entries)
      (let ((comment (doc-comment-line (first lines)))
            (kind (doc-kind (first lines))))
        (cond
          ((not (nil? comment))
            (doc-extract-lines (rest lines) (cons comment pending) entries))
          ((not (nil? kind))
            (doc-extract-lines
              (rest lines)
              nil
              (cons
                (doc-entry (first lines) (list (first lines))
                  (string-join (reverse pending) "\n"))
                entries)))
          (else
            (doc-extract-lines (rest lines) pending entries))))))

(defun doc-extract (source)
  (doc-extract-lines (doc-lines source) nil nil))

(defun doc-documented? (entry)
  (not (= (field entry :doc) "")))

(defun doc-extract-public (source)
  (filter 'doc-documented? (doc-extract source)))

(defun doc-entry-markdown (entry)
  (let ((name (field entry :name))
        (signature (field entry :signature))
        (doc (field entry :doc)))
    (str
      "## `" name "`\n\n"
      "```soil\n" signature "\n```\n\n"
      (if (= doc "")
          "_No doc comment yet._\n\n"
          (str doc "\n\n")))))

(defun doc-page-markdown (title summary entries)
  (str
    "# " title "\n\n"
    "> " summary "\n\n"
    "> Generated from Soil doc comments. Do not edit by hand.\n\n"
    (string-join (map 'doc-entry-markdown entries) "")))

(defun doc-index-markdown (project pages)
  (str
    "# " project "\n\n"
    "> Soil is a small homoiconic Lisp with typed host capabilities. These API\n"
    "> docs are generated from `;;;` doc comments in the standard library.\n\n"
    "## Documentation\n\n"
    (string-join (map 'doc-index-entry pages) "")
    "\n## Optional\n\n"
    "- [Full documentation](https://soil-lang.org/llms-full.txt)\n"
    "- [Sitemap](https://soil-lang.org/sitemap.xml)\n"))

(defun doc-docs-index-markdown (project pages)
  (str
    "# " project " API\n\n"
    "> Generated from `;;;` doc comments in Soil's standard library.\n"
    "> Each page is also available as raw Markdown for agents.\n\n"
    "## Standard library\n\n"
    (string-join (map 'doc-docs-index-entry pages) "")))

(defun doc-docs-index-entry (page)
  (str
    "- [" (field page :title) "](" (field page :slug) ".md): "
    (field page :summary) "\n"))

(defun doc-index-entry (page)
  (str
    "- [" (field page :title) "](https://soil-lang.org/docs/"
    (field page :slug) ".md): " (field page :summary) "\n"))

(defun doc-full-markdown (index pages)
  (str
    index
    "\n---\n\n"
    (string-join
      (map
        'doc-page-full
        pages)
      "\n---\n\n")))

(defun doc-page-full (page)
  (doc-page-markdown
    (field page :title)
    (field page :summary)
    (field page :entries)))

; Minimal Markdown for the human-readable docs page. The generated `.md` files
; remain the source of truth; this renderer handles paragraphs, headings,
; bullets, and inline code, which is what doc comments use.

(defun doc-not-backtick? (character)
  (not (= character "`")))

(defun doc-inline-scan (chars in-code out)
  (cond
    ((or (nil? chars) (= (length chars) 0)) (reverse out))
    ((= (first chars) "`")
      (doc-inline-scan (rest chars) (not in-code) out))
    (else
      (let ((run (take-while 'doc-not-backtick? chars)))
        (doc-inline-scan
          (drop (length run) chars)
          in-code
          (cons
            (if in-code
                (el "code" nil (list (txt (string-join run ""))))
                (txt (string-join run "")))
            out))))))

(defun doc-inline (text)
  (doc-inline-scan (string-chars text) #f nil))

(defun doc-prose-line (line)
  (let ((trimmed (doc-trim line)))
    (cond
      ((= trimmed "") (el "div" (list (attr :class "doc-gap")) nil))
      ((doc-starts-with? trimmed "### ")
        (el "h4" nil (list (txt (doc-drop-chars 4 trimmed)))))
      ((doc-starts-with? trimmed "## ")
        (el "h3" nil (list (txt (doc-drop-chars 3 trimmed)))))
      ((doc-starts-with? trimmed "- ")
        (el "ul" (list (attr :class "doc-list"))
          (list (el "li" nil (doc-inline (doc-drop-chars 2 trimmed))))))
      (else
        (el "p" nil (doc-inline trimmed))))))

(defun doc-prose (text)
  (map 'doc-prose-line (doc-lines text)))

(defun doc-entry-html (entry)
  (let ((name (field entry :name)))
    (el "section" (list (attr :class "doc-entry") (attr :id name))
      (list
        (el "h2" nil (list (txt name)))
        (code-block (field entry :signature))
        (el "div" (list (attr :class "doc-prose"))
          (doc-prose (field entry :doc)))))))

(defun doc-page-html (project page pages)
  (let ((title (field page :title))
        (summary (field page :summary))
        (slug (field page :slug))
        (entries (field page :entries)))
    (render-page
      (str title " · " project " API")
      (doc-html-styles)
      (el "div" (list (attr :class "docs"))
        (list
          (el "header" (list (attr :class "docs-head"))
            (list
              (el "a" (list (attr :href "index.html") (attr :class "docs-brand"))
                (list (txt (str project " API"))))
              (el "p" (list (attr :class "docs-summary"))
                (list (txt summary)))))
          (el "nav" (list (attr :class "docs-nav"))
            (list
              (el "a" (list (attr :href "index.html")) (list (txt "All pages")))))
          (el "main" (list (attr :class "docs-main"))
            (list
              (el "h1" nil (list (txt title)))
              (el "p" (list (attr :class "docs-lede")) (list (txt summary)))
              (el "ol" (list (attr :class "docs-toc"))
                (map 'doc-toc-item entries))
              (map 'doc-entry-html entries)))
          (el "footer" (list (attr :class "docs-foot"))
            (list
              (el "span" nil (list (txt (str slug ".md"))))
              (el "a" (list (attr :href (str slug ".md")))
                (list (txt "raw Markdown"))))))))))

(defun doc-toc-item (entry)
  (el "li" nil
    (list
      (el "a" (list (attr :href (str "#" (field entry :name))))
        (list (txt (field entry :name)))))))

(defun doc-index-html (project pages)
  (render-page
    (str project " API")
    (doc-html-styles)
    (el "div" (list (attr :class "docs"))
      (list
        (el "header" (list (attr :class "docs-head"))
          (list
            (el "a" (list (attr :href "index.html") (attr :class "docs-brand"))
              (list (txt (str project " API"))))
            (el "p" (list (attr :class "docs-summary"))
              (list (txt "Generated from `;;;` doc comments in the standard library.")))))
        (el "main" (list (attr :class "docs-main"))
          (list
            (el "h1" nil (list (txt "Standard library")))
            (el "p" (list (attr :class "docs-lede"))
              (list (txt "Each page is generated from the source it documents. Raw Markdown is available for agents.")))
            (el "ul" (list (attr :class "docs-pages"))
              (map 'doc-index-page pages))))
        (el "footer" (list (attr :class "docs-foot"))
          (list
            (el "a" (list (attr :href "../llms.txt")) (list (txt "llms.txt")))
            (el "a" (list (attr :href "../llms-full.txt")) (list (txt "llms-full.txt")))))))))

(defun doc-index-page (page)
  (el "li" nil
    (list
      (el "a" (list (attr :href (str (field page :slug) ".html")))
        (list (txt (field page :title))))
      (el "span" nil (list (txt (str " — " (field page :summary))))))))

(defun doc-html-styles ()
  (str
    "/* Hallmark · macrostructure: reference index · theme: warm charcoal · genre: editorial\n"
    " * pre-emit critique: P5 H4 E4 S4 R5 V3\n"
    " * slop test: pass\n"
    " */\n"
    ":root { color-scheme: dark; --bg:#14120f; --panel:#1b1814; --ink:#f1ece3; --muted:#b8afa1; --line:#3a342d; --accent:#d77b52; --font-display:ui-serif, Georgia, \"Times New Roman\", serif; --font-body:ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", sans-serif; --font-mono:ui-monospace, SFMono-Regular, Menlo, monospace; }\n"
    "html, body { overflow-x: clip; }\n"
    "* { box-sizing: border-box; }\n"
    "body { margin:0; background:var(--bg); color:var(--ink); font-family:var(--font-body); font-size:16px; line-height:1.65; }\n"
    "h1, h2, h3 { overflow-wrap:anywhere; min-width:0; }\n"
    "a { color:var(--accent); text-decoration:none; }\n"
    "a:hover { text-decoration:underline; }\n"
    ".docs { max-width: 900px; margin: 0 auto; padding: 32px 24px 80px; }\n"
    ".docs-head { display:flex; flex-wrap:wrap; justify-content:space-between; align-items:baseline; gap:12px 20px; padding-bottom:20px; border-bottom:1px solid var(--line); }\n"
    ".docs-brand { color:var(--ink); font-weight:700; letter-spacing:-.02em; }\n"
    ".docs-summary { color:var(--muted); font-size:13px; margin:0; }\n"
    ".docs-main { padding:36px 0; }\n"
    "h1 { font-family:var(--font-display); font-size:clamp(32px,6vw,54px); line-height:1.05; letter-spacing:-.04em; margin:0 0 12px; }\n"
    ".docs-lede { color:var(--muted); max-width:62ch; }\n"
    ".docs-toc { columns:2; gap:32px; padding-left:18px; color:var(--muted); }\n"
    ".docs-toc a { color:var(--ink); }\n"
    ".doc-entry { padding:34px 0; border-top:1px solid var(--line); }\n"
    ".doc-entry h2 { font-family:var(--font-mono); font-size:22px; margin:0 0 14px; }\n"
    ".doc-entry pre { background:var(--panel); border:1px solid var(--line); border-radius:12px; padding:16px; overflow:auto; }\n"
    ".doc-entry code { font-family:var(--font-mono); font-size:.9em; }\n"
    ".doc-prose p { margin:12px 0; }\n"
    ".doc-prose code { background:var(--panel); border:1px solid var(--line); border-radius:5px; padding:1px 5px; }\n"
    ".doc-gap { height:8px; }\n"
    ".doc-list { margin:8px 0; }\n"
    ".docs-foot { display:flex; flex-wrap:wrap; justify-content:space-between; gap:12px 16px; padding-top:24px; border-top:1px solid var(--line); color:var(--muted); font-family:var(--font-mono); font-size:12px; }\n"
    ".docs-pages { line-height:2; }\n"
    "@media (max-width: 600px) { .docs-toc { columns:1; } .docs { padding-left:18px; padding-right:18px; } }\n"))

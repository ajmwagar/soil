; SPDX-License-Identifier: MIT OR Apache-2.0
; JSON object helpers layered on `json-decode` and `json-encode`.
;
; Soil represents a decoded JSON object as a list of `(keyword value)` pairs,
; and an empty object as the private `json-object` marker. Arrays are ordinary
; lists. These helpers keep that representation explicit rather than hiding it
; behind a second object type.

; Known limitation: an empty JSON array decodes as `nil` in this value model, so
; `json/array?` cannot distinguish it from JSON null. Empty objects keep the
; `json-object` marker and do round-trip.

(defun json/empty-object? (value)
  (and (not (nil? value)) (= (first value) '__json_object__)))

(defun json/object? (value)
  (let ((text (json-encode value)))
    (let ((characters (string-chars text)))
      (and (not (nil? characters)) (= (first characters) "{")))))

(defun json/array? (value)
  (let ((text (json-encode value)))
    (let ((characters (string-chars text)))
      (and (not (nil? characters)) (= (first characters) "[")))))

(defun json/first (pair)
  (first pair))

(defun json/second (pair)
  (nth 1 pair))

;;; Return the keys of a decoded JSON object, in document order.
(defun json/keys (value)
  (if (json/empty-object? value)
      nil
      (map 'json/first value)))

;;; Return the values of a decoded JSON object, in document order.
(defun json/values (value)
  (if (json/empty-object? value)
      nil
      (map 'json/second value)))

(defun json/key-text (key)
  (string-replace (str key) ":" ""))

(defun json/key-is? (pair key)
  (= (first pair) key))

;;; Return true when `key` is present, even when its value is `nil`.
(defun json/has-key? (value key)
  (if (or (nil? value) (json/empty-object? value))
      #f
      (not (nil? (find-with 'json/key-is? key value)))))


;;; Read `key`, returning `fallback` when it is absent.
(defun json/get-or (value key fallback)
  (if (json/has-key? value key)
      (field value key)
      fallback))

;;; Shallow object merge; values in `right` win.
(defun json/merge (left right)
  (assoc-all left right))

;;; Deep object merge; nested objects are merged, other values from `right` win.
(defun json/deep-merge (left right)
  (if (nil? right)
      left
      (let ((pair (first right)))
        (let ((key (first pair))
              (value (nth 1 pair)))
          (json/deep-merge
            (assoc key
              (if (and (json/object? (field left key)) (json/object? value))
                  (json/deep-merge (field left key) value)
                  value)
              left)
            (rest right))))))

;;; Set a top-level key.
(defun json/set (value key item)
  (assoc key item value))

;;; Set a value at `keys`, creating missing objects along the way.
(defun json/set-in (value keys item)
  (if (nil? keys)
      item
      (let ((key (first keys)))
        (assoc key
          (json/set-in (field value key) (rest keys) item)
          value))))

;;; Remove a top-level key, preserving order.
(defun json/delete (value key)
  (if (or (nil? value) (json/empty-object? value))
      value
      (if (= (first (first value)) key)
          (rest value)
          (cons (first value) (json/delete (rest value) key)))))

(defun json/indent-unit (ignored) "  ")

(defun json/indent (level)
  (string-join (map 'json/indent-unit (range 0 level)) ""))

(defun json/pretty-pair (pair level)
  (str (json/indent (+ level 1))
       "\"" (json/key-text (first pair)) "\": "
       (json/pretty-value (nth 1 pair) (+ level 1))))

(defun json/pretty-value (value level)
  (cond
    ((json/object? value)
      (if (json/empty-object? value)
          "{}"
          (str "{\n"
               (string-join (map-with 'json/pretty-pair level value) ",\n")
               "\n" (json/indent level) "}")))
    ((json/array? value)
      (str "[\n"
           (string-join (map-with 'json/pretty-value (+ level 1) value) ",\n")
           "\n" (json/indent level) "]"))
    (else (json-encode value))))

;;; Pretty-print a decoded JSON value with two-space indentation.
(defun json/pretty (value)
  (json/pretty-value value 0))

; Soil UI forms and HTML rendering.
;
; A form is a record tree:
;
;   ((:tag "div") (:attrs ((:class "app"))) (:children (...)))
;   ((:text "hello"))
;   ((:raw "<span>...</span>"))
;
; This file owns the form constructors and the HTML serializer. Hosts that
; render to DOM, a native surface, or a GPU scene use the same forms; only
; `render-html` is specific to HTML.

;;; Build a UI form from a tag, attribute list, and child list.
;;;
;;; Attributes are `(attr key value)` pairs. Children may be forms, strings, lists of forms, or `nil`.
(defun el (tag attrs children)
  (list
    (list :tag tag)
    (list :attrs attrs)
    (list :children children)))

;;; Build one attribute pair for `el`.
(defun attr (key value)
  (list key value))

;;; Wrap a value as an escaped text node.
(defun txt (value)
  (list (list :text (str value))))

;; Explicit escape hatch for pre-rendered markup. Never pass untrusted input.
;;; Wrap pre-rendered HTML without escaping.
;;;
;;; This is an explicit escape hatch. Never pass untrusted input.
(defun raw (html)
  (list (list :raw (str html))))

;;; Escape `&`, `<`, and `>` for HTML text.
(defun html-escape (text)
  (string-replace
    (string-replace
      (string-replace (str text) "&" "&amp;")
      "<" "&lt;")
    ">" "&gt;"))

;;; Escape a value for a double-quoted HTML attribute.
(defun attr-escape (value)
  (string-replace (html-escape value) "\"" "&quot;"))

;;; Strip the leading colon from a keyword attribute name.
(defun attr-name (key)
  (string-replace (str key) ":" ""))

;;; Render one attribute pair as HTML, or an empty string for `nil`/false.
(defun render-attr (pair)
  (let ((key (attr-name (first pair)))
        (value (first (rest pair))))
    (cond
      ((nil? value) "")
      ((= value #t) (str " " key))
      ((= value #f) "")
      (else (str " " key "=\"" (attr-escape value) "\"")))))

;;; Render an attribute list as a leading space plus HTML attributes.
(defun render-attrs (attrs)
  (if (nil? attrs)
      ""
      (string-join (map 'render-attr attrs) "")))

;;; Return true for HTML elements that must not have a closing tag.
(defun void-element? (tag)
  (or
    (= tag "area")
    (= tag "base")
    (= tag "br")
    (= tag "col")
    (= tag "embed")
    (= tag "hr")
    (= tag "img")
    (= tag "input")
    (= tag "link")
    (= tag "meta")
    (= tag "param")
    (= tag "source")
    (= tag "track")
    (= tag "wbr")))

;;; Render one tag form, including attributes and children.
(defun render-tag (form)
  (let ((tag (field form :tag))
        (attrs (render-attrs (field form :attrs)))
        (children (field form :children)))
    (if (void-element? tag)
        (str "<" tag attrs ">")
        (str "<" tag attrs ">"
             (string-join (map 'render-html children) "")
             "</" tag ">"))))

;;; Render a UI form, a list of forms, or a text node as HTML.
(defun render-html (form)
  (cond
    ((nil? form) "")
    ((not (nil? (field form :text))) (html-escape (field form :text)))
    ((not (nil? (field form :raw))) (field form :raw))
    ((not (nil? (field form :tag))) (render-tag form))
    (else (string-join (map 'render-html form) ""))))

;;; Wrap rendered HTML in a complete document with `title`, `styles`, and `body`.
(defun render-page (title styles body)
  (str
    "<!doctype html>\n"
    "<html lang=\"en\">\n"
    "<head>\n"
    "<meta charset=\"utf-8\">\n"
    "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n"
    "<title>" (html-escape title) "</title>\n"
    "<style>\nbody { margin: 0; }\n" styles "\n</style>\n"
    "</head>\n"
    "<body>\n" (render-html body) "\n</body>\n"
    "</html>\n"))

;;; ---------------------------------------------------------------------------
;;; Components
;;; ---------------------------------------------------------------------------
;;;
;;; These are deliberately small, semantic builders. They emit class names and
;;; structure, not a design system with a required framework. Include
;;; `ui/base-css` once per page, or override the classes in an app stylesheet.

;;; The default component stylesheet. Inline it in `render-page`, or copy the
;;; parts an app wants to own.
(defun ui/base-css ()
  "
:root { --ui-bg:#0d1014; --ui-panel:#161b22; --ui-line:#28313d; --ui-text:#e6edf3; --ui-muted:#8b98a8; --ui-accent:#f5c542; --ui-info:#58a6ff; --ui-danger:#f85149; --ui-radius:14px; }
.ui-stack { display:flex; flex-direction:column; gap:14px; }
.ui-row { display:flex; flex-wrap:wrap; gap:10px; align-items:center; }
.ui-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(240px,1fr)); gap:16px; }
.ui-card { background:linear-gradient(180deg,#1a2029,var(--ui-panel)); border:1px solid var(--ui-line); border-radius:var(--ui-radius); padding:20px; }
.ui-card-head { display:flex; justify-content:space-between; gap:16px; align-items:flex-start; margin-bottom:14px; }
.ui-card h2 { margin:0; font-size:20px; letter-spacing:-.02em; }
.ui-card p { margin:5px 0; color:var(--ui-muted); }
.ui-kicker { margin:0 0 6px; color:var(--ui-accent); font-size:11px; letter-spacing:.16em; text-transform:uppercase; }
.ui-muted { color:var(--ui-muted); }
.ui-badge { display:inline-block; border-radius:999px; padding:3px 9px; font-size:11px; font-weight:700; background:#253041; color:var(--ui-text); }
.ui-badge-good { background:#173b2b; color:#7ee2a8; }
.ui-badge-warn { background:#3b2e17; color:#f5c542; }
.ui-badge-bad { background:#3b1717; color:#ff8b8b; }
.ui-button { appearance:none; border:1px solid var(--ui-line); border-radius:10px; background:#1d2530; color:var(--ui-text); padding:9px 13px; font:inherit; cursor:pointer; text-decoration:none; display:inline-block; }
.ui-button-primary { background:var(--ui-accent); border-color:var(--ui-accent); color:#101216; font-weight:700; }
.ui-button-danger { background:#3b1717; border-color:#6e2b2b; color:#ffb4b4; }
.ui-form { display:flex; flex-direction:column; gap:14px; }
.ui-field { display:flex; flex-direction:column; gap:6px; font-size:13px; color:var(--ui-muted); }
.ui-field input, .ui-field textarea, .ui-field select { border:1px solid var(--ui-line); border-radius:9px; background:#0f141b; color:var(--ui-text); padding:9px 11px; font:inherit; }
.ui-field textarea { min-height:96px; resize:vertical; }
.ui-table { width:100%; border-collapse:collapse; font-size:14px; }
.ui-table th, .ui-table td { text-align:left; padding:9px 10px; border-bottom:1px solid var(--ui-line); }
.ui-table th { color:var(--ui-muted); font-size:11px; letter-spacing:.08em; text-transform:uppercase; }
.ui-kv { display:grid; grid-template-columns:minmax(100px,auto) 1fr; gap:8px 18px; margin:0; }
.ui-kv dt { color:var(--ui-muted); }
.ui-kv dd { margin:0; }
.ui-stat { display:flex; flex-direction:column; gap:2px; }
.ui-stat-value { font-size:28px; font-weight:700; letter-spacing:-.04em; }
.ui-stat-label { color:var(--ui-muted); font-size:12px; text-transform:uppercase; letter-spacing:.1em; }
.ui-progress { height:9px; border-radius:999px; background:#0f141b; border:1px solid var(--ui-line); overflow:hidden; }
.ui-progress-fill { display:block; height:100%; background:var(--ui-accent); border-radius:999px; }
.ui-cover { position:relative; width:100%; aspect-ratio:1; border-radius:12px; overflow:hidden; background:#0f141b; border:1px solid var(--ui-line); display:grid; place-items:center; }
.ui-cover img { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; }
.ui-cover-fallback { font-size:42px; font-weight:800; color:#3b4657; letter-spacing:-.06em; }
.ui-empty, .ui-error-state { padding:28px; border:1px dashed var(--ui-line); border-radius:12px; color:var(--ui-muted); text-align:center; }
.ui-error-state { border-color:#6e2b2b; color:#ffb4b4; background:#1a1113; }
.ui-skeleton { display:flex; flex-direction:column; gap:8px; }
.ui-skeleton-line { height:11px; border-radius:6px; background:linear-gradient(90deg,#1c2430,#2a3544,#1c2430); background-size:200% 100%; animation:ui-shimmer 1.4s ease-in-out infinite; }
.ui-skeleton-line:nth-child(2n) { width:78%; }
.ui-sparkline { width:100%; height:34px; overflow:visible; }
@keyframes ui-shimmer { from { background-position:200% 0; } to { background-position:-200% 0; } }
@media (prefers-reduced-motion:reduce) { .ui-skeleton-line { animation:none; } }
")

(defun ui/tone (tone)
  (if (nil? tone) "neutral" (str tone)))

;;; A bordered card with a title, optional subtitle, and child forms.
(defun ui/card (title subtitle children)
  (el "section" (list (attr :class "ui-card"))
    (list
      (el "header" (list (attr :class "ui-card-head"))
        (list
          (el "div" nil
            (list
              (el "h2" nil (list (txt title)))
              (if (nil? subtitle)
                  nil
                  (el "p" nil (list (txt subtitle))))))))
      (el "div" (list (attr :class "ui-card-body")) children))))

;;; A vertical flex stack.
(defun ui/stack (children)
  (el "div" (list (attr :class "ui-stack")) children))

;;; A wrapping horizontal row.
(defun ui/row (children)
  (el "div" (list (attr :class "ui-row")) children))

;;; A responsive auto-fit grid.
(defun ui/grid (children)
  (el "div" (list (attr :class "ui-grid")) children))

;;; A small uppercase section label.
(defun ui/kicker (text)
  (el "p" (list (attr :class "ui-kicker")) (list (txt text))))

;;; A heading at `level` (1..6).
(defun ui/heading (level text)
  (el (str "h" (int level)) nil (list (txt text))))

;;; Muted or ordinary body text.
(defun ui/text (text muted)
  (el "p" (list (attr :class (if muted "ui-muted" ""))) (list (txt text))))

;;; A small status badge. Tone is `good`, `warn`, `bad`, or anything else for
;;; the neutral style.
(defun ui/badge (text tone)
  (let ((tone (ui/tone tone)))
    (el "span"
      (list (attr :class
        (if (= tone "neutral") "ui-badge" (str "ui-badge ui-badge-" tone))))
      (list (txt text)))))

(defun ui/button-class (variant)
  (cond
    ((= variant "primary") "ui-button ui-button-primary")
    ((= variant "danger") "ui-button ui-button-danger")
    (else "ui-button")))

;;; A form-submit or action button. `action` becomes `data-action` for a host
;;; that routes actions; it is not an href.
(defun ui/button (label action variant)
  (el "button"
    (list
      (attr :type "button")
      (attr :class (ui/button-class variant))
      (attr :data-action action))
    (list (txt label))))

;;; A link styled as a button.
(defun ui/link-button (label href variant)
  (el "a"
    (list (attr :href href) (attr :class (ui/button-class variant)))
    (list (txt label))))

;;; A form around a set of fields.
(defun ui/form (action method children)
  (el "form"
    (list
      (attr :action action)
      (attr :method (if (nil? method) "post" method)))
    children))

;;; A labelled control with optional help text.
(defun ui/field (label control help)
  (el "label" (list (attr :class "ui-field"))
    (list
      (el "span" nil (list (txt label)))
      control
      (if (nil? help) nil (el "small" nil (list (txt help)))))))

;;; A text-like input. `type` defaults to `text`.
(defun ui/input (name value placeholder type)
  (el "input"
    (list
      (attr :name name)
      (attr :value value)
      (attr :placeholder placeholder)
      (attr :type (if (nil? type) "text" type)))
    nil))

;;; A textarea.
(defun ui/textarea (name value rows)
  (el "textarea"
    (list (attr :name name) (attr :rows rows))
    (list (txt (if (nil? value) "" value)))))

(defun ui/option (option selected)
  (let ((value (first option))
        (label (nth 1 option)))
    (el "option"
      (list
        (attr :value value)
        (attr :selected (if (= value selected) #t #f)))
      (list (txt label)))))

;;; A select control. `options` is a list of `(value label)` pairs.
(defun ui/select (name options selected)
  (el "select" (list (attr :name name))
    (map-with 'ui/option selected options)))

(defun ui/node? (value)
  (or
    (not (nil? (field value :tag)))
    (not (nil? (field value :text)))
    (not (nil? (field value :raw)))))

(defun ui/cell (value)
  (el "td" nil
    (list (if (ui/node? value) value (txt value)))))

(defun ui/table-row (row)
  (el "tr" nil (map 'ui/cell row)))

(defun ui/header-cell (label)
  (el "th" (list (attr :scope "col")) (list (txt label))))

;;; A table from a header list and row lists. A cell may be text or a UI form.
(defun ui/table (headers rows)
  (el "table" (list (attr :class "ui-table"))
    (list
      (el "thead" nil
        (list (el "tr" nil (map 'ui/header-cell headers))))
      (el "tbody" nil (map 'ui/table-row rows)))))

(defun ui/kv-row (pair)
  (el "div" (list (attr :class "ui-kv-row"))
    (list
      (el "dt" nil (list (txt (first pair))))
      (el "dd" nil
        (list (if (ui/node? (nth 1 pair)) (nth 1 pair) (txt (nth 1 pair))))))))

;;; A definition list from `(label value)` pairs.
(defun ui/kv (pairs)
  (el "dl" (list (attr :class "ui-kv"))
    (map 'ui/kv-row pairs)))

;;; A single number with a label and optional detail.
(defun ui/stat (label value detail)
  (el "div" (list (attr :class "ui-stat"))
    (list
      (el "span" (list (attr :class "ui-stat-value")) (list (txt value)))
      (el "span" (list (attr :class "ui-stat-label")) (list (txt label)))
      (if (nil? detail) nil (el "small" (list (attr :class "ui-muted"))
        (list (txt detail)))))))

;;; A progress bar. `value` and `max` are numbers; a non-positive max is empty.
(defun ui/progress (value max)
  (let ((percent
          (if (<= max 0)
              0
              (min 100 (int (* 100 (/ value max)))))))
    (el "div"
      (list
        (attr :class "ui-progress")
        (attr :role "progressbar")
        (attr :aria-valuenow (int value))
        (attr :aria-valuemax (int max)))
      (list
        (el "span"
          (list
            (attr :class "ui-progress-fill")
            (attr :style (str "width:" percent "%")))
          nil)))))

;;; A square cover with a monogram fallback. The image sits above the fallback,
;;; so a missing/broken image leaves the monogram visible without JavaScript.
(defun ui/cover (src alt fallback)
  (el "div" (list (attr :class "ui-cover"))
    (list
      (el "span" (list (attr :class "ui-cover-fallback"))
        (list (txt fallback)))
      (if (nil? src)
          nil
          (el "img"
            (list
              (attr :src src)
              (attr :alt alt)
              (attr :loading "lazy"))
            nil)))))

;;; An empty-state block.
(defun ui/empty (title body)
  (el "div" (list (attr :class "ui-empty"))
    (list
      (el "strong" nil (list (txt title)))
      (if (nil? body) nil (el "p" nil (list (txt body)))))))

;;; An error-state block.
(defun ui/error-state (title body)
  (el "div" (list (attr :class "ui-error-state"))
    (list
      (el "strong" nil (list (txt title)))
      (if (nil? body) nil (el "p" nil (list (txt body)))))))

(defun ui/skeleton-line (ignored)
  (el "div" (list (attr :class "ui-skeleton-line")) nil))

;;; A shimmering placeholder with `lines` rows.
(defun ui/skeleton (lines)
  (el "div" (list (attr :class "ui-skeleton"))
    (map 'ui/skeleton-line (range 0 (max 1 (int lines))))))

(defun ui/spark-point (value index count low high width height)
  (let ((x (if (<= count 1)
               (/ width 2.0)
               (* (/ (int index) (- count 1.0)) width)))
        (span (- high low))
        (y (if (<= span 0.0)
               (/ height 2.0)
               (- height (* (/ (- value low) span) height)))))
    (str x "," y)))

(defun ui/spark-points (values low high width height index out)
  (if (nil? values)
      (string-join (reverse out) " ")
      (ui/spark-points
        (rest values) low high width height (+ index 1)
        (cons (ui/spark-point
                (first values) index (length values) low high width height)
              out))))

;;; An SVG sparkline. `values` is a non-empty list of numbers.
(defun ui/sparkline (values width height)
  (if (nil? values)
      (ui/empty "No data" nil)
      (let ((low (reduce 'min (first values) (rest values)))
            (high (reduce 'max (first values) (rest values))))
        (el "svg"
          (list
            (attr :class "ui-sparkline")
            (attr :viewBox (str "0 0 " width " " height))
            (attr :preserveAspectRatio "none")
            (attr :role "img"))
          (list
            (el "polyline"
              (list
                (attr :points
                  (ui/spark-points values low high width height 0 nil))
                (attr :fill "none")
                (attr :stroke "currentColor")
                (attr :stroke-width "2")
                (attr :stroke-linejoin "round"))
              nil))))))

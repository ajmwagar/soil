; SPDX-License-Identifier: MIT OR Apache-2.0
; A numeric-core compiler written in Soil. This is bootstrap stage 0: it runs
; under the interpreter and emits WebAssembly text (WAT). The Rust compiler is
; still the reference until this emits the same shapes and is itself compiled.

; Bootstrap macros: these are expanded while the compiler is loaded into the
; interpreter. Runtime source avoids macros because the compiler does not
; expand macros yet.
(defmacro wasm/i64-load () `(list 41))
(defmacro wasm/i64-store () `(list 55))
(defmacro wasm/i32-wrap () `(list 167))
(defmacro wasm/i64-extend () `(list 173))
(defmacro wasm/global-get () `(list 35))
(defmacro wasm/global-set () `(list 36))

(defun compiler/params (params)
  (if (nil? params)
      ""
      (str " (param $" (first params) " i64)"
           (compiler/params (rest params)))))

(defun compiler/call-args (args texts)
  (if (nil? args)
      ""
      (str (compiler/expr (first args) texts)
           (compiler/call-args (rest args) texts))))

(defun compiler/binary-op (head)
  (cond
    ((= head "+") "i64.add")
    ((= head "-") "i64.sub")
    ((= head "*") "i64.mul")
    ((= head "/") "i64.div_s")
    ((= head "%") "i64.rem_s")
    ((= head "bit-and") "i64.and")
    ((= head "bit-or") "i64.or")
    ((= head "bit-xor") "i64.xor")
    ((= head "bit-shl") "i64.shl")
    ((= head "bit-shr") "i64.shr_s")
    ((= head "=") "i64.eq")
    ((= head ">") "i64.gt_s")
    ((= head "<") "i64.lt_s")
    ((= head ">=") "i64.ge_s")
    ((= head "<=") "i64.le_s")
    ((= head "and") "i64.and")
    ((= head "or") "i64.or")
    (else nil)))

(defun compiler/string-member? (text texts)
  (cond
    ((nil? texts) #f)
    ((= text (first texts)) #t)
    (else (compiler/string-member? text (rest texts)))))

(defun compiler/strings-in (form texts)
  (cond
    ((string? form)
      (if (compiler/string-member? form texts) texts (cons form texts)))
    ((atom form) texts)
    ((and (not (atom form))
          (or (= (str (first form)) "quote")
              (= (str (first form)) "import")
              (= (str (first form)) "export")
              (= (str (first form)) "package")
              (= (str (first form)) "world")))
      texts)
    (else
      (compiler/strings-in
        (rest form)
        (compiler/strings-in (first form) texts)))))

(defun compiler/string-literals (forms)
  (if (nil? forms)
      nil
      (compiler/strings-in (first forms)
        (compiler/string-literals (rest forms)))))

(defun compiler/string-len (text)
  (length (string->bytes text)))

(defun compiler/string-offset (text texts offset)
  (cond
    ((nil? texts) nil)
    ((= text (first texts)) offset)
    (else
      (compiler/string-offset text (rest texts)
        (+ offset (compiler/string-len (first texts)))))))

(defun compiler/string-data (texts offset)
  (if (nil? texts)
      ""
      (str "  (data (i32.const " offset ") " (json-encode (first texts)) ")\n"
           (compiler/string-data (rest texts)
             (+ offset (compiler/string-len (first texts)))))))

(defun compiler/expr (expr texts)
  (cond
    ((symbol? expr)
      (str "    local.get $" expr "\n"))
    ((string? expr)
      (str "    i32.const " (compiler/string-offset expr texts 65536) "\n"))
    ((atom expr)
      (str "    i64.const " expr "\n"))
    ((= (str (first expr)) "string-ptr")
      (str "    i32.const "
           (compiler/string-offset (nth 1 expr) texts 65536) "\n"))
    ((= (str (first expr)) "string-len")
      (str "    i32.const " (compiler/string-len (nth 1 expr)) "\n"))
    ((= (str (first expr)) "begin")
      (compiler/body-drop (rest expr) texts))
    ((= (str (first expr)) "if")
      (str (compiler/expr (nth 1 expr) texts)
           "    i32.wrap_i64\n"
           "    if (result i64)\n"
           (compiler/expr (nth 2 expr) texts)
           "    else\n"
           (compiler/expr (nth 3 expr) texts)
           "    end\n"))
    ((= (str (first expr)) "i32.const")
      (str "    i32.const " (nth 1 expr) "\n"))
    ((= (str (first expr)) "i32.load")
      (str (compiler/expr (nth 1 expr) texts) "    i32.load\n"))
    ((= (str (first expr)) "i64.load")
      (str (compiler/expr (nth 1 expr) texts) "    i64.load\n"))
    ((= (str (first expr)) "i32.add")
      (str (compiler/expr (nth 1 expr) texts) (compiler/expr (nth 2 expr) texts) "    i32.add\n"))
    ((= (str (first expr)) "i32.store")
      (str (compiler/expr (nth 1 expr) texts) (compiler/expr (nth 2 expr) texts) "    i32.store\n"))
    ((= (str (first expr)) "i32.store8")
      (str (compiler/expr (nth 1 expr) texts) (compiler/expr (nth 2 expr) texts) "    i32.store8\n"))
    ((= (str (first expr)) "i32.store-at")
      (str "    local.get $base\n"
           (compiler/expr (nth 2 expr) texts)
           "    i32.store8 offset=" (nth 1 expr) "\n"))
    ((= (str (first expr)) "f32.store-at")
      (str "    local.get $base\n"
           (compiler/expr (nth 2 expr) texts)
           "    f32.store offset=" (nth 1 expr) "\n"))
    ((= (str (first expr)) "i32.const32")
      (str "    i32.const " (nth 1 expr) "\n"))
    ((= (str (first expr)) "f32.const")
      (str "    f32.const " (nth 1 expr) "\n"))
    ((= (str (first expr)) "i64.extend_i32_u")
      (str (compiler/expr (nth 1 expr) texts) "    i64.extend_i32_u\n"))
    ((= (str (first expr)) "not")
      (str (compiler/expr (nth 1 expr) texts)
           "    i64.eqz\n"
           "    i64.extend_i32_u\n"))
    ((= (str (first expr)) "nth")
      (let ((index (nth 1 expr))
            (items (nth 2 expr)))
        (if (and (atom index) (not (symbol? index))
                 (not (atom items)) (= (str (first items)) "list"))
            (compiler/expr (nth index (rest items)) texts)
            (let ((head (str (first expr))))
              (let ((op (compiler/binary-op head)))
                (if (nil? op)
                    (str (compiler/call-args (rest expr) texts)
                         "    call $" head "\n")
                    (str (compiler/expr (nth 1 expr) texts)
                         (compiler/expr (nth 2 expr) texts)
                         "    " op "\n")))))))
    (else
      (let ((head (str (first expr))))
        (let ((op (compiler/binary-op head)))
          (if (nil? op)
              (str (compiler/call-args (rest expr) texts)
                   "    call $" head "\n")
              (str (compiler/expr (nth 1 expr) texts)
                   (compiler/expr (nth 2 expr) texts)
                   "    " op "\n")))))))

(defun compiler/void? (expr)
  (and (not (atom expr))
       (let ((head (str (first expr))))
         (or (= head "i64.store")
             (= head "i32.store")
             (= head "i32.store8")
             (= head "global.set")))))

(defun compiler/body-drop (forms texts)
  (if (nil? forms)
      ""
      (if (nil? (rest forms))
          (compiler/expr (first forms) texts)
          (str (compiler/expr (first forms) texts)
               (if (compiler/void? (first forms)) "" "    drop\n")
               (compiler/body-drop (rest forms) texts)))))

(defun compiler/body (forms texts)
  (if (nil? forms)
      ""
      (str (compiler/expr (first forms) texts)
           (compiler/body (rest forms) texts))))

(defun compiler/defun (form texts)
  (let ((name (str (nth 1 form))))
    (str "  (func $" name " (export \"" name "\")"
         (compiler/params (nth 2 form))
         " (result i64)\n"
         (compiler/body-drop (drop 3 form) texts)
         "  )\n")))

(defun compiler/params-i32 (params)
  (if (nil? params)
      ""
      (str " (param $" (first params) " i32)"
           (compiler/params-i32 (rest params)))))

(defun compiler/defun-i32 (form texts)
  (let ((name (str (nth 1 form))))
    (str "  (func $" name " (export \"" name "\")"
         (compiler/params-i32 (nth 2 form))
         " (result i32)\n"
         (compiler/body-drop (drop 3 form) texts)
         "  )\n")))

(defun compiler/defun-i32-void (form texts)
  (let ((name (str (nth 1 form))))
    (str "  (func $" name " (export \"" name "\")"
         (compiler/params-i32 (nth 2 form))
         "\n"
         (if (nil? (nth 3 form)) "" (compiler/expr (nth 3 form) texts))
         "  )\n")))


; ---------------------------------------------------------------------------
; Canonical ABI lowering for an export that returns a list of records.
;
; `defun-export` takes a record list literal and emits the core function the
; component model expects: results flatten to (ptr, len), which is more than one
; core value, so the caller passes a return-area pointer as the only parameter
; and the function returns nothing.
;
; Only the shapes a lights surface needs are lowered: string, bool, f32 and
; nested records of those. Anything else falls back to a 4-byte slot rather than
; silently emitting a wrong layout.

(defun abi/scalar-size (name)
  (cond
    ((= name "bool") 1)
    ((= name "u8") 1)
    ((= name "u16") 2)
    ((= name "f32") 4)
    ((= name "u32") 4)
    ((= name "s32") 4)
    ((= name "u64") 8)
    ((= name "s64") 8)
    ((= name "f64") 8)
    (else 0)))

(defun abi/find-record (name records)
  (cond
    ((nil? records) nil)
    ((= (str (nth 1 (first records))) name) (first records))
    (else (abi/find-record name (rest records)))))

;;; `/` is float division in the interpreter, so alignment needs an integer
;;; divide or offsets come out fractional (and silently truncated into wrong
;;; field positions).
(defun abi/div (n d)
  (if (< n d) 0 (+ 1 (abi/div (- n d) d))))

(defun abi/align-up (n align)
  (* align (abi/div (+ n (- align 1)) align)))

(defun abi/align (type records)
  (let ((scalar (abi/scalar-size (str type))))
    (if (> scalar 0)
        (min scalar 4)
        (if (= (str type) "string")
            4
            (if (not (atom type))
                4
                (let ((record (abi/find-record (str type) records)))
                  (if (nil? record)
                      4
                      (nth 1 (abi/layout (drop 2 record) records 0 1)))))))))

(defun abi/size (type records)
  (let ((scalar (abi/scalar-size (str type))))
    (if (> scalar 0)
        scalar
        (if (= (str type) "string")
            8
            (if (not (atom type))
                8
                (let ((record (abi/find-record (str type) records)))
                  (if (nil? record)
                      4
                      (abi/record-size record records))))))))

(defun abi/layout (fields records offset align)
  (if (nil? fields)
      (list offset align)
      (let ((field (first fields)))
        (let ((ftype (nth 1 field)))
          (let ((offset (abi/align-up offset (abi/align ftype records))))
            (abi/layout (rest fields)
                        records
                        (+ offset (abi/size ftype records))
                        (max align (abi/align ftype records))))))))

(defun abi/record-size (record records)
  (let ((layout (abi/layout (drop 2 record) records 0 1)))
    (abi/align-up (first layout) (nth 1 layout))))

;;; String data is written at a fixed static offset per element and string, so
;;; codegen needs no allocator for it. `ctx` is (element-index string-index).
(defun abi/data-offset (ctx)
  (+ 65536 (+ (* (first ctx) 1024) (* (nth 1 ctx) 64))))

(defun abi/next-ctx (ctx)
  (list (first ctx) (+ (nth 1 ctx) 1)))

(defun abi/emit-bytes (offset bytes)
  (if (nil? bytes)
      ""
      (str "    i32.const " offset "\n"
           "    i32.const " (first bytes) "\n"
           "    i32.store8\n"
           (abi/emit-bytes (+ offset 1) (rest bytes)))))

(defun abi/emit-field (ftype value records offset ctx)
  (let ((kind (str ftype)))
    (cond
      ((= kind "bool")
        (list (str "    local.get $base\n"
                   "    i32.const " (if value 1 0) "\n"
                   "    i32.store8 offset=" offset "\n")
              ctx))
      ((= kind "f32")
        (list (str "    local.get $base\n"
                   "    f32.const " (str value) "\n"
                   "    f32.store offset=" offset "\n")
              ctx))
      ((= kind "string")
        (let ((data (abi/data-offset ctx)))
          (list (str "    local.get $base\n"
                     "    i32.const " data "\n"
                     "    i32.store offset=" offset "\n"
                     "    local.get $base\n"
                     "    i32.const " (length (str value)) "\n"
                     "    i32.store offset=" (+ offset 4) "\n"
                     (abi/emit-bytes data (string->bytes (str value))))
                (abi/next-ctx ctx))))
      (else
        (let ((record (abi/find-record kind records)))
          (if (nil? record)
              (list "" ctx)
              (abi/emit-fields (drop 2 record) (rest value) records offset ctx)))))))

(defun abi/emit-fields (fields values records offset ctx)
  (if (nil? fields)
      (list "" ctx)
      (let ((field (first fields)))
        (let ((ftype (nth 1 field)))
          (let ((offset (abi/align-up offset (abi/align ftype records))))
            (let ((here (abi/emit-field ftype (first values) records offset ctx)))
              (let ((next (abi/emit-fields (rest fields)
                                           (rest values)
                                           records
                                           (+ offset (abi/size ftype records))
                                           (nth 1 here))))
                (list (str (first here) (first next)) (nth 1 next)))))))))

;;; Emit one element: base = ptr + index * stride, then its fields.
(defun abi/emit-element (record value index records)
  (let ((stride (abi/record-size record records)))
    (let ((fields (abi/emit-fields (drop 2 record)
                                   (rest value)
                                   records
                                   0
                                   (list index 0))))
      (str "    local.get $ptr\n"
           "    i32.const " (* index stride) "\n"
           "    i32.add\n"
           "    local.set $base\n"
           (first fields)))))

(defun abi/emit-elements (record values records index)
  (if (nil? values)
      ""
      (str (abi/emit-element record (first values) index records)
           (abi/emit-elements record (rest values) records (+ index 1)))))

(defun abi/count-values (values)
  (if (nil? values) 0 (+ 1 (abi/count-values (rest values)))))

;;; (defun-export NAME -> (list RECORD) (list (RECORD field...)...))
(defun compiler/defun-export (form records prefix)
  (let ((name (str (nth 1 form))))
    (let ((type (nth 3 form)))
      (let ((record-name (str (nth 1 type))))
        (let ((record (abi/find-record record-name records)))
          (if (nil? record)
              ""
              (let ((values (rest (nth 4 form))))
                (let ((n (abi/count-values values)))
                  (let ((stride (abi/record-size record records)))
                    (str "  (func (export \"" prefix name "\") (result i32)"
                         " (local $area i32) (local $ptr i32) (local $base i32)\n"
                         ;; Results flatten to (ptr, len): more than one core
                         ;; value, so the guest returns a pointer to a return
                         ;; area holding them.
                         "    i32.const 0\n"
                         "    i32.const 0\n"
                         "    i32.const 4\n"
                         "    i32.const 8\n"
                         "    call $cabi_realloc\n"
                         "    local.set $area\n"
                         "    i32.const 0\n"
                         "    i32.const 0\n"
                         "    i32.const " (abi/align record-name records) "\n"
                         "    i32.const " (* n stride) "\n"
                         "    call $cabi_realloc\n"
                         "    local.set $ptr\n"
                         "    local.get $area\n"
                         "    local.get $ptr\n"
                         "    i32.store\n"
                         "    local.get $area\n"
                         "    i32.const " n "\n"
                         "    i32.store offset=4\n"
                         (abi/emit-elements record values records 0)
                         "    local.get $area\n"
                         "  )\n"))))))))))

(defun compiler/forms (forms records prefix texts)
  (if (nil? forms)
      ""
      (let ((form (first forms)))
        (str (cond
               ((and (not (atom form)) (= (str (first form)) "defun"))
                 (compiler/defun form texts))
               ((and (not (atom form)) (= (str (first form)) "defun-i32"))
                 (compiler/defun-i32 form texts))
               ((and (not (atom form)) (= (str (first form)) "defun-i32-void"))
                 (compiler/defun-i32-void form texts))
               ((compiler/decl? form "defun-export")
                 (compiler/defun-export form records prefix))
               (else ""))
             (compiler/forms (rest forms) records prefix texts)))))


; ---------------------------------------------------------------------------
; Macro expansion for target source.
;
; The compiler runs under the interpreter, so defmacro forms in the source are
; installed into the interpreter's macro table, then every form is recursively
; expanded before lowering. Quoted forms and defmacro forms are left alone.

(defun wasm/macro-form? (form)
  (and (not (atom form)) (= (wasm/head form) "defmacro")))

(defun wasm/quote-form? (form)
  (and (not (atom form)) (= (wasm/head form) "quote")))

(defun wasm/expand-list (forms)
  (if (nil? forms)
      nil
      (cons (wasm/expand-tree (first forms))
            (wasm/expand-list (rest forms)))))

(defun wasm/expand-tree (form)
  (cond
    ((atom form) form)
    ((wasm/quote-form? form) form)
    ((wasm/macro-form? form) form)
    (else
      (let ((expanded (macroexpand form)))
        (if (= expanded form)
            (cons (first form) (wasm/expand-list (rest form)))
            (wasm/expand-tree expanded))))))

(defun wasm/expand-forms (forms)
  (if (nil? forms)
      nil
      (let ((form (first forms)))
        (if (wasm/macro-form? form)
            (begin
              (eval form)
              (wasm/expand-forms (rest forms)))
            (cons (wasm/expand-tree form)
                  (wasm/expand-forms (rest forms)))))))


; ---------------------------------------------------------------------------
; Component WAT target.
;
; This is the first canonical-ABI slice. It emits the core ABI that
; `wasm-tools component embed` expects for a WIT world with imports.

(defun compiler/import? (form)
  (and (not (atom form)) (= (wasm/head form) "import")))

(defun compiler/import-param (type)
  (str " (param " type ")"))

(defun compiler/import-params (types)
  (if (nil? types)
      ""
      (str (compiler/import-param (first types))
           (compiler/import-params (rest types)))))

(defun compiler/import-result (type)
  (if (= (str type) "unit") "" (str " (result " type ")")))

(defun compiler/import (form)
  (str "  (import " (json-encode (nth 1 form))
       " " (json-encode (nth 2 form))
       " (func $" (nth 3 form)
       (compiler/import-params (nth 4 form))
       (compiler/import-result (nth 5 form)) "))\n"))

(defun compiler/imports (forms)
  (cond
    ((nil? forms) "")
    ((compiler/import? (first forms))
      (str (compiler/import (first forms)) (compiler/imports (rest forms))))
    (else (compiler/imports (rest forms)))))

(defun compiler/component-wat (source)
  (let ((forms (wasm/expand-forms (read source))))
    (let ((texts (compiler/string-literals forms)))
      (str "(module\n"
         (compiler/imports forms)
         "  (memory (export \"cm32p2_memory\") 4)\n"
         "  (global $heap (mut i32) (i32.const 1024))\n"
         "  (func $cabi_realloc (export \"cabi_realloc\") (param i32 i32 i32 i32) (result i32)\n"
         "    (local $ret i32)\n"
         "    global.get $heap\n"
         "    i32.const 7\n"
         "    i32.add\n"
         "    i32.const -8\n"
         "    i32.and\n"
         "    local.set $ret\n"
         "    local.get $ret\n"
         "    local.get 3\n"
         "    i32.add\n"
         "    global.set $heap\n"
         "    local.get 0\n"
         "    if (result i32)\n"
         "      local.get 0\n"
         "    else\n"
         "      local.get $ret\n"
         "    end)\n"
         (compiler/forms forms (compiler/records forms)
                         (compiler/export-prefix forms) texts)
         (compiler/string-data texts 65536)
         ")\n"))))


; ---------------------------------------------------------------------------
; WIT export target.
;
; `export` is a declaration, not a definition. It binds an existing `defun`
; to a WIT/component export. The form may appear before or after the defun:
;
;   (export add (a s32) (b s32) -> s32)
;   (export "add" add-impl (a s32) (b s32) -> s32)
;
; Package and world are source directives:
;
;   (package "acme:counter@0.1.0")
;   (world "counter")

(defun compiler/decl? (form name)
  (and (not (atom form)) (= (str (first form)) name)))

;;; Split "pkg:name@version" at the first `@`.
(defun compiler/split-at (chars acc)
  (if (nil? chars)
      (list acc "")
      (if (= (first chars) "@")
          (list acc (string-join (rest chars) ""))
          (compiler/split-at (rest chars) (str acc (first chars))))))

;;; Core export name for an interface function:
;;;   <package>/<interface>@<version>#<function>
;;; World-level exports keep the plain name.
(defun compiler/export-prefix (forms)
  (if (nil? (compiler/records forms))
      ""
      (let ((parts (compiler/split-at (string-chars (compiler/decl forms "package" "soil:guest@0.1.0")) "")))
        (str (first parts) "/"
             (compiler/decl forms "interface" "api") "@"
             (nth 1 parts) "#"))))

(defun compiler/decl (forms name fallback)
  (if (nil? forms)
      fallback
      (let ((form (first forms)))
        (if (compiler/decl? form name)
            (str (nth 1 form))
            (compiler/decl (rest forms) name fallback)))))

(defun compiler/export? (form)
  (compiler/decl? form "export"))

(defun compiler/export-impl (form)
  (let ((head (nth 1 form)))
    (if (symbol? head) head (nth 2 form))))

(defun compiler/export-name (form)
  (let ((head (nth 1 form)))
    (str (if (symbol? head) head (nth 1 form)))))

(defun compiler/export-tail (form)
  (if (symbol? (nth 1 form)) (drop 2 form) (drop 3 form)))

(defun compiler/wit-type (type)
  (cond
    ((symbol? type) (str type))
    ((= (str (first type)) "list")
      (str "list<" (compiler/wit-type (nth 1 type)) ">"))
    ((= (str (first type)) "option")
      (str "option<" (compiler/wit-type (nth 1 type)) ">"))
    ((= (str (first type)) "result")
      (cond
        ((nil? (rest type)) "result")
        ((nil? (nth 2 type)) (str "result<" (compiler/wit-type (nth 1 type)) ">"))
        (else (str "result<" (compiler/wit-type (nth 1 type))
                   ", " (compiler/wit-type (nth 2 type)) ">"))))
    ((= (str (first type)) "tuple")
      (str "tuple<" (compiler/wit-types (rest type)) ">"))
    (else (str type))))

(defun compiler/wit-types (types)
  (if (nil? types)
      ""
      (str (compiler/wit-type (first types))
           (if (nil? (rest types)) "" (str ", " (compiler/wit-types (rest types)))))))

(defun compiler/export-params (items params)
  (cond
    ((nil? items)
      (list (reverse params) nil))
    ((= (str (first items)) "->")
      (list (reverse params) (nth 1 items)))
    (else
      (let ((param (first items)))
        (compiler/export-params
          (rest items)
          (cons (list (list :name (str (first param)))
                      (list :type (nth 1 param)))
                params))))))

(defun compiler/wit-param (param)
  (str (field param :name) ": " (compiler/wit-type (field param :type))))

(defun compiler/wit-params (params)
  (if (nil? params)
      ""
      (str (compiler/wit-param (first params))
           (if (nil? (rest params)) "" (str ", " (compiler/wit-params (rest params)))))))

(defun compiler/export-entry (form)
  (let ((parsed (compiler/export-params (compiler/export-tail form) nil)))
    (list
      (list :name (compiler/export-name form))
      (list :impl (str (compiler/export-impl form)))
      (list :params (first parsed))
      (list :result (nth 1 parsed)))))

(defun compiler/exports (forms)
  (cond
    ((nil? forms) nil)
    ((compiler/export? (first forms))
      (cons (compiler/export-entry (first forms))
            (compiler/exports (rest forms))))
    (else (compiler/exports (rest forms)))))

(defun compiler/wit-result (entry)
  (let ((result (field entry :result)))
    (if (or (nil? result) (= (str result) "unit"))
        ""
        (str " -> " (compiler/wit-type result)))))

;;; A world exports a function with `export name: func(...)`; an interface
;;; declares the same function as `name: func(...)`.
(defun compiler/wit-export (entry)
  (str "  export " (field entry :name) ": func("
       (compiler/wit-params (field entry :params)) ")"
       (compiler/wit-result entry) ";\n"))

(defun compiler/wit-method (entry)
  (str "  " (field entry :name) ": func("
       (compiler/wit-params (field entry :params)) ")"
       (compiler/wit-result entry) ";\n"))

(defun compiler/record? (form)
  (compiler/decl? form "record"))

(defun compiler/wit-field (field)
  (str (first field) ": " (compiler/wit-type (nth 1 field))))

(defun compiler/wit-fields (fields)
  (if (nil? fields)
      ""
      (str "    " (compiler/wit-field (first fields)) ",\n"
           (compiler/wit-fields (rest fields)))))

(defun compiler/wit-record (form)
  (str "  record " (str (nth 1 form)) " {\n"
       (compiler/wit-fields (drop 2 form))
       "  }\n\n"))

(defun compiler/records (forms)
  (cond
    ((nil? forms) nil)
    ((compiler/record? (first forms))
      (cons (first forms) (compiler/records (rest forms))))
    (else (compiler/records (rest forms)))))

(defun compiler/wit-records (records)
  (if (nil? records)
      ""
      (str (compiler/wit-record (first records))
           (compiler/wit-records (rest records)))))

(defun compiler/wit-exports (exports)
  (if (nil? exports)
      ""
      (str (compiler/wit-export (first exports))
           (compiler/wit-exports (rest exports)))))

(defun compiler/wit-methods (exports)
  (if (nil? exports)
      ""
      (str (compiler/wit-method (first exports))
           (compiler/wit-methods (rest exports)))))

;;; Emit a WIT package/world from `export` declarations.
;;;
;;; Named types (`record`) cannot live in a world, so a source that declares any
;;; emits them in an interface and the world exports that interface. The
;;; interface name defaults to `api` and is set with `(interface "lights")`.
(defun compiler/wit (source)
  (let ((forms (wasm/expand-forms (read source))))
    (let ((records (compiler/records forms)))
      (if (nil? records)
          (str "package " (compiler/decl forms "package" "soil:guest@0.1.0") ";\n\n"
               "world " (compiler/decl forms "world" "guest") " {\n"
               (compiler/wit-exports (compiler/exports forms))
               "}\n")
          (let ((interface (compiler/decl forms "interface" "api")))
            (str "package " (compiler/decl forms "package" "soil:guest@0.1.0") ";\n\n"
                 "interface " interface " {\n"
                 (compiler/wit-records records)
                 (compiler/wit-methods (compiler/exports forms))
                 "}\n\n"
                 "world " (compiler/decl forms "world" "guest") " {\n"
                 "  export " interface ";\n"
                 "}\n"))))))

(defun compiler/compile-source (source)
  (let ((forms (wasm/expand-forms (read source))))
    (let ((texts (compiler/string-literals forms)))
      (str "(module\n"
           (compiler/forms forms (compiler/records forms)
                           (compiler/export-prefix forms) texts)
           ")\n"))))

(defun compiler/compile-wat (source)
  (compiler/compile-source source))

(defun compiler/compile-wasm (source)
  (wasm/compile-source source))

; ---------------------------------------------------------------------------
; Binary Wasm emitter (stage 1).
;
; This mirrors the Rust numeric-core compiler: one type per function, function
; indices in source order, exports, then one code section.

(defun wasm/cat (parts)
  (if (nil? parts)
      nil
      (append (first parts) (wasm/cat (rest parts)))))

(defun wasm/repeat (n value)
  (if (<= n 0) nil (cons value (wasm/repeat (- n 1) value))))

(defun wasm/div (n d)
  (if (< n d) 0 (+ 1 (wasm/div (- n d) d))))

(defun wasm/mod (n d)
  (if (< n d) n (wasm/mod (- n d) d)))

(defun wasm/floor-div (n d)
  (if (>= n 0)
      (wasm/div n d)
      (- 0 (wasm/div (+ (- 0 n) (- d 1)) d))))

(defun wasm/floor-mod (n d)
  (- n (* d (wasm/floor-div n d))))

(defun wasm/uleb (n)
  (if (< n 128)
      (list n)
      (cons (+ 128 (wasm/mod n 128)) (wasm/uleb (wasm/div n 128)))))

(defun wasm/sleb (n)
  (let ((byte (wasm/floor-mod n 128))
        (next (wasm/floor-div n 128)))
    (cond
      ((and (= next 0) (< byte 64)) (list byte))
      ((and (= next -1) (>= byte 64)) (list byte))
      (else (cons (+ byte 128) (wasm/sleb next))))))

(defun wasm/vec (bytes)
  (append (wasm/uleb (wasm/count bytes)) bytes))

(defun wasm/name (text)
  (wasm/vec (string->bytes text)))

(defun wasm/int (value)
  (append (list 66) (wasm/sleb value)))

(defun wasm/count (value)
  (if (nil? value) 0 (length value)))

(defun wasm/atom-int (value)
  (wasm/int (cond
              ((= value #t) 1)
              ((= value #f) 0)
              (else value))))

(defun wasm/local-get (index)
  (append (list 32) (wasm/uleb index)))

(defun wasm/local-set (index)
  (append (list 33) (wasm/uleb index)))

(defun wasm/section (id payload)
  (append (list id) (wasm/vec payload)))

(defun wasm/counted (count bytes)
  (append (wasm/uleb count) bytes))

(defun wasm/head (value)
  (str (first value)))

(defun wasm/defun? (form)
  (and (not (atom form)) (= (wasm/head form) "defun")))

(defun wasm/import? (form)
  (and (not (atom form)) (= (wasm/head form) "import")))

(defun wasm/defuns (forms)
  (cond
    ((nil? forms) nil)
    ((wasm/defun? (first forms))
      (cons (first forms) (wasm/defuns (rest forms))))
    (else (wasm/defuns (rest forms)))))

(defun wasm/imports (forms)
  (cond
    ((nil? forms) nil)
    ((wasm/import? (first forms))
      (cons (first forms) (wasm/imports (rest forms))))
    (else (wasm/imports (rest forms)))))

(defun wasm/import-name (form)
  (str (nth 1 form) "." (nth 2 form)))

(defun wasm/consts (forms)
  (cond
    ((nil? forms) nil)
    ((and (not (atom (first forms))) (= (wasm/head (first forms)) "defconst"))
      (cons (list (str (nth 1 (first forms))) (nth 2 (first forms)))
            (wasm/consts (rest forms))))
    (else (wasm/consts (rest forms)))))

(defun wasm/env (params index)
  (if (nil? params)
      nil
      (cons (list (str (first params)) index)
            (wasm/env (rest params) (+ index 1)))))

(defun wasm/lookup (name env)
  (cond
    ((nil? env) nil)
    ((= name (first (first env))) (nth 1 (first env)))
    (else (wasm/lookup name (rest env)))))

(defun wasm/const-value (name consts)
  (cond
    ((nil? consts) nil)
    ((= name (first (first consts))) (nth 1 (first consts)))
    (else (wasm/const-value name (rest consts)))))

(defun wasm/index-of (name names index)
  (cond
    ((nil? names) (begin (println (str "missing index " name)) nil))
    ((= name (str (first names))) index)
    (else (wasm/index-of name (rest names) (+ index 1)))))

(defun wasm/string-atom? (expr)
  (and (atom expr)
       (not (symbol? expr))
       (wasm/string-literal? expr)))

(defun wasm/count-lets (expr)
  (if (atom expr)
      (if (wasm/string-atom? expr) 1 0)
      (+ (if (= (wasm/head expr) "let") (length (nth 1 expr)) 0)
         (wasm/count-lets-list expr))))

(defun wasm/count-lets-list (items)
  (if (nil? items)
      0
      (+ (wasm/count-lets (first items))
         (wasm/count-lets-list (rest items)))))

(defun wasm/binop (head)
  (cond
    ((= head "+") (list 124))
    ((= head "-") (list 125))
    ((= head "*") (list 126))
    ((= head "/") (list 127))
    ((= head "%") (list 129))
    ((= head "bit-and") (list 131))
    ((= head "bit-or") (list 132))
    ((= head "bit-xor") (list 133))
    ((= head "bit-shl") (list 134))
    ((= head "bit-shr") (list 135))
    ((= head "=") (list 81 173))
    ((= head ">") (list 85 173))
    ((= head "<") (list 83 173))
    ((= head ">=") (list 89 173))
    ((= head "<=") (list 87 173))
    ((= head "and") (list 131))
    ((= head "or") (list 132))
    (else nil)))

(defun wasm/cond->if (clauses)
  (if (nil? clauses)
      (list "i64.const" 0)
      (let ((clause (first clauses)))
        (if (= (wasm/head clause) "else")
            (nth 1 clause)
            (list "if" (nth 0 clause) (nth 1 clause)
                  (wasm/cond->if (rest clauses)))))))

(defun wasm/list-form (items)
  (if (nil? items)
      'rt/nil
      (list 'rt/cons (first items) (wasm/list-form (rest items)))))

(defun wasm/record-form (items)
  (let ((pairs (wasm/record-pairs items)))
    (if (nil? pairs)
        'rt/nil
        (list 'rt/cons
          (list 'rt/cons (first (first pairs)) (nth 1 (first pairs)))
          (wasm/record-form-from (rest pairs))))))

(defun wasm/record-form-from (pairs)
  (if (nil? pairs)
      'rt/nil
      (list 'rt/cons
        (list 'rt/cons (first (first pairs)) (nth 1 (first pairs)))
        (wasm/record-form-from (rest pairs)))))

(defun wasm/void? (expr)
  (and (not (atom expr))
       (let ((head (wasm/head expr)))
         (or (= head "i64.store") (= head "global.set")))))

(defun wasm/emit-body (body env consts names locals out)
  (if (nil? body)
      (list out locals)
      (let ((emitted (wasm/emit (first body) env consts names locals)))
        (if (nil? (rest body))
            (list (append out (first emitted)) (nth 1 emitted))
            (wasm/emit-body (rest body) env consts names
                            (nth 1 emitted)
                            (if (wasm/void? (first body))
                                (append out (first emitted))
                                (append (append out (first emitted)) (list 26))))))))

(defun wasm/emit-args (args env consts names locals out)
  (if (nil? args)
      (list out locals)
      (let ((emitted (wasm/emit (first args) env consts names locals)))
        (wasm/emit-args (rest args) env consts names
                        (nth 1 emitted)
                        (append out (first emitted))))))

(defun wasm/emit-bindings (bindings env consts names locals out)
  (if (nil? bindings)
      (list out env locals)
      (let ((binding (first bindings)))
        (let ((emitted (wasm/emit (nth 1 binding) env consts names locals)))
          (let ((local (nth 1 emitted)))
            (wasm/emit-bindings
              (rest bindings)
              (cons (list (str (first binding)) local) env)
              consts names
              (+ local 1)
              (append (append out (first emitted)) (wasm/local-set local))))))))


(defun wasm/string-literal? (value)
  (= (first (string-chars (json-encode value))) "\""))

(defun wasm/emit-string-bytes (bytes slot index names)
  (if (nil? bytes)
      nil
      (append
        (wasm/cat
          (list (wasm/local-get slot)
                (wasm/int index)
                (wasm/int (first bytes))
                (list 16)
                (wasm/uleb (wasm/index-of "rt/string-set" names 0))
                (list 26)))
        (wasm/emit-string-bytes (rest bytes) slot (+ index 1) names))))

(defun wasm/emit-string (text names locals)
  (let ((slot locals)
        (bytes (string->bytes text)))
    (let ((prefix
            (wasm/cat
              (list
                (wasm/int (length bytes))
                (list 16)
                (wasm/uleb (wasm/index-of "rt/string-new" names 0))
                (wasm/local-set slot))))
          (sets (wasm/emit-string-bytes bytes slot 0 names))
          (suffix (wasm/local-get slot)))
      (list (append prefix (append sets suffix)) (+ slot 1)))))

(defun wasm/keyword? (expr)
  (keyword? expr))

(defun wasm/key-text (key)
  (cond
    ((wasm/keyword? key) (str key))
    ((wasm/string-literal? key) key)
    (else (str key))))

(defun wasm/record-pairs (items)
  (if (nil? items)
      nil
      (if (not (atom (first items)))
          (cons
            (list (wasm/key-text (first (first items))) (nth 1 (first items)))
            (wasm/record-pairs (rest items)))
          (cons
            (list (wasm/key-text (first items)) (nth 1 items))
            (wasm/record-pairs (drop 2 items))))))

(defun wasm/quote-form (form)
  (cond
    ((nil? form) 'rt/nil)
    ((symbol? form) (wasm/key-text form))
    ((atom form) form)
    (else (wasm/list-form (map 'wasm/quote-form form)))))

(defun wasm/emit (expr env consts names locals)
  (cond
    ((wasm/keyword? expr)
      (wasm/emit-string (wasm/key-text expr) names locals))
    ((symbol? expr)
      (let ((local (wasm/lookup (str expr) env)))
        (if (nil? local)
            (list (wasm/int (wasm/const-value (str expr) consts)) locals)
            (list (wasm/local-get local) locals))))
    ((wasm/string-literal? expr)
      (wasm/emit-string expr names locals))
    ((atom expr)
      (list (wasm/atom-int expr) locals))
    (else
      (let ((head (wasm/head expr)))
        (cond
          ((= head "let")
            (let ((bindings (wasm/emit-bindings (nth 1 expr) env consts names locals nil)))
              (let ((body (wasm/emit (nth 2 expr) (nth 1 bindings) consts names (nth 2 bindings))))
                (list (append (first bindings) (first body)) (nth 1 body)))))
          ((= head "cond")
            (wasm/emit (wasm/cond->if (rest expr)) env consts names locals))
          ((= head "if")
            (let ((condition (wasm/emit (nth 1 expr) env consts names locals)))
              (let ((then (wasm/emit (nth 2 expr) env consts names (nth 1 condition))))
                (let ((otherwise (wasm/emit (nth 3 expr) env consts names (nth 1 then))))
                  (list
                    (wasm/cat
                      (list (first condition)
                            (list 167 4 126)
                            (first then)
                            (list 5)
                            (first otherwise)
                            (list 11)))
                    (nth 1 otherwise))))))
          ((= head "not")
            (let ((value (wasm/emit (nth 1 expr) env consts names locals)))
              (list (append (first value) (list 80 173)) (nth 1 value))))
          ((= head "begin")
            (wasm/emit-body (rest expr) env consts names locals nil))
          ((= head "quote")
            (wasm/emit (wasm/quote-form (nth 1 expr)) env consts names locals))
          ((= head "list")
            (wasm/emit (wasm/list-form (rest expr)) env consts names locals))
          ((= head "record")
            (wasm/emit (wasm/record-form (rest expr)) env consts names locals))
          ((= head "field")
            (wasm/emit
              (list 'rt/field (nth 1 expr) (wasm/key-text (nth 2 expr)))
              env consts names locals))
          ((= head "i64.load")
            (let ((address (wasm/emit (nth 1 expr) env consts names locals)))
              (list (wasm/cat (list (first address) (wasm/i64-load) (list 3 0)))
                    (nth 1 address))))
          ((= head "i64.store")
            (let ((address (wasm/emit (nth 1 expr) env consts names locals)))
              (let ((value (wasm/emit (nth 2 expr) env consts names (nth 1 address))))
                (list (wasm/cat (list (first address) (first value)
                                      (wasm/i64-store) (list 3 0)))
                      (nth 1 value)))))
          ((= head "global.get")
            (list (append (wasm/global-get) (wasm/uleb (nth 1 expr))) locals))
          ((= head "global.set")
            (let ((value (wasm/emit (nth 2 expr) env consts names locals)))
              (list (wasm/cat (list (first value) (wasm/global-set) (wasm/uleb (nth 1 expr))))
                    (nth 1 value))))
          ((= head "i32.wrap_i64")
            (let ((value (wasm/emit (nth 1 expr) env consts names locals)))
              (list (append (first value) (wasm/i32-wrap)) (nth 1 value))))
          ((= head "i64.extend_i32_u")
            (let ((value (wasm/emit (nth 1 expr) env consts names locals)))
              (list (append (first value) (wasm/i64-extend)) (nth 1 value))))
          ((= head "nth")
            (let ((index (nth 1 expr))
                  (items (nth 2 expr)))
              (if (and (atom index) (not (symbol? index))
                       (not (atom items)) (= (wasm/head items) "list"))
                  (wasm/emit (nth index (rest items)) env consts names locals)
                  (let ((op (wasm/binop head)))
                    (if (nil? op)
                        (let ((args (wasm/emit-args (rest expr) env consts names locals nil)))
                          (list (wasm/cat
                                  (list (first args)
                                        (list 16)
                                        (wasm/uleb (wasm/index-of head names 0))))
                                (nth 1 args)))
                        (let ((left (wasm/emit (nth 1 expr) env consts names locals)))
                          (let ((right (wasm/emit (nth 2 expr) env consts names (nth 1 left))))
                            (list (wasm/cat (list (first left) (first right) op)) (nth 1 right)))))))))
          (else
            (let ((op (wasm/binop head)))
              (if (nil? op)
                  (let ((args (wasm/emit-args (rest expr) env consts names locals nil)))
                    (list (wasm/cat
                            (list (first args)
                                  (list 16)
                                  (wasm/uleb (wasm/index-of head names 0))))
                          (nth 1 args)))
                  (let ((left (wasm/emit (nth 1 expr) env consts names locals)))
                    (let ((right (wasm/emit (nth 2 expr) env consts names (nth 1 left))))
                      (list (wasm/cat (list (first left) (first right) op)) (nth 1 right))))))))))))

(defun wasm/type-entry (form)
  (wasm/cat
    (list (list 96)
          (wasm/vec (wasm/repeat (wasm/count (nth 2 form)) 126))
          (wasm/vec (list 126)))))

(defun wasm/import-type-entry (form)
  (wasm/cat
    (list (list 96)
          (wasm/vec (wasm/repeat (wasm/count (nth 3 form)) 126))
          (wasm/vec (list 126)))))

(defun wasm/types-all (imports defuns)
  (if (nil? imports)
      (if (nil? defuns)
          nil
          (append (wasm/type-entry (first defuns)) (wasm/types-all nil (rest defuns))))
      (append (wasm/import-type-entry (first imports))
              (wasm/types-all (rest imports) defuns))))

(defun wasm/indices-from (start n)
  (if (<= n 0)
      nil
      (cons (wasm/uleb start) (wasm/indices-from (+ start 1) (- n 1)))))

(defun wasm/function-indices (start n)
  (wasm/cat (wasm/indices-from start n)))

(defun wasm/import-entry (form type-index)
  (wasm/cat
    (list (wasm/name (str (nth 1 form)))
          (wasm/name (str (nth 2 form)))
          (list 0)
          (wasm/uleb type-index))))

(defun wasm/import-entries (imports index)
  (if (nil? imports)
      nil
      (append (wasm/import-entry (first imports) index)
              (wasm/import-entries (rest imports) (+ index 1)))))

(defun wasm/import-section (imports)
  (if (nil? imports)
      nil
      (wasm/section 2 (wasm/counted (length imports) (wasm/import-entries imports 0)))))

(defun wasm/export-entry (form index)
  (wasm/cat (list (wasm/name (str (nth 1 form))) (list 0) (wasm/uleb index))))

(defun wasm/exports (defuns index start)
  (if (nil? defuns)
      nil
      (append (wasm/export-entry (first defuns) (+ start index))
              (wasm/exports (rest defuns) (+ index 1) start))))

(defun wasm/body (form names consts)
  (let ((params (nth 2 form)))
    (let ((env (wasm/env params 0)))
      (let ((count (wasm/count-lets-list (drop 3 form))))
        (let ((emitted (wasm/emit-body (drop 3 form) env consts names (wasm/count params) nil)))
          (let ((locals (if (= count 0)
                            (list 0)
                            (wasm/cat (list (list 1) (wasm/uleb count) (list 126))))))
            (let ((body (wasm/cat (list locals (first emitted) (list 11)))))
              (append (wasm/uleb (length body)) body))))))))

(defun wasm/bodies (defuns names consts)
  (if (nil? defuns)
      nil
      (append (wasm/body (first defuns) names consts)
              (wasm/bodies (rest defuns) names consts))))

(defun wasm/memory-decl (forms)
  (cond
    ((nil? forms) nil)
    ((and (not (atom (first forms))) (= (wasm/head (first forms)) "memory"))
      (nth 1 (first forms)))
    (else (wasm/memory-decl (rest forms)))))

(defun wasm/global-decl (forms)
  (cond
    ((nil? forms) nil)
    ((and (not (atom (first forms))) (= (wasm/head (first forms)) "global"))
      (nth 1 (first forms)))
    (else (wasm/global-decl (rest forms)))))

(defun wasm/memory-section (forms)
  (let ((pages (wasm/memory-decl forms)))
    (if (nil? pages)
        nil
        (wasm/section 5 (list 1 0 pages)))))

(defun wasm/global-section (forms)
  (let ((value (wasm/global-decl forms)))
    (if (nil? value)
        nil
        (wasm/section 6 (wasm/cat (list (list 1 126 1 66) (wasm/sleb value) (list 11)))))))

(defun wasm/compile-source (source)
  (let ((forms (wasm/expand-forms (read source))))
    (let ((imports (wasm/imports forms)))
      (let ((defuns (wasm/defuns forms)))
        (let ((names (append (map (lambda (form) (wasm/import-name form)) imports)
                             (map (lambda (form) (str (nth 1 form))) defuns))))
          (let ((consts (wasm/consts forms)))
            (let ((types (wasm/counted (+ (wasm/count imports) (wasm/count defuns))
                                       (wasm/types-all imports defuns))))
              (let ((indices (wasm/counted (length defuns)
                                           (wasm/function-indices (wasm/count imports) (wasm/count defuns)))))
                (let ((exports (wasm/counted (length defuns)
                                             (wasm/exports defuns 0 (wasm/count imports)))))
                  (let ((bodies (wasm/counted (length defuns)
                                              (wasm/bodies defuns names consts))))
                    (wasm/cat
                      (list (list 0 97 115 109 1 0 0 0)
                        (wasm/section 1 types)
                        (wasm/import-section imports)
                        (wasm/section 3 indices)
                        (wasm/memory-section forms)
                        (wasm/global-section forms)
                        (wasm/section 7 exports)
                        (wasm/section 10 bodies)))))))))))))
